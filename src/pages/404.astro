---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The requested page could not be found." path="/404" locale="en" robots="noindex,follow" alternates={false}>
  <section class="mx-auto flex min-h-[70vh] max-w-[1440px] flex-col justify-center px-5 pt-32 md:px-10">
    <h1 class="font-head text-[56px] font-bold leading-[0.95] tracking-[-0.03em] md:text-[120px]">Page not found</h1>
    <p class="mt-6 max-w-xl text-lg text-mute md:text-xl">The page you are looking for does not exist or has moved.</p>
    <a href="/" class="mt-8 inline-flex w-fit rounded-full bg-ink px-6 py-3.5 font-medium text-white hover:bg-blue">← Back to homepage</a>
  </section>
</BaseLayout>
