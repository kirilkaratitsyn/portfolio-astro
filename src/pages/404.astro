---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../sections/Contact.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be found."
  path="/404"
  locale="en"
  robots="noindex,follow"
  alternates={false}
>
  <section class="bg-[#0E0E0E]">
    <div class="blog__container min-h-[60vh] pt-20" data-aos="fade-up">
      <div class="space-y-6">
        <h1 class="text-3xl font-bold uppercase primary-gradient primary-shadow md:text-[37px]">Page not found</h1>
        <p class="text-lg text-white/70">The page you are looking for does not exist or has moved.</p>
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-white hover:text-white/70"
        >
          <span aria-hidden="true">←</span>
          Back to homepage
        </a>
      </div>
    </div>
  </section>
  <Contact locale="en" />
</BaseLayout>
