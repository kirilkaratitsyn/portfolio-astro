---
import icons from './icons.json';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  stroke="currentColor"
  fill="currentColor"
  stroke-width="0"
  viewBox={icons.github.viewBox}
  class={className}
  height="1em"
  width="1em"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path d={icons.github.d}></path>
</svg>
