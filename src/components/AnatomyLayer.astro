---
// One card of How I work (sections/Anatomy.astro): the window of the tool a project step happens in, from the
// kick-off call to analytics, drawn in full: Google Meet, Figma, the Shopify themes page with the section's code, the
// QA devices, a Google result, GA4. The store in them is the made-up demo store of the Editor section (MiniStore),
// on yourstore.com; every number is a placeholder, not a client's data. Decorative only; the words that matter are in
// the step next to it. Sizes are in cqi (the card is a size container), so the drawing scales with the card. Logos:
// Simple Icons (CC0).
import MiniStore from './MiniStore.astro';
import shopify from '../assets/stack/shopify.svg?raw';
import figma from '../assets/stack/figma.svg?raw';
import meet from '../assets/stack/googlemeet.svg?raw';
import google from '../assets/stack/google.svg?raw';
import analytics from '../assets/stack/googleanalytics.svg?raw';
import { useTranslations, type Locale } from '../i18n';

type Cards = ReturnType<typeof useTranslations>['anatomy']['cards'];

interface Props {
  kind: 'call' | 'brief' | 'build' | 'qa' | 'seo' | 'analytics';
  locale: Locale;
  /** The words inside the drawings, in the page's language (i18n anatomy.cards). */
  text: Cards;
}

const { kind, locale, text } = Astro.props;
const store = useTranslations(locale).editor.store;
const money = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
const prices = [49, 29, 39, 25].map((n) => money.format(n));
const num = (n: number) => new Intl.NumberFormat(locale).format(n);

const svg = (raw: string) => raw.replace(/<title>.*?<\/title>/, '').replace('<svg ', '<svg aria-hidden="true" fill="currentColor" width="100%" height="100%" ');
const icon = (d: string, fill = false) =>
  `<svg aria-hidden="true" viewBox="0 0 24 24" width="100%" height="100%" fill="${fill ? 'currentColor' : 'none'}" stroke="${fill ? 'none' : 'currentColor'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const check = icon('<path d="m5 12.5 4.5 4.5L19 7.5"/>');
const meetIcons = {
  mic: icon('<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>'),
  cam: icon('<rect x="3" y="6.5" width="12.5" height="11" rx="2"/><path d="m15.5 10.5 5.5-3v9l-5.5-3"/>'),
  cc: icon('<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M10.5 10a2.2 2.2 0 1 0 0 4M17 10a2.2 2.2 0 1 0 0 4"/>'),
  share: icon('<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 14V8m-3 3 3-3 3 3M8 21h8"/>'),
  hand: icon('<path d="M8 13V6a1.5 1.5 0 0 1 3 0v5m0-6.5a1.5 1.5 0 0 1 3 0V11m0-4a1.5 1.5 0 0 1 3 0v8a6 6 0 0 1-6 6h-.5a6 6 0 0 1-5-2.6L3.2 15a1.5 1.5 0 0 1 2.4-1.8L8 16"/>'),
  more: icon('<circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/>', true),
  end: icon('<path d="M2.5 14.5c5.2-5 13.8-5 19 0l-2.6 2.6-3.8-1.6v-3a12 12 0 0 0-6.2 0v3l-3.8 1.6Z"/>', true),
};

// Type in units of the card's width.
const s = { xxs: 'text-[1.25cqi]', xs: 'text-[1.45cqi]', sm: 'text-[1.7cqi]', md: 'text-[2cqi]', lg: 'text-[2.4cqi]', xl: 'text-[3.2cqi]' };
const tick = 'grid size-[2.3cqi] shrink-0 place-items-center rounded-full bg-[#e3e6ff] p-[0.45cqi] text-blue';
const okTick = 'grid size-[2.3cqi] shrink-0 place-items-center rounded-full bg-[#2f9e44] p-[0.45cqi] text-white';
const panel = 'rounded-[1.4cqi] border border-[#e6e8f1] bg-white';
const { call, brief, build, qa, seo, analytics: ga } = text;
const app = {
  call: { logo: meet, color: 'text-[#00897b]', name: call.app, side: '24:16' },
  brief: { logo: figma, color: 'text-ink', name: brief.app, side: brief.side },
  build: { logo: shopify, color: 'text-[#5e8e3e]', name: build.app, side: build.side },
  qa: { logo: '', color: '', name: qa.app, side: qa.side },
  seo: { logo: google, color: 'text-ink', name: seo.app, side: seo.side },
  analytics: { logo: analytics, color: 'text-[#e37400]', name: ga.app, side: ga.side },
}[kind];

// Liquid of the section on the draft theme, coloured like an editor: [colour, text] pieces per line.
const C = { tag: '#ff7ab2', liquid: '#ffa657', key: '#79c0ff', str: '#a5d6a7', text: '#d6d9e6', dim: '#7d8199' };
const code: [string, string][][] = [
  [[C.tag, '<section'], [C.key, ' class'], [C.text, '='], [C.str, '"hero"'], [C.tag, '>']],
  [[C.tag, '  <h2>'], [C.liquid, '{{ section.settings.heading }}'], [C.tag, '</h2>']],
  [[C.tag, '  <a'], [C.key, ' href'], [C.text, '='], [C.str, '"{{ section.settings.link }}"'], [C.tag, '>']],
  [[C.liquid, '    {{ section.settings.button }}']],
  [[C.tag, '  </a>']],
  [[C.tag, '</section>']],
  [],
  [[C.liquid, '{% schema %}']],
  [[C.text, '{']],
  [[C.key, '  "name"'], [C.text, ': '], [C.str, '"Hero banner"'], [C.text, ',']],
  [[C.key, '  "settings"'], [C.text, ': [']],
  [[C.text, '    { '], [C.key, '"type"'], [C.text, ': '], [C.str, '"text"'], [C.text, ', '], [C.key, '"id"'], [C.text, ': '], [C.str, '"heading"'], [C.text, ' },']],
  [[C.text, '    { '], [C.key, '"type"'], [C.text, ': '], [C.str, '"color_scheme"'], [C.text, ', '], [C.key, '"id"'], [C.text, ': '], [C.str, '"scheme"'], [C.text, ' },']],
  [[C.text, '    { '], [C.key, '"type"'], [C.text, ': '], [C.str, '"range"'], [C.text, ', '], [C.key, '"id"'], [C.text, ': '], [C.str, '"columns"'], [C.text, ' }']],
  [[C.text, '  ]']],
  [[C.text, '}']],
  [[C.liquid, '{% endschema %}']],
];
---

<div class="anat-card min-w-0" aria-hidden="true">
  <!-- The tool's own title bar; it starts a little in, clear of the step number on the card's corner. -->
  <div class={`flex items-center gap-[1.2cqi] border-b border-[#eceef5] py-[1.4cqi] pl-[5cqi] pr-[2cqi] ${s.sm} font-semibold`}>
    {app.logo ? <span class={`size-[2.4cqi] shrink-0 ${app.color}`} set:html={svg(app.logo)} /> : <span class={`${tick} !bg-blue !text-white`} set:html={check} />}
    <span class="min-w-0 flex-1 truncate">{app.name}</span>
    <span class={`flex items-center gap-[0.8cqi] rounded-full bg-[#f1f2f7] px-[1.2cqi] py-[0.4cqi] ${s.xs} font-semibold text-mute`}>
      {kind === 'call' && <i class="block size-[1cqi] rounded-full bg-[#e5484d]" />}
      {kind === 'analytics' && <i class="block size-[1cqi] rounded-full bg-[#2f9e44]" />}
      {app.side}
    </span>
  </div>

  {
    kind === 'call' && (
      <div class="grid min-h-0 flex-1 grid-cols-[1fr_26cqi] gap-[1.4cqi] bg-[#202124] p-[1.6cqi] text-white">
        <div class="grid min-h-0 grid-rows-[1fr_auto] gap-[1.4cqi]">
          <!-- The shared screen: the client's store in a browser. -->
          <div class="relative min-h-0 overflow-hidden rounded-[1.2cqi] bg-[#3c4043]">
            <div class="absolute inset-x-[2cqi] bottom-[7.5cqi] top-[2cqi] flex flex-col overflow-hidden rounded-[0.8cqi] bg-white text-ink">
              <span class="flex items-center gap-[0.5cqi] bg-[#eceff3] px-[1cqi] py-[0.6cqi]">
                <i class="size-[0.8cqi] rounded-full bg-[#ff5f57]" />
                <i class="size-[0.8cqi] rounded-full bg-[#febc2e]" />
                <i class="size-[0.8cqi] rounded-full bg-[#28c840]" />
                <span class={`ml-[1cqi] rounded-full bg-white px-[1.2cqi] py-[0.2cqi] ${s.xxs} text-mute`}>yourstore.com</span>
              </span>
              <MiniStore store={store} prices={prices} class="min-h-0 flex-1" />
            </div>
            <span class={`absolute bottom-[1.6cqi] left-1/2 max-w-[86%] -translate-x-1/2 truncate rounded-[0.6cqi] bg-black/75 px-[1.4cqi] py-[0.7cqi] ${s.sm}`}>{call.quote}</span>
          </div>
          <!-- Controls. -->
          <div class="flex items-center gap-[1cqi]">
            <span class={`min-w-0 flex-1 truncate ${s.xs} font-medium text-white/80`}>{call.time}</span>
            {[meetIcons.mic, meetIcons.cam, meetIcons.cc, meetIcons.share, meetIcons.hand, meetIcons.more].map((ic, i) => (
              <span class={`grid size-[4cqi] place-items-center rounded-full p-[1cqi] ${i === 3 ? 'bg-[#a8c7fa] text-[#062e6f]' : 'bg-[#3c4043]'}`} set:html={ic} />
            ))}
            <span class="grid h-[4cqi] w-[6.4cqi] place-items-center rounded-full bg-[#ea4335] px-[1.6cqi] py-[0.9cqi]" set:html={meetIcons.end} />
            <span class="flex-1" />
          </div>
        </div>
        <div class="flex min-h-0 flex-col gap-[1.2cqi]">
          <!-- People: Kiril speaking, the client. -->
          <div class="relative aspect-[16/10] shrink-0 overflow-hidden rounded-[1.2cqi] ring-[0.35cqi] ring-[#a8c7fa]">
            <img src="/source/profile/kiril-640.webp" alt="" width="640" height="640" loading="lazy" decoding="async" class="size-full object-cover object-[50%_25%]" />
            <span class={`absolute bottom-[0.8cqi] left-[1cqi] ${s.xs} font-semibold drop-shadow`}>Kiril</span>
            <span class="absolute right-[0.9cqi] top-[0.9cqi] flex h-[2.6cqi] items-center gap-[0.3cqi] rounded-full bg-[#1a73e8] px-[0.8cqi]">
              {[1.2, 2, 1.4].map((h) => <i class="w-[0.35cqi] rounded-full bg-white" style={`height:${h}cqi`} />)}
            </span>
          </div>
          <div class="relative grid aspect-[16/10] shrink-0 place-items-center rounded-[1.2cqi] bg-[#3c4043]">
            <span class={`grid size-[7cqi] place-items-center rounded-full bg-[#e8710a] font-head ${s.lg} font-bold`}>{call.you.slice(0, 1)}</span>
            <span class={`absolute bottom-[0.8cqi] left-[1cqi] ${s.xs} font-semibold`}>{call.you}</span>
          </div>
          <!-- What the call settles. -->
          <div class="flex min-h-0 flex-1 flex-col gap-[0.7cqi] overflow-hidden rounded-[1.2cqi] bg-white p-[1.4cqi] text-ink">
            <span class={`${s.sm} font-bold`}>{call.agenda}</span>
            {call.items.map((item) => (
              <span class={`flex items-center gap-[0.8cqi] ${s.xs} font-medium`}>
                <span class={`${tick} !size-[2cqi]`} set:html={check} />
                <span class="truncate">{item}</span>
              </span>
            ))}
            <span class={`flex items-center gap-[0.8cqi] ${s.xs} font-semibold text-blue`}>
              <span class="size-[2cqi] shrink-0 rounded-full border-[0.3cqi] border-blue border-r-transparent" />
              <span class="truncate">{call.now}</span>
            </span>
          </div>
        </div>
      </div>
    )
  }

  {
    kind === 'brief' && (
      <div class="grid min-h-0 flex-1 grid-cols-[16cqi_1fr]">
        <!-- Figma's left panel: pages and frames. -->
        <div class={`flex min-w-0 flex-col gap-[0.4cqi] border-r border-[#eceef5] p-[1.2cqi] ${s.xs}`}>
          {brief.pages.map((page, i) => (
            <span class={`truncate rounded-[0.6cqi] px-[0.9cqi] py-[0.55cqi] ${i === 1 ? 'bg-[#f1ecff] font-semibold text-[#7b3ff2]' : 'text-mute'}`}>{page}</span>
          ))}
          <span class="my-[0.8cqi] h-px bg-[#eceef5]" />
          {[brief.desktop, brief.mobile].map((frame) => (
            <span class="flex items-center gap-[0.7cqi] truncate px-[0.9cqi] py-[0.4cqi] font-medium">
              <span class="text-mute">#</span>
              <span class="truncate">{frame}</span>
            </span>
          ))}
          <span class="mt-auto flex items-center gap-[0.6cqi] px-[0.4cqi]">
            <span class={`grid size-[2.8cqi] place-items-center rounded-full bg-blue ${s.xxs} font-bold text-white`}>KK</span>
            <span class={`-ml-[1.2cqi] grid size-[2.8cqi] place-items-center rounded-full bg-[#e8710a] ring-2 ring-white ${s.xxs} font-bold text-white`}>{call.you.slice(0, 1)}</span>
            <span class={`ml-auto rounded-[0.6cqi] bg-[#0d99ff] px-[1cqi] py-[0.4cqi] ${s.xxs} font-semibold text-white`}>{brief.share}</span>
          </span>
        </div>
        <!-- Canvas: the brief, then the home page it turned into. -->
        <div class="relative min-w-0 overflow-hidden bg-[#ededf0]">
          <div class="absolute bottom-[5%] left-[3%] top-[5%] flex w-[31%] flex-col gap-[1cqi] rounded-[1cqi] bg-white p-[1.6cqi] shadow-[0_0.6cqi_1.6cqi_rgba(14,16,40,0.08)]">
            <span class={`${s.md} font-bold`}>{brief.title}</span>
            {brief.parts.map((part, i) => (
              <span class="flex flex-col gap-[0.3cqi]">
                <span class={`flex items-center gap-[0.7cqi] ${s.xs} font-bold`}>
                  <span class={`${tick} !size-[1.9cqi]`} set:html={check} />
                  {part}
                </span>
                <span class={`pl-[2.6cqi] ${s.xxs} leading-snug text-mute`}>{brief.lines[i]}</span>
              </span>
            ))}
            <span class={`mt-auto w-fit rounded-full bg-[#e3e6ff] px-[1.1cqi] py-[0.5cqi] ${s.xxs} font-semibold text-blue`}>{brief.agreed}</span>
          </div>
          <span class={`absolute left-[37%] top-[3.5%] ${s.xxs} text-mute`}>{brief.desktop}</span>
          <div class="absolute left-[37%] top-[9%] h-[72%] w-[44%] overflow-hidden bg-white shadow-[0_0.6cqi_1.6cqi_rgba(14,16,40,0.1)]">
            <MiniStore store={store} prices={prices} class="h-full" />
          </div>
          <!-- Selected: the hero, with a comment from the client on it. -->
          <span class="absolute left-[37%] top-[18.5%] h-[27%] w-[44%] outline outline-[0.25cqi] outline-[#a259ff]">
            {['-left-[0.5cqi] -top-[0.5cqi]', '-right-[0.5cqi] -top-[0.5cqi]', '-bottom-[0.5cqi] -left-[0.5cqi]', '-bottom-[0.5cqi] -right-[0.5cqi]'].map((at) => (
              <i class={`absolute size-[1cqi] border-[0.2cqi] border-[#a259ff] bg-white ${at}`} />
            ))}
          </span>
          <span class={`absolute left-[54%] top-[44%] flex items-center gap-[0.7cqi] rounded-full rounded-tl-none bg-white py-[0.5cqi] pl-[0.5cqi] pr-[1.2cqi] ${s.xs} font-semibold shadow-[0_0.6cqi_1.6cqi_rgba(14,16,40,0.18)]`}>
            <span class={`grid size-[2.4cqi] place-items-center rounded-full bg-[#e8710a] ${s.xxs} font-bold text-white`}>{call.you.slice(0, 1)}</span>
            {brief.comment}
          </span>
          <span class={`absolute left-[84%] top-[3.5%] ${s.xxs} text-mute`}>{brief.mobile}</span>
          <div class="absolute left-[84%] top-[9%] h-[64%] w-[13%] overflow-hidden rounded-[0.8cqi] bg-white shadow-[0_0.6cqi_1.6cqi_rgba(14,16,40,0.1)]">
            <MiniStore store={store} prices={prices} mobile class="h-full" />
          </div>
          <!-- The client's cursor. -->
          <span class="absolute left-[70%] top-[78%] flex items-start">
            <span class="size-[2.4cqi] text-[#e8710a]" set:html={icon('<path d="M4 3l7 17 2.5-7L20 10.5Z"/>', true)} />
            <span class={`-ml-[0.4cqi] mt-[1.8cqi] rounded-[0.5cqi] bg-[#e8710a] px-[0.8cqi] py-[0.2cqi] ${s.xxs} font-semibold text-white`}>{call.you}</span>
          </span>
        </div>
      </div>
    )
  }

  {
    kind === 'build' && (
      <div class="grid min-h-0 flex-1 grid-cols-[1fr_1.08fr] gap-[1.6cqi] p-[1.8cqi]">
        <!-- Online Store › Themes: the live theme keeps selling, the new one is built beside it. -->
        <div class="flex min-w-0 flex-col gap-[1.4cqi]">
          <div class={`${panel} flex items-center gap-[1.4cqi] p-[1.2cqi]`}>
            <div class="aspect-[16/11] w-[40%] shrink-0 overflow-hidden rounded-[0.6cqi] border border-[#e6e8f1] opacity-80 grayscale-[0.4]">
              <MiniStore store={store} prices={prices} class="h-full" />
            </div>
            <span class="flex min-w-0 flex-col gap-[0.6cqi]">
              <span class={`flex items-center gap-[0.8cqi] ${s.sm} font-bold`}>
                <span class="truncate">{build.liveName}</span>
                <span class={`rounded-full bg-[#cdfee1] px-[0.9cqi] py-[0.15cqi] ${s.xxs} font-semibold text-[#0c5132]`}>{build.live}</span>
              </span>
              <span class={`flex items-center gap-[0.7cqi] ${s.xs} text-mute`}>
                <i class="size-[1cqi] shrink-0 rounded-full bg-[#2f9e44] shadow-[0_0_0_0.5cqi_rgba(47,158,68,0.2)]" />
                <span class="truncate">{build.liveNote}</span>
              </span>
            </span>
          </div>
          <div class={`${panel} flex min-h-0 flex-1 flex-col gap-[1cqi] p-[1.2cqi] outline outline-[0.25cqi] outline-blue`}>
            <span class="flex items-center gap-[1.4cqi]">
              <span class="aspect-[16/11] w-[40%] shrink-0 overflow-hidden rounded-[0.6cqi] border border-[#e6e8f1]">
                <MiniStore store={store} prices={prices} class="h-full" />
              </span>
              <span class="flex min-w-0 flex-col gap-[0.6cqi]">
                <span class={`flex items-center gap-[0.8cqi] ${s.sm} font-bold`}>
                  <span class="truncate">{build.draftName}</span>
                  <span class={`rounded-full bg-[#eef0f6] px-[0.9cqi] py-[0.15cqi] ${s.xxs} font-semibold text-mute`}>{build.side}</span>
                </span>
                <span class={`${s.xs} text-mute`}>{build.draftNote}</span>
              </span>
            </span>
            <span class="flex flex-col gap-[0.6cqi]">
              {build.names.map((name, i) => (
                <span class={`flex items-center gap-[0.8cqi] ${s.xs} font-medium`}>
                  {i < 3 ? <span class={`${tick} !size-[2cqi]`} set:html={check} /> : <span class="size-[2cqi] shrink-0 rounded-full border-[0.3cqi] border-blue border-r-transparent" />}
                  <span class={`truncate ${i < 3 ? '' : 'text-blue'}`}>{name}</span>
                </span>
              ))}
            </span>
            <span class={`mt-auto flex items-center justify-between ${s.xxs} font-semibold text-mute`}>
              <span>3 / 4 {build.built}</span>
              <span>75%</span>
            </span>
            <span class="block h-[0.8cqi] overflow-hidden rounded-full bg-[#eef0f6]">
              <i class="block h-full w-3/4 rounded-full bg-blue" />
            </span>
            <span class={`flex items-center gap-[0.8cqi] ${s.xs} font-semibold`}>
              <span class="rounded-[0.8cqi] border border-[#d3d7e6] px-[1.2cqi] py-[0.5cqi]">{build.preview}</span>
              <span class="rounded-[0.8cqi] bg-[#eef0f6] px-[1.2cqi] py-[0.5cqi] text-[#a0a4b8]">{build.publish}</span>
            </span>
          </div>
        </div>
        <!-- The section's code: the settings in its schema are what the team edits later. -->
        <div class="flex min-w-0 flex-col overflow-hidden rounded-[1.4cqi] bg-[#1d1f2b]">
          <span class={`flex items-center gap-[1cqi] border-b border-white/10 px-[1.4cqi] py-[0.9cqi] ${s.xs} text-[#9da3bd]`}>
            <span class="rounded-[0.5cqi] bg-white/10 px-[1cqi] py-[0.2cqi] text-white">hero-banner.liquid</span>
            <span>theme.liquid</span>
          </span>
          <span class={`flex min-h-0 flex-1 flex-col whitespace-pre px-[1.4cqi] py-[1.2cqi] font-mono ${s.xxs} leading-[1.75]`}>
            {code.map((parts, i) => (
              <span class="flex">
                <span class="w-[2.6cqi] shrink-0 select-none text-right" style={`color:${C.dim}`}>{i + 1}</span>
                <span class="ml-[1.4cqi] overflow-hidden whitespace-pre">
                  {parts.map(([color, chunk]) => (
                    <span style={`color:${color}`}>{chunk}</span>
                  ))}
                </span>
              </span>
            ))}
          </span>
        </div>
      </div>
    )
  }

  {
    kind === 'qa' && (
      <div class="grid min-h-0 flex-1 grid-cols-[1.3fr_1fr] gap-[1.6cqi] p-[1.8cqi]">
        <div class="flex min-w-0 flex-col gap-[1.2cqi]">
          <!-- The store on a laptop and a phone, both passed. -->
          <div class="relative min-h-0 flex-1 overflow-hidden rounded-[1.4cqi] bg-[#f1f2f7]">
            <div class="absolute left-[5%] top-[7%] flex h-[78%] w-[72%] flex-col overflow-hidden rounded-[0.8cqi] bg-white shadow-[0_0.8cqi_2cqi_rgba(14,16,40,0.12)]">
              <span class="flex items-center gap-[0.5cqi] bg-[#eceff3] px-[1cqi] py-[0.6cqi]">
                <i class="size-[0.8cqi] rounded-full bg-[#ff5f57]" />
                <i class="size-[0.8cqi] rounded-full bg-[#febc2e]" />
                <i class="size-[0.8cqi] rounded-full bg-[#28c840]" />
                <span class={`ml-[1cqi] rounded-full bg-white px-[1.2cqi] py-[0.2cqi] ${s.xxs} text-mute`}>Safari · macOS</span>
              </span>
              <MiniStore store={store} prices={prices} class="min-h-0 flex-1" />
            </div>
