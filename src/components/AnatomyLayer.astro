---
// One layer of the store anatomy (sections/Anatomy.astro): a small, drawn piece of a Shopify store. Decorative only;
// the words that matter are in the list next to it.
interface Props {
  kind: 'header' | 'hero' | 'product' | 'cart' | 'markets';
}

const { kind } = Astro.props;
const bar = 'block h-[7px] rounded-full bg-[#dfe2ee]';
---

<div class="anat-card min-w-0" aria-hidden="true">
  {
    kind === 'header' && (
      <div class="flex h-full flex-col">
        <div class="flex min-w-0 items-center justify-between gap-3">
          <span class="shrink-0 font-head text-[13px] font-bold tracking-[0.28em]">BRAND</span>
          <span class="flex min-w-0 flex-1 justify-center gap-[6%]">
            <i class={`${bar} w-[16%] !bg-ink`} />
            <i class={`${bar} w-[20%]`} />
            <i class={`${bar} w-[14%]`} />
            <i class={`${bar} w-[18%]`} />
          </span>
          <span class="flex shrink-0 items-center gap-2">
            <span class="whitespace-nowrap rounded-full border border-[#dfe2ee] px-2 py-0.5 text-[10px] font-semibold">EN · €</span>
            <i class="block size-3.5 rounded-full border-2 border-ink" />
            <i class="block size-3.5 rounded-[4px] border-2 border-ink" />
          </span>
        </div>
        <div class="mt-3 grid flex-1 grid-cols-[1fr_1fr_1fr_1.3fr] gap-3 rounded-xl bg-[#f3f4f9] p-3">
          {[0, 1, 2].map((c) => (
            <div class="flex flex-col gap-2">
              <i class={`${bar} w-3/4 !bg-ink`} />
              <i class={`${bar} w-full`} />
              <i class={`${bar} w-5/6`} />
              <i class={`${bar} w-2/3`} />
              {c === 1 && <i class={`${bar} w-1/2 !bg-blue`} />}
            </div>
          ))}
          <div class="rounded-lg bg-[linear-gradient(135deg,#2433f0,#8b93ff)]" />
        </div>
      </div>
    )
  }
  {
    kind === 'hero' && (
      <div class="relative h-full overflow-hidden rounded-xl bg-[linear-gradient(120deg,#c9cfe9_0%,#eef0f8_45%,#ffd9c7_100%)] p-5">
        <div class="absolute bottom-0 right-6 h-[82%] w-[38%] rounded-t-[999px] bg-[linear-gradient(180deg,#2433f0,#121a8c)] opacity-90" />
        <div class="relative flex h-full max-w-[55%] flex-col justify-center gap-2.5">
          <i class="block h-[10px] w-full rounded-full bg-ink" />
          <i class="block h-[10px] w-4/5 rounded-full bg-ink" />
          <i class={`${bar} mt-1 w-full !bg-white`} />
          <i class={`${bar} w-2/3 !bg-white`} />
          <span class="mt-2 inline-flex w-fit rounded-full bg-ink px-3 py-1.5 text-[10px] font-semibold text-white">Shop now</span>
        </div>
      </div>
    )
  }
  {
    kind === 'product' && (
      <div class="grid h-full grid-cols-2 gap-4">
        <div class="rounded-xl bg-[radial-gradient(circle_at_40%_35%,#ffffff,#dfe2ee_70%)] p-3">
          <div class="mx-auto mt-4 h-[58%] w-[46%] rounded-[14px] bg-[linear-gradient(180deg,#0e1018,#3a3f55)]" />
        </div>
        <div class="flex flex-col gap-2">
          <i class="block h-[9px] w-4/5 rounded-full bg-ink" />
          <span class="font-head text-[14px] font-bold">€49</span>
          <span class="flex gap-1.5">
            <i class="block size-4 rounded-full bg-ink ring-2 ring-blue ring-offset-1" />
            <i class="block size-4 rounded-full bg-[#c9a24d]" />
            <i class="block size-4 rounded-full bg-[#e7a1b8]" />
            <i class="block size-4 rounded-full bg-[#dfe2ee]" />
          </span>
          <span class="flex gap-1.5 text-[10px] font-semibold">
            <span class="rounded-md bg-blue px-2 py-1 text-white">30 ml</span>
            <span class="rounded-md border border-[#dfe2ee] px-2 py-1">50 ml</span>
          </span>
          <span class="rounded-lg border-2 border-blue px-2 py-1.5 text-[10px] font-semibold text-blue">Bundle & save 15%</span>
          <span class="mt-auto rounded-full bg-ink py-2 text-center text-[10px] font-semibold text-white">Add to cart</span>
        </div>
      </div>
    )
  }
  {
    kind === 'cart' && (
      <div class="flex h-full flex-col gap-2.5">
        <div class="flex items-center justify-between text-[11px] font-semibold">
          <span>Cart (2)</span>
          <span class="text-mute">×</span>
        </div>
        <div>
          <span class="text-[10px] text-mute">€12 away from free shipping</span>
          <span class="mt-1 block h-[6px] overflow-hidden rounded-full bg-[#dfe2ee]">
            <i class="block h-full w-3/4 rounded-full bg-blue" />
          </span>
        </div>
        {[0, 1].map(() => (
          <div class="flex items-center gap-2.5">
            <i class="block size-9 rounded-lg bg-[#eef0f8]" />
            <span class="flex flex-1 flex-col gap-1.5">
              <i class={`${bar} w-3/4 !bg-ink`} />
              <i class={`${bar} w-1/3`} />
            </span>
            <span class="text-[10px] font-semibold">€49</span>
          </div>
        ))}
        <span class="w-fit rounded-full bg-[#e3e6ff] px-2.5 py-1 text-[10px] font-semibold text-blue">Gift added ✓</span>
        <span class="mt-auto rounded-full bg-blue py-2 text-center text-[10px] font-semibold text-white">Checkout</span>
      </div>
    )
  }
  {
    kind === 'markets' && (
      <div class="grid h-full grid-cols-[1fr_1.2fr] gap-4">
        <div class="grid grid-cols-2 content-start gap-1.5 text-[10px] font-semibold">
          {['€ EUR', '$ USD', '£ GBP', 'kr SEK', 'A$ AUD', 'C$ CAD'].map((c, i) => (
            <span class={`rounded-md px-2 py-1.5 ${i === 0 ? 'bg-blue text-white' : 'bg-[#f3f4f9]'}`}>{c}</span>
          ))}
        </div>
        <div class="flex flex-col gap-1.5 text-[10px]">
          {['Viewed product', 'Added to cart', 'Started checkout', 'Placed order'].map((e, i) => (
            <span class="flex items-center gap-2">
              <i class={`block size-2 rounded-full ${i === 3 ? 'bg-blue' : 'bg-ink'}`} />
              <span class="flex-1 font-medium">{e}</span>
              <span class="text-mute">{['0:02', '0:41', '1:15', '2:30'][i]}</span>
            </span>
          ))}
          <span class="mt-auto flex h-10 items-end gap-1">
            {[30, 45, 38, 60, 52, 72, 66, 88].map((h) => (
              <i class="block flex-1 rounded-sm bg-blue/80" style={`height:${h}%`} />
            ))}
          </span>
        </div>
      </div>
    )
  }
</div>
