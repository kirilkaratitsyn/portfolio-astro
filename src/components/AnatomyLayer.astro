---
// One layer of the anatomy section (sections/Anatomy.astro): a small, drawn moment of a project, from the kick-off call
// to analytics. Decorative only; the words that matter are in the list next to it. Logos: Simple Icons (CC0). The
// people on the call are initials, and the numbers are placeholders, not a client's results.
import shopify from '../assets/stack/shopify.svg?raw';
import figma from '../assets/stack/figma.svg?raw';
import meet from '../assets/stack/googlemeet.svg?raw';
import google from '../assets/stack/google.svg?raw';
import analytics from '../assets/stack/googleanalytics.svg?raw';

interface Props {
  kind: 'call' | 'brief' | 'build' | 'qa' | 'seo' | 'analytics';
}

const { kind } = Astro.props;
const bar = 'block h-[7px] rounded-full bg-[#dfe2ee]';
const logo = (svg: string, size = 14) =>
  svg.replace(/<title>.*?<\/title>/, '').replace('<svg ', `<svg aria-hidden="true" fill="currentColor" width="${size}" height="${size}" `);
const check = '<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7"/></svg>';
---

<div class="anat-card min-w-0" aria-hidden="true">
  {
    kind === 'call' && (
      <div class="flex h-full flex-col gap-2.5">
        <div class="flex items-center justify-between text-[11px] font-semibold">
          <span class="flex items-center gap-1.5">
            <span class="text-[#00897b]" set:html={logo(meet)} />
            Kick-off call · 30 min
          </span>
          <span class="flex items-center gap-1 rounded-full bg-[#e3e6ff] px-2 py-0.5 text-[10px] text-blue">
            <i class="block size-1.5 rounded-full bg-blue" />
            Live
          </span>
        </div>
        <div class="grid min-h-0 flex-1 grid-cols-[1.35fr_1fr] gap-2.5">
          <div class="relative grid place-items-center rounded-xl bg-[linear-gradient(135deg,#2433f0,#121a8c)]">
            <span class="grid size-14 place-items-center rounded-full bg-white/15 font-head text-[19px] font-bold text-white">KK</span>
            <span class="absolute bottom-2 left-2.5 text-[10px] font-semibold text-white/85">Kiril</span>
          </div>
          <div class="grid min-h-0 grid-rows-2 gap-2.5">
            <div class="relative grid place-items-center rounded-xl bg-[#e9ebf5]">
              <span class="grid size-9 place-items-center rounded-full bg-ink font-head text-[12px] font-bold text-white">You</span>
            </div>
            <div class="flex flex-col justify-center gap-1 rounded-xl border border-[#dfe2ee] px-2.5 text-[10px] font-medium">
              {['Goals', 'Pages', 'Deadline'].map((note) => (
                <span class="flex items-center gap-1.5">
                  <span class="text-blue" set:html={check} />
                  {note}
                </span>
              ))}
            </div>
          </div>
        </div>
        <div class="flex justify-center gap-2">
          <i class="block size-6 rounded-full bg-[#eef0f8]" />
          <i class="block size-6 rounded-full bg-[#eef0f8]" />
          <i class="block h-6 w-9 rounded-full bg-[#e5484d]" />
        </div>
      </div>
    )
  }
  {
    kind === 'brief' && (
      <div class="grid h-full grid-cols-2 gap-3">
        <div class="flex min-w-0 flex-col gap-2 rounded-xl border border-[#dfe2ee] p-3">
          <span class="text-[11px] font-semibold">Project brief</span>
          {['w-4/5', 'w-3/5', 'w-full', 'w-2/3', 'w-1/2'].map((w, i) => (
            <span class="flex items-center gap-2">
              <span class={`grid size-3.5 shrink-0 place-items-center rounded-[4px] ${i < 4 ? 'bg-blue text-white' : 'border border-[#c9cde0]'}`} set:html={i < 4 ? check : ''} />
              <i class={`${bar} ${w}`} />
            </span>
          ))}
          <span class="mt-auto w-fit rounded-full bg-[#e3e6ff] px-2 py-0.5 text-[10px] font-semibold text-blue">Scope · timeline · price</span>
        </div>
        <div class="flex min-w-0 flex-col gap-2 rounded-xl bg-[#f3f4f9] p-2.5">
          <span class="flex items-center gap-1.5 text-[10px] font-semibold">
            <span set:html={logo(figma, 12)} />
            Homepage
          </span>
          <div class="grid min-h-0 flex-1 grid-cols-3 gap-1.5">
            {['#2433f0', '#e7a1b8', '#c9a24d'].map((color, i) => (
              <div class={`flex flex-col gap-1 rounded-md bg-white p-1.5 ${i === 1 ? 'outline outline-2 outline-[#a259ff]' : ''}`}>
                <i class="block h-[38%] rounded-sm" style={`background:${color}`} />
                <i class="block h-[5px] w-4/5 rounded-full bg-ink" />
                <i class={`${bar} h-[5px] w-full`} />
                <i class={`${bar} h-[5px] w-2/3`} />
              </div>
            ))}
          </div>
        </div>
      </div>
    )
  }
  {
    kind === 'build' && (
      <div class="flex h-full flex-col gap-2">
        <div class="flex items-center justify-between text-[10px] font-semibold">
          <span class="flex items-center gap-1.5 text-[#5e8e3e]">
            <span set:html={logo(shopify, 13)} />
            <span class="text-ink">Preview theme</span>
          </span>
          <span class="rounded-md bg-[#eef0f8] px-2 py-1 text-mute">Publish</span>
        </div>
        <div class="grid min-h-0 flex-1 grid-cols-[0.9fr_1.6fr] gap-2.5">
          <div class="flex flex-col gap-1 rounded-xl bg-[#f3f4f9] p-2 text-[10px] font-medium">
            {['Header', 'Hero banner', 'Collection', 'Reviews', 'Footer'].map((name, i) => (
              <span class={`truncate rounded-md px-2 py-1 ${i === 2 ? 'bg-white font-semibold text-blue shadow-[0_2px_6px_rgba(14,16,40,0.08)]' : ''}`}>{name}</span>
            ))}
            <span class="mt-auto px-2 text-[10px] font-semibold text-blue">+ Add section</span>
          </div>
          <div class="flex min-w-0 flex-col gap-1.5 rounded-xl border border-[#dfe2ee] p-2">
            <i class="block h-[30%] rounded-md bg-[linear-gradient(120deg,#c9cfe9,#ffd9c7)]" />
            <div class="grid flex-1 grid-cols-3 gap-1.5 rounded-md p-1 outline-dashed outline-2 outline-blue">
              {[0, 1, 2].map(() => (
                <span class="flex flex-col gap-1">
                  <i class="block flex-1 rounded-sm bg-[#eef0f8]" />
                  <i class="block h-[5px] w-4/5 rounded-full bg-ink" />
                </span>
              ))}
            </div>
            <span class="flex gap-0.5 text-[9px] text-[#c9a24d]">★★★★★</span>
          </div>
        </div>
      </div>
    )
  }
  {
    kind === 'qa' && (
      <div class="grid h-full grid-cols-[1.25fr_1fr] gap-3">
        <div class="flex min-w-0 items-end gap-2">
          <div class="flex h-[88%] flex-[2.2] flex-col gap-1 rounded-lg border-2 border-ink p-1.5">
            <i class="block h-[40%] rounded-sm bg-[#e9ebf5]" />
            <i class="block h-[5px] w-3/4 rounded-full bg-ink" />
            <i class={`${bar} h-[5px] w-full`} />
          </div>
          <div class="flex h-[70%] flex-[1.3] flex-col gap-1 rounded-lg border-2 border-ink p-1">
            <i class="block h-[40%] rounded-sm bg-[#e9ebf5]" />
            <i class="block h-[5px] w-3/4 rounded-full bg-ink" />
          </div>
          <div class="flex h-[52%] flex-1 flex-col gap-1 rounded-[7px] border-2 border-ink p-1">
            <i class="block h-[40%] rounded-sm bg-[#e9ebf5]" />
            <i class="block h-[4px] w-3/4 rounded-full bg-ink" />
          </div>
        </div>
        <div class="flex flex-col justify-center gap-1.5 text-[10px] font-medium">
          {['Cart & checkout', 'iPhone · Safari', 'Android · Chrome', 'Translations', 'Page speed'].map((test) => (
            <span class="flex items-center gap-1.5">
              <span class="grid size-4 shrink-0 place-items-center rounded-full bg-[#e3e6ff] text-blue" set:html={check} />
              {test}
            </span>
          ))}
          <span class="mt-1 w-fit rounded-full bg-ink px-2 py-0.5 text-[10px] font-semibold text-white">0 open bugs</span>
        </div>
      </div>
    )
  }
  {
    kind === 'seo' && (
      <div class="flex h-full flex-col gap-2.5">
        <div class="flex items-center gap-2 rounded-full border border-[#dfe2ee] px-3 py-1.5 text-[10px] text-mute">
          <span class="text-ink" set:html={logo(google, 12)} />
          silk flowers seattle
        </div>
        <div class="flex flex-col gap-1 rounded-xl bg-[#f3f4f9] p-2.5">
          <span class="text-[9px] text-mute">yourstore.com › collections › silk-flowers</span>
          <span class="text-[12px] font-semibold text-blue">Silk Flower Arrangements | Your Store</span>
          <i class={`${bar} w-full`} />
          <i class={`${bar} w-3/4`} />
          <span class="text-[9px] text-[#c9a24d]">★★★★★ <span class="text-mute">Rating · In stock</span></span>
        </div>
        <div class="mt-auto flex flex-wrap gap-1.5 text-[10px] font-semibold">
          {['Titles & meta', '301 redirects', 'Sitemap', 'Product schema'].map((item) => (
            <span class="flex items-center gap-1 rounded-full border border-[#dfe2ee] px-2 py-1">
              <span class="text-blue" set:html={check} />
              {item}
            </span>
          ))}
        </div>
      </div>
    )
  }
  {
    kind === 'analytics' && (
      <div class="grid h-full grid-cols-[1.3fr_1fr] gap-3">
        <div class="flex min-w-0 flex-col gap-2 rounded-xl bg-[#f3f4f9] p-2.5">
          <span class="flex items-center justify-between text-[10px] font-semibold">
            <span class="flex items-center gap-1.5">
              <span class="text-[#e37400]" set:html={logo(analytics, 12)} />
              Sessions
            </span>
            <span class="text-mute">30 days</span>
          </span>
          <svg viewBox="0 0 120 54" preserveAspectRatio="none" class="min-h-0 w-full flex-1" aria-hidden="true">
            <path d="M0 46 L15 42 L30 44 L45 34 L60 36 L75 25 L90 27 L105 15 L120 9 L120 54 L0 54 Z" fill="rgba(36,51,240,0.12)" />
            <path d="M0 46 L15 42 L30 44 L45 34 L60 36 L75 25 L90 27 L105 15 L120 9" fill="none" stroke="#2433f0" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="flex flex-col justify-center gap-1.5 font-mono text-[9.5px]">
          {['view_item', 'add_to_cart', 'begin_checkout', 'purchase'].map((event, i) => (
            <span class="flex flex-col gap-0.5">
              <span class="flex items-center justify-between">
                {event}
                <span class="text-blue" set:html={check} />
              </span>
              <i class="block h-[5px] rounded-full bg-blue/80" style={`width:${100 - i * 22}%`} />
            </span>
          ))}
          <span class="mt-1 w-fit rounded-full bg-[#e3e6ff] px-2 py-0.5 font-sans text-[10px] font-semibold text-blue">GA4 · Meta · Klaviyo</span>
        </div>
      </div>
    )
  }
</div>
