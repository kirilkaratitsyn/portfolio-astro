---
import type { Locale } from '../i18n';

// The block that is unique to one case study, drawn in the style of the client's trade. It only re-presents facts
// that already stand in the case file (pages built, counts, steps); nothing new is claimed here.
interface Props {
  theme: 'film' | 'ritual';
  locale: Locale;
}

const { theme, locale } = Astro.props;

const film = {
  en: { stats: ['sections', 'blocks', 'rating on Upwork'], timeline: 'What was built, laid out as an edit timeline', demo: 'Demo of the drop timer built for the store' },
  de: { stats: ['Sections', 'Blöcke', 'Bewertung auf Upwork'], timeline: 'Was gebaut wurde, als Schnitt-Timeline', demo: 'Demo des Drop-Timers aus dem Shop' },
  uk: { stats: ['секції', 'блоків', 'оцінка на Upwork'], timeline: 'Що зроблено, як монтажна стрічка', demo: 'Демо таймера дропу з магазину' },
}[locale];

const ritual = {
  en: {
    stats: ['sections', 'blocks', 'templates', 'Cloudflare Workers', 'cart Functions'],
    tiers: 'Access tiers, read from customer tags',
    pipe: 'From approval to a B2B company, without manual setup',
    steps: ['Professional approved', 'Webhook verified', 'Customer read through the Admin API', 'Company and contact created', 'Location admin role assigned', '2 markets, 1 catalogue, ordering approved'],
  },
  de: {
    stats: ['Sections', 'Blöcke', 'Templates', 'Cloudflare Workers', 'Cart-Functions'],
    tiers: 'Zugriffsstufen, gelesen aus Kunden-Tags',
    pipe: 'Von der Freigabe zur B2B-Firma, ohne Handarbeit',
    steps: ['Profi freigegeben', 'Webhook geprüft', 'Kunde über die Admin API gelesen', 'Firma und Kontakt angelegt', 'Rolle Location admin vergeben', '2 Märkte, 1 Katalog, Bestellen freigegeben'],
  },
  uk: {
    stats: ['секція', 'блоків', 'шаблонів', 'Cloudflare Workers', 'Functions кошика'],
    tiers: 'Рівні доступу, прочитані з тегів клієнта',
    pipe: 'Від схвалення до B2B-компанії без ручної роботи',
    steps: ['Професіонала схвалено', 'Вебхук перевірено', 'Клієнта прочитано через Admin API', 'Створено компанію і контакт', 'Призначено роль Location admin', '2 ринки, 1 каталог, замовлення дозволено'],
  },
}[locale];

const tracks = [
  { name: 'V1', clips: [{ label: 'Home', w: 30 }, { label: 'Work', w: 26 }, { label: 'Shop', w: 30 }] },
  { name: 'V2', offset: 18, clips: [{ label: 'Free Downloads', w: 40 }, { label: 'FAQ', w: 18 }] },
  { name: 'A1', offset: 34, clips: [{ label: 'Selected', w: 24 }, { label: 'Shorts', w: 24 }] },
];
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---

{
  theme === 'film' && (
    <section class="mt-14 md:mt-20">
      <ul class="grid grid-cols-3 gap-3 md:gap-5">
        {['33', '89', '5.0'].map((value, i) => (
          <li class="flair-card">
            <b class="flair-num">{value}</b>
            <span class="flair-cap">{film.stats[i]}</span>
          </li>
        ))}
      </ul>

      <div class="mt-3 grid gap-3 md:mt-5 md:grid-cols-[1.5fr_1fr] md:gap-5">
        <div class="flair-card">
          <p class="flair-label">{film.timeline}</p>
          <div class="tl" aria-hidden="true">
            <div class="tl-ruler">
              {['00:00', '00:10', '00:20', '00:30', '00:40'].map((tc) => <span>{tc}</span>)}
            </div>
            {tracks.map((track, t) => (
              <div class="tl-track">
                <span class="tl-name">{track.name}</span>
                <div class="tl-lane" style={`padding-left:${track.offset ?? 0}%`}>
                  {track.clips.map((clip, c) => (
                    <span class={`tl-clip tl-clip--${(t + c) % 3}`} style={`width:${clip.w}%`}>{clip.label}</span>
                  ))}
                </div>
              </div>
            ))}
            <i class="tl-head" />
          </div>
        </div>

        <div class="flair-card flex flex-col" data-drop-demo>
          <p class="flair-label">{film.demo}</p>
          <div class="flair-grad mt-5 h-24 rounded-2xl md:h-28" aria-hidden="true" />
          <div class="mt-auto pt-5">
            <div class="flex flex-wrap gap-2 text-[13px] font-medium">
              <span class="rounded-full bg-[#3c94f3] px-3 py-1.5 text-white">Available for <span data-drop-time>23h 14m 07s</span></span>
              <span class="rounded-full bg-[#c7c7cf] px-3 py-1.5">No email required</span>
            </div>
            <p class="mt-4 font-head text-2xl font-bold">Free drop</p>
            <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-[#e6e8f0]">
              <i data-drop-bar class="block h-full w-[3%] rounded-full bg-[#3c94f3]" />
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

{
  theme === 'ritual' && (
    <section class="mt-14 md:mt-20">
      <ul class="grid grid-cols-2 gap-3 md:grid-cols-5 md:gap-5">
        {['71', '167', '14', '2', '2'].map((value, i) => (
          <li class={`flair-card ${i === 4 ? 'col-span-2 md:col-span-1' : ''}`}>
            <b class="flair-num">{value}</b>
            <span class="flair-cap">{ritual.stats[i]}</span>
          </li>
        ))}
      </ul>

      <div class="mt-3 grid gap-3 md:mt-5 md:grid-cols-[1fr_1.3fr] md:gap-5">
        <div class="flair-card">
          <p class="flair-label">{ritual.tiers}</p>
          <ol class="tiers mt-10">
            {['Guest', 'Approved', 'Ordered', 'Committed'].map((tier, i) => (
              <li>
                <i style={`background:${['#e3d8c3', '#cdb994', '#ad9167', '#8c6a3f'][i]}`} />
                <span>{tier}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="flair-card">
          <p class="flair-label">{ritual.pipe}</p>
          <ol class="mt-5">
            {ritual.steps.map((step, i) => (
              <li class="pipe-step">
                <span>{roman[i]}</span>
                <p>{step}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}

{
  theme === 'film' && (
    <script is:inline>
      {`(() => {
        const root = document.querySelector('[data-drop-demo]');
        if (!root) return;
        const time = root.querySelector('[data-drop-time]');
        const bar = root.querySelector('[data-drop-bar]');
        const DAY = 24 * 3600;
        let left = 23 * 3600 + 14 * 60 + 7;
        const pad = (n) => String(n).padStart(2, '0');
        setInterval(() => {
          left = left > 0 ? left - 1 : DAY;
          time.textContent = Math.floor(left / 3600) + 'h ' + pad(Math.floor((left % 3600) / 60)) + 'm ' + pad(left % 60) + 's';
          bar.style.width = Math.max(3, ((DAY - left) / DAY) * 100) + '%';
        }, 1000);
      })();`}
    </script>
  )
}
