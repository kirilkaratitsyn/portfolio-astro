---
import type { Locale } from '../i18n';

// The block that is unique to one case study, drawn in the style of the client's trade. It only re-presents facts
// that already stand in the case file (pages built, counts, steps); nothing new is claimed here.
interface Props {
  theme: 'ritual';
  locale: Locale;
}

const { theme, locale } = Astro.props;

// Owner benefits first: what the store gained, not how many parts were built.
const ritual = {
  en: {
    stats: [['1', 'store for guests and skincare professionals'], ['4', 'tiers, each with its own prices and tools'], ['0', 'manual steps when a professional is approved']],
    tiers: 'Every tier sees its own prices',
    pipe: 'From approval to wholesale orders, without manual setup',
    steps: ['The team approves a professional', 'The B2B company account is created on its own', 'The professional orders at B2B terms'],
  },
  de: {
    stats: [['1', 'Shop für Gäste und Kosmetik-Profis'], ['4', 'Stufen mit eigenen Preisen und Werkzeugen'], ['0', 'Handgriffe, wenn ein Profi freigegeben wird']],
    tiers: 'Jede Stufe sieht ihre eigenen Preise',
    pipe: 'Von der Freigabe zur Großhandelsbestellung, ohne Handarbeit',
    steps: ['Das Team gibt einen Profi frei', 'Das B2B-Firmenkonto entsteht von selbst', 'Der Profi bestellt zu B2B-Konditionen'],
  },
  uk: {
    stats: [['1', 'магазин для гостей і косметологів'], ['4', 'рівні, кожен зі своїми цінами й інструментами'], ['0', 'ручних кроків, коли професіонала схвалено']],
    tiers: 'Кожен рівень бачить свої ціни',
    pipe: 'Від схвалення до оптового замовлення без ручної роботи',
    steps: ['Команда схвалює професіонала', 'B2B-акаунт компанії створюється сам', 'Професіонал замовляє на B2B-умовах'],
  },
}[locale];

const roman = ['I', 'II', 'III'];
---

{
  theme === 'ritual' && (
    <section class="mt-14 md:mt-20">
      <div class="grid gap-3 md:grid-cols-[1fr_1.3fr] md:gap-5">
        <div class="flair-card">
          <p class="flair-label">{ritual.tiers}</p>
          <ol class="tiers mt-10">
            {['Guest', 'Approved', 'Ordered', 'Committed'].map((tier, i) => (
              <li>
                <i style={`background:${['#e3d8c3', '#cdb994', '#ad9167', '#8c6a3f'][i]}`} />
                <span>{tier}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="flair-card">
          <p class="flair-label">{ritual.pipe}</p>
          <ol class="mt-5">
            {ritual.steps.map((step, i) => (
              <li class="pipe-step">
                <span>{roman[i]}</span>
                <p>{step}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}
