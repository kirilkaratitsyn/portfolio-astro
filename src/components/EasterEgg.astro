---
// The easter egg: "Block für Block", a small stacking game (scripts/stack-game.ts). It opens with the Konami code
// (↑ ↑ ↓ ↓ ← → ← → B A) or five quick clicks or taps on the big surname in the footer; the console drops a hint.
// It opens with a little unlock: the box pops out of a block and small blocks burst around it. The game code loads
// only when it opens. Nothing is stored and nothing is sent.
import { localizePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).egg;
---

<dialog
  data-egg
  class="egg"
  aria-labelledby="egg-title"
  data-text={JSON.stringify({ layers: t.layers, floors: t.floors, perfect: t.perfect, tap: t.tap })}
  data-over={t.over}
>
  <div class="egg-box">
    <div class="egg-head">
      <div class="min-w-0">
        <p class="egg-found">{t.found}</p>
        <h2 id="egg-title" class="font-head text-[20px] font-bold leading-tight">{t.title}</h2>
      </div>
      <button type="button" data-egg-close class="egg-close" aria-label={t.close}>×</button>
    </div>
    <div class="egg-field">
      <canvas data-egg-canvas tabindex="0" class="egg-canvas" aria-label={t.hint}></canvas>
      <div data-egg-over class="egg-over" hidden>
        <p data-egg-score class="font-head text-[22px] font-bold leading-tight" aria-live="polite"></p>
        <div class="egg-actions">
          <button type="button" data-egg-again class="egg-btn egg-btn-dark">{t.again}</button>
          <a href={localizePath(locale, '/#contact')} data-egg-cta class="egg-btn">{t.cta}</a>
        </div>
      </div>
    </div>
  </div>
  <div data-egg-burst class="egg-burst" aria-hidden="true"></div>
</dialog>

<style>
  .egg {
    width: min(500px, calc(100vw - 12px));
    max-width: none;
    max-height: calc(100dvh - 12px);
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 22px;
    background: #edeff6;
    color: #0e1018;
    box-shadow: 0 30px 80px rgba(8, 12, 40, 0.35);
  }
  .egg::backdrop { background: rgba(14, 16, 24, 0.55); }
  .egg[open] { animation: egg-in 0.7s cubic-bezier(0.2, 1.4, 0.4, 1) both; }
  .egg[open]::backdrop { animation: egg-fade 0.4s ease both; }
  @keyframes egg-in {
    0% { transform: scale(0.08) rotate(-18deg); opacity: 0; border-radius: 6px; }
    45% { opacity: 1; }
    100% { transform: none; opacity: 1; }
  }
  @keyframes egg-fade { from { opacity: 0; } }
  .egg-box { display: grid; gap: 8px; padding: 10px; }
  .egg-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 2px 4px 0; }
  .egg-found {
    display: inline-block; margin-bottom: 4px; border-radius: 999px; background: #5b8fe0; padding: 3px 10px;
    font-size: 12px; font-weight: 700; color: #fff;
  }
  .egg[open] .egg-found { animation: egg-pop 0.5s 0.35s cubic-bezier(0.2, 1.6, 0.4, 1) both; }
  @keyframes egg-pop { from { transform: scale(0); } }
  .egg-close { flex: none; width: 36px; height: 36px; border-radius: 999px; background: #fff; font-size: 22px; line-height: 1; }
  .egg-field { position: relative; }
  .egg-canvas {
    display: block; width: 100%; height: min(680px, calc(100dvh - 104px)); border-radius: 16px;
    background: linear-gradient(#fff, #e7eaf4); outline: none; touch-action: manipulation; cursor: pointer;
    user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
  }
  .egg-over {
    position: absolute; inset: auto 8px 8px; display: grid; gap: 12px; border-radius: 14px; background: rgba(255, 255, 255, 0.94);
    padding: 16px 14px; text-align: center; box-shadow: 0 10px 30px rgba(8, 12, 40, 0.12);
  }
  .egg-over[hidden] { display: none; }
  .egg-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .egg-btn { display: inline-flex; border-radius: 999px; background: #5b8fe0; padding: 11px 18px; font-size: 15px; font-weight: 600; color: #fff; }
  .egg-btn-dark { background: #0e1018; }
  .egg-burst { position: absolute; left: 50%; top: 50%; width: 0; height: 0; pointer-events: none; }
  .egg-burst :global(i) { position: absolute; left: 0; top: 0; display: block; border-radius: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .egg[open], .egg[open]::backdrop, .egg[open] .egg-found { animation: none; }
  }
</style>

<script>
  import type { StackText } from '../scripts/stack-game';

  const dialog = document.querySelector<HTMLDialogElement>('[data-egg]');
  if (dialog) {
    const canvas = dialog.querySelector<HTMLCanvasElement>('[data-egg-canvas]')!;
    const overBox = dialog.querySelector<HTMLElement>('[data-egg-over]')!;
    const score = dialog.querySelector<HTMLElement>('[data-egg-score]')!;
    const burst = dialog.querySelector<HTMLElement>('[data-egg-burst]')!;
    const text = JSON.parse(dialog.dataset.text!) as StackText;
    let game: Awaited<ReturnType<typeof import('../scripts/stack-game').startStack>> | null = null;

    /** Small blocks in the site's colours fly out from the middle as the box opens. */
    const pop = () => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const colors = ['#5b8fe0', '#0e1018', '#ffffff', '#c9cfe4', '#b1caf0'];
      for (let i = 0; i < 26; i++) {
        const piece = document.createElement('i');
        const size = 8 + Math.random() * 12;
        Object.assign(piece.style, { width: `${size}px`, height: `${size}px`, background: colors[i % colors.length], boxShadow: '0 2px 6px rgba(8,12,40,.25)' });
        burst.append(piece);
        const angle = (i / 26) * Math.PI * 2 + Math.random() * 0.4;
        const distance = 170 + Math.random() * 190;
        const x = Math.cos(angle) * distance;
        const y = Math.sin(angle) * distance;
        piece
          .animate(
            [
              { transform: 'translate(-50%, -50%) scale(0.3) rotate(0deg)', opacity: 1 },
              { transform: `translate(calc(${x}px - 50%), calc(${y}px - 50%)) scale(1) rotate(${Math.random() * 540 - 270}deg)`, opacity: 1, offset: 0.7 },
              { transform: `translate(calc(${x * 1.1}px - 50%), calc(${y * 1.1 + 60}px - 50%)) scale(0.8) rotate(${Math.random() * 720 - 360}deg)`, opacity: 0 },
            ],
            { duration: 900 + Math.random() * 400, easing: 'cubic-bezier(0.2, 0.8, 0.3, 1)', delay: 120 },
          )
          .finished.then(() => piece.remove(), () => piece.remove());
      }
    };

    const open = async () => {
      if (dialog.open) return;
      dialog.showModal();
      // The game field gets the focus (not the close button), so the first Space drops a block.
      canvas.focus({ preventScroll: true });
      overBox.hidden = true;
      pop();
      const { startStack } = await import('../scripts/stack-game');
      game?.stop();
      game = startStack(canvas, text, (floors) => {
        score.textContent = (dialog.dataset.over ?? '{n}').replace('{n}', String(floors));
        overBox.hidden = false;
      });
    };
    const close = () => dialog.close();
    dialog.addEventListener('close', () => {
      game?.stop();
      game = null;
    });

    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      game?.drop();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.key === 'Enter') {
        if ((e.target as Element).closest('button, a')) return;
        e.preventDefault();
        game?.drop();
      }
    });
    dialog.querySelector('[data-egg-close]')!.addEventListener('click', close);
    dialog.querySelector('[data-egg-cta]')!.addEventListener('click', close);
    dialog.querySelector('[data-egg-again]')!.addEventListener('click', () => {
      overBox.hidden = true;
      game?.restart();
      canvas.focus({ preventScroll: true });
    });
    // A click on the dark area around the box closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    window.addEventListener('resize', () => game?.resize());

    // The Konami code.
    const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let at = 0;
    window.addEventListener('keydown', (e) => {
      const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      at = key === code[at] ? at + 1 : key === code[0] ? 1 : 0;
      if (at === code.length) {
        at = 0;
        void open();
      }
    });

    // Five quick clicks or taps on the big surname in the footer.
    const word = document.querySelector('[data-footer-wm]')?.parentElement;
    let taps: number[] = [];
    word?.addEventListener('click', () => {
      const now = performance.now();
      taps = [...taps.filter((t) => now - t < 2000), now];
      if (taps.length >= 5) {
        taps = [];
        void open();
      }
    });

    console.log('%ckaratitsyn.com', 'font: 700 18px sans-serif; color: #5b8fe0', '\nPsst… ↑ ↑ ↓ ↓ ← → ← → B A');
  }
</script>
