---
// A card of the project catalog: the store inside a device frame on a panel in the project's own accent color. The panel
// tilts toward the cursor, the devices float at different depths, a soft light follows the pointer and, on hover, the frame
// grows as a whole (the screenshot inside it stays put). Motion lives in scripts/motion.ts (data-tilt / data-depth).
// Case studies stay on the site (→), other projects open the store in a new tab (↗).
import Phone from './Phone.astro';
import { thumb } from '../lib/thumbs';

interface Props {
  href: string;
  title: string;
  description: string;
  image: string;
  mobileImage?: string;
  /** Store domain for the phone's address bar. */
  domain?: string;
  external?: boolean;
  /** Cards in the first screen load right away (they are what the page is measured on). */
  priority?: boolean;
  /** The project's accent color (works.yaml, scripts/make-accents.mjs). */
  accent?: string;
  /** How wide the card is in the desktop grid: the device frame and the phone scale with it. */
  size?: 'sm' | 'md' | 'lg';
}

const { href, title, description, image, mobileImage, domain, external = false, priority = false, accent = '#2433f0', size = 'sm' } = Astro.props;
// The frame and phone widths follow data-size (styles/global.css .pc-frame, .pc-phone), so the filters on /projects
// can resize a card when it moves to another place in the grid.
---

<a href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="group flex h-full flex-col" data-card data-size={size}>
  <span data-tilt class="relative grid h-[340px] place-items-center overflow-hidden rounded-[28px] md:h-[400px]" style={`background:${accent}`}>
    <!-- a soft light that follows the pointer -->
    <span class="pointer-events-none absolute inset-0 z-[4] opacity-0 transition-opacity duration-500 group-hover:opacity-100" style="background: radial-gradient(520px circle at var(--mx, 50%) var(--my, 35%), rgba(255, 255, 255, 0.3), transparent 62%)"></span>
    <span data-depth="14" class="pc-frame relative block">
      <span class="block origin-center overflow-hidden rounded-xl bg-white shadow-[0_26px_55px_rgba(0,0,0,0.3)] transition-transform duration-500 ease-out group-hover:scale-[1.05]">
        <span class="flex h-[18px] items-center gap-1.5 bg-[#f1f2f6] px-3" aria-hidden="true">
          <i class="block size-[7px] rounded-full bg-[#cfd2de]"></i><i class="block size-[7px] rounded-full bg-[#cfd2de]"></i><i class="block size-[7px] rounded-full bg-[#cfd2de]"></i>
        </span>
        <img src={thumb(image, '1000')} alt="" width="1000" height="694" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" class="block aspect-[560/346] w-full object-cover object-top" />
      </span>
    </span>
    {
      mobileImage && (
        <span data-depth="20" class="pc-phone absolute bottom-7 right-[5%] z-[3] block">
          <Phone image={mobileImage} domain={domain} sizes="(min-width: 1024px) 140px, 25vw" class="origin-bottom transition-transform duration-500 ease-out group-hover:scale-[1.06]" />
        </span>
      )
    }
    <span class="absolute right-4 top-4 z-[5] flex size-11 items-center justify-center rounded-full bg-white text-[20px] text-ink transition-all duration-300 group-hover:scale-110 group-hover:bg-ink group-hover:text-white" aria-hidden="true">{external ? '↗' : '→'}</span>
  </span>
  <span class="mt-5 block font-head text-[30px] font-bold leading-none tracking-[-0.02em] transition-colors duration-300 group-hover:text-blue md:text-[34px]">{title}</span>
  <span class="mt-3 block text-[15px] leading-relaxed text-mute line-clamp-2">{description}</span>
</a>
