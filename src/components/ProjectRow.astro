---
// One row of a work list: name, thumbnails, arrow. The whole row is the link and its background runs edge to edge
// (white at rest so the ribbon behind the list is covered, cobalt on hover).
import { thumb } from '../lib/thumbs';

interface Props {
  href: string;
  title: string;
  image: string;
  mobileImage?: string;
}

const { href, title, image, mobileImage } = Astro.props;
---

<a href={href} data-peek={thumb(image, '1000')} class="group block bg-white transition-colors duration-300 hover:bg-blue hover:text-white">
  <span class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-5 py-4 md:gap-8 md:px-10 md:py-5">
    <span data-row-title class="min-w-0 font-head text-[30px] font-bold leading-none tracking-[-0.02em] md:text-[44px]">{title}</span>
    <span class="flex shrink-0 items-center gap-2" data-strip>
      <img src={thumb(image, '480')} alt="" width="120" height="78" loading="lazy" decoding="async" class="h-[56px] w-[84px] rounded-md object-cover object-top md:h-[78px] md:w-[120px]" />
      {mobileImage && <img src={thumb(mobileImage, 'm200')} alt="" width="46" height="78" loading="lazy" decoding="async" class="h-[56px] w-[32px] rounded-md object-cover object-top md:h-[78px] md:w-[46px]" />}
      <span class="ml-2 text-[22px] text-blue group-hover:text-white md:ml-6" data-arrow aria-hidden="true">→</span>
    </span>
  </span>
</a>
