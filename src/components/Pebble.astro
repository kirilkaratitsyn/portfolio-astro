---
// A rendered 3D pebble (public/source/3d). Decorative, so no alt text.
interface Props {
  name: 'cobalt' | 'white' | 'black' | 'cobalt2';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<img src={`/source/3d/pebble-${name}.webp`} alt="" width="360" height="360" loading="lazy" decoding="async" class={className} />
