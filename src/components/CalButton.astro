---
// Opens the Cal.com booking popup (see the embed snippet in BaseLayout).
import type { HTMLAttributes } from 'astro/types';
import { BOOKING_LINK } from '../lib/cal';

type Props = HTMLAttributes<'button'> & { class: string; link?: string };

const { class: className, link = BOOKING_LINK, ...rest } = Astro.props;
---

<button
  type="button"
  class={className}
  data-cal-link={link}
  data-cal-namespace="free-consultation-call"
  data-cal-config='{"layout":"month_view","theme":"light"}'
  {...rest}
>
  <slot />
</button>
