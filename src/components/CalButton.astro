---
// Opens the Cal.com booking popup (see the embed snippet in BaseLayout).
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'button'> & { class: string };

const { class: className, ...rest } = Astro.props;
---

<button
  type="button"
  class={className}
  data-cal-link="kiril-karatitsyn/free-consultation-call"
  data-cal-namespace="free-consultation-call"
  data-cal-config='{"layout":"month_view","theme":"dark"}'
  {...rest}
>
  <slot />
</button>
