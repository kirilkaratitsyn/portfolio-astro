---
import { SWITCHER_LOCALES, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Unlocalized path of the current page, used to link to the same page in other languages. */
  path: string;
}

const { locale, path } = Astro.props;

// Full class strings for both backgrounds (dark page / light contact + footer), swapped by the script below.
const CLASSES = {
  active: { dark: 'text-white scale-110', light: 'text-black scale-110' },
  inactive: { dark: 'text-white/50 hover:text-white', light: 'text-black/40 hover:text-black/60' },
  divider: { dark: 'bg-white/20', light: 'bg-black/20' },
};
---

<div
  class="language-switcher fixed bottom-3 right-5 z-50 flex flex-row items-center gap-3 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 shadow-lg backdrop-blur-md md:bottom-4 md:right-5"
  data-language-switcher
>
  {
    SWITCHER_LOCALES.map((item, index) => {
      const state = item.locale === locale ? CLASSES.active : CLASSES.inactive;
      return (
        <>
          {index > 0 && (
            <span aria-hidden="true" class="relative block h-5 w-px">
              <span
                class={`absolute inset-y-[-6px] left-0 w-px ${CLASSES.divider.dark}`}
                data-dark={CLASSES.divider.dark}
                data-light={CLASSES.divider.light}
              />
            </span>
          )}
          <a
            href={localizePath(item.locale, path)}
            hreflang={item.locale}
            lang={item.locale}
            aria-current={item.locale === locale ? 'true' : undefined}
            class={`inline-block text-xs font-medium transition-all duration-300 ${state.dark}`}
            data-dark={state.dark}
            data-light={state.light}
          >
            {item.label}
          </a>
        </>
      );
    })
  }
</div>

<script>
  const switcher = document.querySelector<HTMLElement>('[data-language-switcher]');

  if (switcher) {
    const themed = [...switcher.querySelectorAll<HTMLElement>('[data-dark]')];
    let isLight: boolean | null = null;

    const applyTheme = (light: boolean) => {
      if (light === isLight) return;
      isLight = light;
      themed.forEach((element) => {
        const from = (light ? element.dataset.dark : element.dataset.light)!.split(' ');
        const to = (light ? element.dataset.light : element.dataset.dark)!.split(' ');
        element.classList.remove(...from);
        element.classList.add(...to);
      });
    };

    const update = () => {
      const rect = switcher.getBoundingClientRect();
      const elements = document.elementsFromPoint(rect.left + rect.width / 2, rect.top + rect.height / 2);
      const below = elements.find((element) => element !== switcher && !switcher.contains(element));
      applyTheme(Boolean(below?.closest('#contact, #footer')));
    };

    update();
    const schedule = () => requestAnimationFrame(update);
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
  }
</script>
