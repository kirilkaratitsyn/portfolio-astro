---
// Site search: a dialog that looks through a small JSON file built for the language (pages, services, case studies, articles).
// Opens from any [data-search-open] button, with Ctrl/Cmd+K or with "/". The file is fetched on first use from our own domain;
// nothing is stored (no cookies, no localStorage) and nothing is sent anywhere.
import Icon from './Icon.astro';
import { localizePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const labels = { ...t.search, empty: t.search.noResults };
---

<dialog class="search" data-search aria-label={t.search.title} data-index={localizePath(locale, '/search-index.json')} data-labels={JSON.stringify(labels)}>
  <div class="search__box">
    <form method="dialog" class="flex items-center gap-3 border-b border-line px-5 py-4" role="search" data-search-form>
      <Icon name="search" size={20} class="shrink-0 text-mute" />
      <input
        type="search"
        data-search-input
        placeholder={t.search.placeholder}
        aria-label={t.search.placeholder}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        class="min-w-0 flex-1 bg-transparent text-lg outline-none placeholder:text-mute"
      />
      <kbd class="search__kbd hidden md:inline-block" aria-hidden="true">Esc</kbd>
      <button type="submit" class="shrink-0 rounded-full p-1.5 text-mute transition-colors hover:bg-bg hover:text-ink" aria-label={t.search.close}><Icon name="close" size={20} /></button>
    </form>
    <div class="overflow-y-auto px-2 py-3" data-search-body>
      <p class="px-3 pb-2 text-xs font-bold uppercase tracking-[0.08em] text-mute" data-search-heading aria-live="polite">{t.search.suggestions}</p>
      <ul id="search-results" role="listbox" data-search-list></ul>
      <p class="px-3 py-4 text-[15px] text-mute" data-search-note hidden></p>
    </div>
    <p class="hidden border-t border-line px-5 py-2.5 text-xs text-mute md:block">{t.search.hint}</p>
  </div>
</dialog>

<script>
  type Item = { k: 'project' | 'service' | 'article' | 'page'; t: string; d: string; g: string; u: string; s?: 1 };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search]');
  if (dialog) {
    const labels = JSON.parse(dialog.dataset.labels ?? '{}') as Record<string, any>;
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
    const list = dialog.querySelector<HTMLElement>('[data-search-list]')!;
    const heading = dialog.querySelector<HTMLElement>('[data-search-heading]')!;
    const note = dialog.querySelector<HTMLElement>('[data-search-note]')!;
    const form = dialog.querySelector<HTMLFormElement>('[data-search-form]')!;
    const ICON: Record<Item['k'], string> = {
      project: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
      service: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.4 2.4-2.6-.6-.6-2.6z"/>',
      article: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h7"/>',
      page: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    };
    let items: Item[] | null = null;
    let loading: Promise<void> | null = null;
    let active = -1;

    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const load = () =>
      (loading ??= fetch(dialog.dataset.index!)
        .then((r) => (r.ok ? (r.json() as Promise<Item[]>) : Promise.reject(new Error(String(r.status)))))
        .then((data) => {
          items = data;
        })
        .catch(() => {
          loading = null;
          note.textContent = labels.error;
          note.hidden = false;
        }));

    // Wraps the parts of `text` that match a typed word in <mark>; positions are mapped back from the accent-free text.
    const highlight = (el: HTMLElement, text: string, words: string[]) => {
      let flat = '';
      const at: number[] = [];
      for (let i = 0; i < text.length; i++) {
        const piece = norm(text[i]);
        flat += piece;
        for (let k = 0; k < piece.length; k++) at.push(i);
      }
      const spans: [number, number][] = [];
      for (const w of words) {
        for (let from = flat.indexOf(w); w && from !== -1; from = flat.indexOf(w, from + w.length)) spans.push([at[from], at[from + w.length - 1] + 1]);
      }
      spans.sort((a, b) => a[0] - b[0]);
      const merged: [number, number][] = [];
      for (const span of spans) {
        const last = merged[merged.length - 1];
        if (last && span[0] <= last[1]) last[1] = Math.max(last[1], span[1]);
        else merged.push([...span]);
      }
      let pos = 0;
      for (const [start, end] of merged) {
        if (start > pos) el.append(text.slice(pos, start));
        const m = document.createElement('mark');
        m.textContent = text.slice(start, end);
        el.append(m);
        pos = end;
      }
      el.append(text.slice(pos));
    };

    const render = (found: Item[], words: string[] = [], enter = false) => {
      list.replaceChildren();
      list.classList.toggle('search__list--enter', enter);
      active = -1;
      for (const [i, item] of found.entries()) {
        const li = document.createElement('li');
        li.role = 'presentation';
        const a = document.createElement('a');
        a.href = item.u;
        a.id = `search-r${i}`;
        a.role = 'option';
        a.className = 'search__result flex items-start gap-3 rounded-xl px-3 py-2.5';
        a.setAttribute('aria-selected', 'false');
        a.style.setProperty('--i', String(i));
        const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        icon.setAttribute('viewBox', '0 0 24 24');
        icon.setAttribute('width', '20');
        icon.setAttribute('height', '20');
        icon.setAttribute('fill', 'none');
        icon.setAttribute('stroke', 'currentColor');
        icon.setAttribute('stroke-width', '1.8');
        icon.setAttribute('stroke-linecap', 'round');
        icon.setAttribute('stroke-linejoin', 'round');
        icon.setAttribute('class', 'mt-0.5 shrink-0 text-blue-deep');
        icon.setAttribute('aria-hidden', 'true');
        icon.innerHTML = ICON[item.k];
        const text = document.createElement('span');
        text.className = 'min-w-0 flex-1';
        const title = document.createElement('span');
        title.className = 'block font-head text-[16px] font-bold leading-snug';
        highlight(title, item.t, words);
        text.append(title);
        if (item.d) {
          const d = document.createElement('span');
          d.className = 'line-clamp-1 block text-[14px] text-mute';
          highlight(d, item.d, words);
          text.append(d);
        }
        const kind = document.createElement('span');
        kind.className = 'mt-0.5 shrink-0 text-xs font-medium text-mute';
        kind.textContent = labels.types[item.k];
        a.append(icon, text, kind);
        a.addEventListener('mousemove', () => select(i));
        li.append(a);
        list.append(li);
      }
    };

    const select = (i: number) => {
      const rows = [...list.querySelectorAll<HTMLElement>('[role=option]')];
      if (!rows.length) return;
      active = (i + rows.length) % rows.length;
      rows.forEach((row, n) => row.setAttribute('aria-selected', String(n === active)));
      input.setAttribute('aria-activedescendant', rows[active].id);
      rows[active].scrollIntoView({ block: 'nearest' });
    };

    const update = (enter = false) => {
      if (!items) return;
      const q = norm(input.value.trim());
      note.hidden = true;
      if (!q) {
        heading.textContent = labels.suggestions;
        heading.hidden = false;
        render(items.filter((i) => i.s), [], enter);
        return;
      }
      const words = q.split(/\s+/);
      const scored = items
        .map((item) => {
          const title = norm(item.t);
          const tags = norm(item.g);
          const text = norm(item.d);
          let score = 0;
          for (const w of words) {
            const s = title.startsWith(w) ? 12 : title.includes(w) ? 8 : tags.includes(w) ? 4 : text.includes(w) ? 2 : 0;
            if (!s) return { item, score: 0 };
            score += s;
          }
          return { item, score };
        })
        .filter((x) => x.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8)
        .map((x) => x.item);
      heading.textContent = String(labels.count).replace('{{count}}', String(scored.length));
      heading.hidden = !scored.length;
      render(scored, words);
      if (!scored.length) {
        note.textContent = String(labels.empty).replace('{{query}}', input.value.trim());
        note.hidden = false;
      } else {
        select(0);
      }
    };

    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    const open = () => {
      if (dialog.open) return;
      document.body.style.overflow = 'hidden';
      dialog.classList.remove('is-closing');
      dialog.showModal();
      input.value = '';
      if (!items) {
        heading.hidden = true;
        note.textContent = labels.loading;
        note.hidden = false;
      }
      load().then(() => update(true));
      input.focus();
    };
    // Plays the short exit, then closes; Esc and the backdrop go through here too.
    const close = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      if (calm.matches) return dialog.close();
      dialog.classList.add('is-closing');
      window.setTimeout(() => {
        dialog.classList.remove('is-closing');
        dialog.close();
      }, 170);
    };
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
    input.addEventListener('input', () => update());
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') (event.preventDefault(), select(active + 1));
      else if (event.key === 'ArrowUp') (event.preventDefault(), select(active - 1));
      else if (event.key === 'Enter') {
        const row = list.querySelectorAll<HTMLAnchorElement>('[role=option]')[active];
        if (row) (event.preventDefault(), (location.href = row.href));
      }
    });
    form.addEventListener('submit', (event) => event.preventDefault());
    form.querySelector('button')?.addEventListener('click', close);
    list.addEventListener('click', () => {
      document.body.style.overflow = '';
    });

    document.querySelectorAll('[data-search-open]').forEach((button) =>
      button.addEventListener('click', () => {
        // The mobile menu may be open behind the dialog: close it first.
        document.querySelector<HTMLElement>('[data-menu].is-open') && document.querySelector<HTMLButtonElement>('[data-menu-toggle]')?.click();
        open();
      }),
    );
    document.addEventListener('keydown', (event) => {
      const typing = (event.target as HTMLElement | null)?.closest('input, textarea, select, [contenteditable]');
      if ((event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !typing && !event.metaKey && !event.ctrlKey)) {
        event.preventDefault();
        open();
      }
    });
  }
</script>
