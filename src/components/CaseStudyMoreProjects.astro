---
import ProjectRow from './ProjectRow.astro';
import { localizePath, useTranslations, type Locale } from '../i18n';
import type { CaseStudy } from '../lib/content';

interface Props {
  locale: Locale;
  items: CaseStudy[];
  currentSlug: string;
}

const { locale, items, currentSlug } = Astro.props;
const copy = useTranslations(locale).caseStudies;
const others = items.filter((item) => item.slug !== currentSlug).slice(0, 3);
---

{
  others.length > 0 && (
    <section class="mt-24 md:mt-32" aria-labelledby="case-study-more-heading">
      <h2 id="case-study-more-heading" class="mx-auto max-w-[1440px] px-5 pb-6 font-head text-[36px] font-bold tracking-[-0.02em] md:px-10 md:pb-8 md:text-[56px]">
        {copy.moreProjectsTitle}
      </h2>
      <ul class="border-t border-line">
        {others.map((item) => (
          <li class="border-b border-line" data-row>
            <ProjectRow href={localizePath(locale, `/projects/${item.slug}`)} title={item.title} image={item.image} mobileImage={item.mobileImage} />
          </li>
        ))}
      </ul>
    </section>
  )
}
