---
import '../styles/global.css';
import SeoHead, { type SeoProps } from '../components/SeoHead.astro';
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';

type Props = SeoProps & {
  /** Home only: the big surname in the hero flies into the header logo on scroll (scripts/motion.ts, flyLogo). */
  flyLogo?: boolean;
  /** Where the language switcher leads, when the page has no versions in other languages (the 404 page: home). */
  switchTo?: string;
};

const { flyLogo = false, switchTo, ...seo } = Astro.props;
const { locale, path } = seo;
---

<!doctype html>
<html lang={locale} data-fly-logo={flyLogo ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#EDEFF6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48x48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Motion is an enhancement: the `motion` class (and the hidden start states behind it) exists only when the
         visitor allows animation and scripts run; it falls away on its own if the scripts never start. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(function () {
          if (!window.__motion) document.documentElement.classList.remove('motion');
        }, 7000);
      }
    </script>
    <!-- Fonts used in the first screen: the surname and the body text. -->
    <link rel="preload" href="/fonts/e-UkraineHead-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Onest-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/e-UkraineHead-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <SeoHead {...seo} />

    <!-- Cal.com booking popup: any element with data-cal-link opens it. Its script (and its cookies) loads only once
         someone heads for a booking button (pointer, focus or touch); a click that comes before it is ready is queued
         and opens the popup as soon as it is. -->
    <script is:inline>
      (function (C, A, L, NS) {
        let ready = false;
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        function load() {
          if (C.Cal) return;
          C.Cal = function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              const s = d.head.appendChild(d.createElement('script'));
              s.onload = function () {
                ready = true;
              };
              s.src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === 'string') {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ['initNamespace', namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
          C.Cal('init', NS, { origin: 'https://cal.com' });
          C.Cal.ns[NS]('ui', {
            theme: 'light',
            styles: { branding: { brandColor: '#2433F0' } },
            hideEventTypeDetails: true,
            layout: 'month_view',
          });
        }
        const button = (e) => e.target instanceof Element && e.target.closest('[data-cal-link]');
        for (const type of ['pointerover', 'focusin', 'touchstart']) {
          d.addEventListener(type, (e) => button(e) && load(), { passive: true });
        }
        d.addEventListener('click', (e) => {
          const el = button(e);
          if (!el || ready) return; // once the script is in, it opens the popup itself
          load();
          C.Cal.ns[NS]('modal', { calLink: el.getAttribute('data-cal-link'), config: JSON.parse(el.getAttribute('data-cal-config') || '{}') });
        });
      })(window, 'https://app.cal.com/embed/embed.js', 'init', 'free-consultation-call');
    </script>
  </head>
  <body>
    <Header locale={locale} path={switchTo ?? path} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
