---
import '../styles/global.css';
import SeoHead, { type SeoProps } from '../components/SeoHead.astro';
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';
import EasterEgg from '../components/EasterEgg.astro';
import type { Locale } from '../i18n';

type Props = SeoProps & {
  /** Home only: the big surname in the hero flies into the header logo on scroll (scripts/motion.ts, flyLogo). */
  flyLogo?: boolean;
  /** Where the language switcher leads, when the page has no versions in other languages (the 404 page: home). */
  switchTo?: string;
  /** Where the language switcher leads per language, when the versions have different paths (the legal pages). */
  switchLinks?: Partial<Record<Locale, string>>;
};

const { flyLogo = false, switchTo, switchLinks, ...seo } = Astro.props;
const { locale, path } = seo;
---

<!doctype html>
<html lang={locale} data-fly-logo={flyLogo ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#EDEFF6" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48x48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Motion is an enhancement: the `motion` class (and the hidden start states behind it) exists only when the
         visitor allows animation and scripts run; it falls away on its own if the scripts never start. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(function () {
          if (!window.__motion) document.documentElement.classList.remove('motion');
        }, 7000);
      }
    </script>
    <!-- Fonts used in the first screen: the surname and the body text. -->
    <link rel="preload" href="/fonts/e-UkraineHead-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Onest-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/e-UkraineHead-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <SeoHead {...seo} />

    <!-- Cal.com booking popup: any element with data-cal-link opens it. Its script loads only when a booking button is
         clicked (nothing reaches Cal.com before that, see the privacy policy); that first click is queued and opens the
         popup as soon as the script is in. -->
    <script is:inline>
      (function (C, A, L, NS) {
        let ready = false;
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        function load() {
          if (C.Cal) return;
          C.Cal = function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              const s = d.head.appendChild(d.createElement('script'));
              s.onload = function () {
                ready = true;
              };
              s.src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === 'string') {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ['initNamespace', namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
          C.Cal('init', NS, { origin: 'https://cal.com' });
          C.Cal.ns[NS]('ui', {
            theme: 'light',
            styles: { branding: { brandColor: '#5b8fe0' } },
            hideEventTypeDetails: true,
            layout: 'month_view',
          });
        }
        const button = (e) => e.target instanceof Element && e.target.closest('[data-cal-link]');
        d.addEventListener('click', (e) => {
          const el = button(e);
          if (!el || ready) return; // once the script is in, it opens the popup itself
          load();
          C.Cal.ns[NS]('modal', { calLink: el.getAttribute('data-cal-link'), config: JSON.parse(el.getAttribute('data-cal-config') || '{}') });
        });
      })(window, 'https://app.cal.com/embed/embed.js', 'init', 'free-consultation-call');
    </script>
    <!-- Vercel Web Analytics: cookieless page views and referrers (no heatmaps). Returns 404 until it is enabled in the
         Vercel project (Analytics tab). Described in the privacy policy, section 6. -->
    <script is:inline>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <Header locale={locale} path={switchTo ?? path} links={switchLinks} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <EasterEgg locale={locale} />
    <!-- Where a visitor came from (utm_* in the address of a profile or ad link) goes with a booking to Cal.com and into
         the subject of an email, and on to the next page through the site's own links. Read from the address only;
         nothing is stored. -->
    <script is:inline>
      (function () {
        const query = new URLSearchParams(location.search);
        const utm = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach((key) => {
          const value = query.get(key);
          if (value) utm[key] = value.slice(0, 100);
        });
        if (!utm.utm_source) return;
        // Links to other pages of the site carry the same utm_* in their address, so a visitor who books from a case
        // page after landing on /projects still shows the source.
        const carry = new URLSearchParams(utm).toString();
        document.querySelectorAll('a[href^="/"]:not([href^="//"])').forEach((a) => {
          const [path, hash] = a.getAttribute('href').split('#');
          a.setAttribute('href', `${path}${path.includes('?') ? '&' : '?'}${carry}${hash === undefined ? '' : `#${hash}`}`);
        });
        document.querySelectorAll('[data-cal-link]').forEach((el) => {
          el.setAttribute('data-cal-config', JSON.stringify(Object.assign(JSON.parse(el.getAttribute('data-cal-config') || '{}'), utm)));
        });
        document.querySelectorAll('a[href^="mailto:"]').forEach((a) => {
          const [address, query = ''] = a.getAttribute('href').split('?');
          const params = new URLSearchParams(query);
          params.set('subject', `${params.get('subject') || ''} (via ${utm.utm_source})`.trim());
          // mailto wants %20 for spaces, not the + that URLSearchParams writes.
          a.setAttribute('href', `${address}?${[...params].map(([key, value]) => `${key}=${encodeURIComponent(value)}`).join('&')}`);
        });
      })();
    </script>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
