---
import { Image } from 'astro:assets';
import CalButton from '../components/CalButton.astro';
import markBlack from '../assets/brand/mark-black.png';
import { SWITCHER_LOCALES, localizePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Unlocalized path of the current page, used to link to the same page in other languages. */
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);

const links = [
  { name: t.header.works, to: '/#work' },
  { name: t.header.services, to: '/#services' },
  { name: t.faq.title, to: '/#faq' },
].map((link) => ({ ...link, href: localizePath(locale, link.to) }));

const languages = SWITCHER_LOCALES.map((item) => ({ ...item, href: localizePath(item.locale, path), current: item.locale === locale }));
const pill = 'rounded-full bg-white/80 backdrop-blur';
---

<header data-header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-3 px-5 pt-5 md:px-10 md:pt-6">
    <a href={localizePath(locale, '/')} class={`pointer-events-auto flex items-center gap-2.5 py-2 pl-2.5 pr-4 font-head text-base font-bold ${pill}`}>
      <Image src={markBlack} alt="" width={64} height={72} class="h-[30px] w-auto" loading="eager" />
      Karatitsyn
    </a>

    <nav class={`pointer-events-auto hidden items-center gap-7 px-7 py-3 text-[15px] font-medium md:flex ${pill}`} aria-label="Main">
      {links.map((link) => <a href={link.href} class="hover:text-blue">{link.name}</a>)}
      <span class="flex items-center gap-2 text-[13px] text-mute">
        {
          languages.map((item, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a
                href={item.href}
                hreflang={item.locale}
                lang={item.locale}
                aria-current={item.current ? 'true' : undefined}
                class={item.current ? 'font-bold text-ink' : 'hover:text-ink'}
              >
                {item.label}
              </a>
            </>
          ))
        }
      </span>
    </nav>

    <div class="pointer-events-auto flex items-center gap-2">
      <CalButton class="whitespace-nowrap rounded-full bg-blue px-4 py-3 text-sm font-medium text-white md:px-[22px] md:text-[15px]">
        {t.header.bookCall}<span class="hidden md:inline" aria-hidden="true"> ↗</span>
      </CalButton>
      <button
        type="button"
        class={`px-4 py-3 text-sm font-medium md:hidden ${pill}`}
        aria-expanded="false"
        aria-controls="menu"
        data-menu-toggle
        data-label-open={t.header.menu}
        data-label-close={t.header.close}
      >
        {t.header.menu}
      </button>
    </div>
  </div>
</header>

<div id="menu" class="fixed inset-0 z-40 hidden overflow-y-auto bg-bg px-5 pb-10 pt-28 md:hidden" data-menu>
  <ul class="grid gap-1">
    {
      links.map((link) => (
        <li class="border-b border-line">
          <a href={link.href} class="block py-4 font-head text-4xl font-bold" data-menu-close>
            {link.name}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-8 flex items-center gap-4 text-lg">
    {
      languages.map((item) => (
        <a href={item.href} hreflang={item.locale} lang={item.locale} aria-current={item.current ? 'true' : undefined} class={item.current ? 'font-bold' : 'text-mute'}>
          {item.label}
        </a>
      ))
    }
  </p>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (toggle) toggle.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.querySelectorAll('[data-menu-close]').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => event.key === 'Escape' && setOpen(false));
</script>
