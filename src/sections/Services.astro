---
import Pebble from '../components/Pebble.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const pebbles = ['cobalt', 'white', 'black', 'cobalt2', 'white', 'black'] as const;
---

<section id="services" class="mx-auto mt-24 max-w-[1440px] scroll-mt-24 md:mt-32">
  <h2 data-split class="px-5 pb-6 font-head text-[40px] font-bold tracking-[-0.02em] md:px-10 md:pb-8 md:text-[56px]">{t.header.services}</h2>
  <ul class="grid border-t border-line md:grid-cols-2">
    {
      t.services.items.map((item, index) => (
        <li data-reveal class="flex items-center gap-4 border-b border-line px-5 py-5 font-head text-[22px] font-medium leading-tight tracking-[-0.01em] md:gap-[22px] md:px-10 md:text-[32px] md:[&:nth-child(odd)]:border-r">
          <Pebble name={pebbles[index]} class="w-10 shrink-0 md:w-[54px]" />
          {item.title}
        </li>
      ))
    }
  </ul>
</section>
