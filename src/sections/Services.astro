---
import Icon3D from '../components/Icon3D.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
// One 3D icon per service, in the order of the list.
const icons = ['shop', 'migrate', 'plug', 'bolt', 'magnifier', 'gear'] as const;
---

<section id="services" class="mx-auto mt-24 max-w-[1440px] scroll-mt-24 md:mt-32">
  <h2 data-split class="px-5 pb-6 font-head text-[40px] font-bold tracking-[-0.02em] md:px-10 md:pb-8 md:text-[56px]">{t.header.services}</h2>
  <ul class="grid border-t border-line md:grid-cols-2">
    {
      t.services.items.map((item, index) => (
        <li data-reveal class="flex items-center gap-4 border-b border-line px-5 py-4 font-head text-[22px] font-medium leading-tight tracking-[-0.01em] md:gap-[22px] md:px-10 md:text-[32px] md:[&:nth-child(odd)]:border-r">
          <Icon3D name={icons[index] ?? 'shop'} class="w-14 shrink-0 md:w-[80px]" />
          {item.title}
        </li>
      ))
    }
  </ul>
</section>
