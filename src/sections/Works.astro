---
import WorkCard from '../components/WorkCard.astro';
import { localizePath, useTranslations, type Locale } from '../i18n';
import type { CaseStudy, WorkProject } from '../lib/content';

interface Props {
  locale: Locale;
  works: WorkProject[];
  caseStudies: CaseStudy[];
}

const { locale, works, caseStudies } = Astro.props;
const t = useTranslations(locale);

const VISIBLE_ITEMS = 6;
// Projects that already appear as featured case studies above are skipped here.
const featuredSlugs = new Set(caseStudies.slice(0, 3).map((item) => item.slug));
const visibleWorks = works
  .filter((work) => !work.caseStudySlug || !featuredSlugs.has(work.caseStudySlug))
  .slice(0, VISIBLE_ITEMS);
const caseBySlug = new Map(caseStudies.map((item) => [item.slug, item]));
---

<section id="work" class="work__container">
  <div data-aos="fade-up">
    <div class="mb-8 max-w-3xl space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-white/80">{t.works.eyebrow}</p>
      <h2 class="text-[37px] font-bold primary-gradient primary-shadow">{t.works.title}</h2>
      <p class="text-lg leading-relaxed text-white/75 md:text-xl">{t.works.subtitle}</p>
    </div>

    <div class="items grid grid-cols-1 gap-x-[40px] gap-y-[40px] justify-items-center lg:grid-cols-2 xl:grid-cols-3" data-works-grid>
      {
        visibleWorks.map((work) => (
          <WorkCard
            locale={locale}
            work={work}
            caseStudy={work.caseStudySlug ? caseBySlug.get(work.caseStudySlug) : undefined}
            viewCaseLabel={t.works.viewCase}
            visitWebsiteLabel={t.works.visitWebsite}
            tilt
          />
        ))
      }
    </div>

    <div class="mb-16 mt-8 flex justify-center">
      <a
        href={localizePath(locale, '/projects')}
        class="transition-all duration-500 whitespace-nowrap font-medium bg-white text-black light-shadow px-12 py-3 text-lg rounded-full"
      >
        {t.works.loadMore}
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const grid = document.querySelector<HTMLElement>('[data-works-grid]');
  if (grid) {
    gsap.fromTo(
      grid.querySelectorAll('.item'),
      { y: 50, opacity: 0 },
      { y: 0, opacity: 1, stagger: 0.1, duration: 0.8, ease: 'power2.out' }
    );
  }

  // Subtle 3D tilt that follows the cursor.
  document.querySelectorAll<HTMLElement>('[data-tilt-card]').forEach((card) => {
    card.addEventListener('mousemove', (event) => {
      const rect = card.getBoundingClientRect();
      const xPercent = (event.clientX - rect.left) / rect.width;
      const yPercent = (event.clientY - rect.top) / rect.height;
      const tiltX = (0.5 - yPercent) * 5;
      const tiltY = (xPercent - 0.5) * 5;

      card.style.transform = `perspective(1000px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale3d(1.01, 1.01, 1.01)`;
      card.style.background = `linear-gradient(120deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, ${0.05 + xPercent * 0.05}))`;
      card.style.boxShadow = `0 4px 20px rgba(0,0,0,0.2), 
                           0 0 20px rgba(255,255,255,${0.1 + xPercent * 0.1})`;
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale3d(1, 1, 1)';
      card.style.background = 'rgba(255, 255, 255, 0.05)';
      card.style.boxShadow = '0 4px 15px rgba(0,0,0,0.1)';
    });
  });
</script>
