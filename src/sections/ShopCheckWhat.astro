---
// What the free store check gives, right under the numbers, so a visitor who reads only the first two screens knows
// what they get. The picture is the first page of the real report template filled in for a made-up store (never a
// client's report); German pages show the German one, the others the English one.
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const w = t.shopCheckWhat;
const lang = locale === 'de' ? 'de' : 'en';
---

<section id="what-you-get" class="mx-auto mt-24 grid max-w-[1440px] items-center gap-10 px-5 md:mt-32 md:px-10 lg:grid-cols-[1fr_minmax(0,560px)] lg:gap-16">
  <div>
    <h2 data-split class="max-w-[620px] font-head text-[36px] font-bold leading-[1.02] tracking-[-0.02em] md:text-[56px]">{w.title}</h2>
    <ol class="mt-8 grid gap-6 md:mt-10">
      {
        w.items.map((item, i) => (
          <li data-reveal class="grid grid-cols-[44px_1fr] gap-4 border-t border-line pt-6">
            <span class="font-head text-[28px] font-bold leading-none text-blue-deep [font-variant-numeric:tabular-nums]">{i + 1}</span>
            <div>
              <h3 class="font-head text-[22px] font-bold leading-tight md:text-[24px]">{item.title}</h3>
              <p class="mt-2 max-w-[520px] text-[16px] leading-relaxed text-mute md:text-[17px]">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 max-w-[560px] border-t border-line pt-6 text-[17px] font-medium leading-snug">{w.terms}</p>
    <a href="#shop-check" class="mt-6 inline-flex rounded-full bg-ink px-6 py-[15px] font-medium text-white">{t.hero.check.button}</a>
  </div>
  <figure data-reveal>
    <img
      src={`/source/shop-check/sample-${lang}-1240.webp`}
      srcset={`/source/shop-check/sample-${lang}-620.webp 620w, /source/shop-check/sample-${lang}-1240.webp 1240w`}
      sizes="(min-width: 1024px) 560px, calc(100vw - 40px)"
      width="1240"
      height="960"
      alt={w.alt}
      loading="lazy"
      decoding="async"
      class="block h-auto w-full rounded-[18px] border border-line shadow-[0_24px_60px_rgba(14,16,24,0.12)]"
    />
    <figcaption class="mt-3 text-[14px] text-mute">{w.caption}</figcaption>
  </figure>
</section>
