---
// The offer, right under the first screen: the free store check as one cobalt panel. What it gives, the terms, one
// button, and the first page of the real report template filled in for a made-up store (never a client's report);
// German pages show the German one, the others the English one.
import CalButton from '../components/CalButton.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const w = t.shopCheckWhat;
const c = t.hero.check;
const lang = locale === 'de' ? 'de' : 'en';
---

<section id="what-you-get" class="mx-auto mt-14 max-w-[1440px] scroll-mt-24 px-3 md:mt-20 md:px-6">
  <div class="on-blue grid items-center gap-10 rounded-[28px] bg-blue-deep px-5 py-10 text-white md:rounded-[36px] md:px-12 md:py-16 lg:grid-cols-[1fr_minmax(0,540px)] lg:gap-16">
    <div>
      <p class="text-[15px] font-semibold uppercase tracking-[0.08em] text-white/80">{t.contact.shopCheck.title}</p>
      <h2 data-split class="mt-3 max-w-[620px] font-head text-[34px] font-bold leading-[1.03] tracking-[-0.02em] md:text-[52px]">{w.title}</h2>
      <ol class="mt-8 grid gap-5 md:mt-10">
        {
          w.items.map((item, i) => (
            <li data-reveal class="grid grid-cols-[40px_1fr] gap-3 border-t border-white/25 pt-5">
              <span class="font-head text-[26px] font-bold leading-none [font-variant-numeric:tabular-nums]">{i + 1}</span>
              <div>
                <h3 class="font-head text-[21px] font-bold leading-tight md:text-[23px]">{item.title}</h3>
                <p class="mt-1.5 max-w-[520px] text-[16px] leading-relaxed text-white/85 md:text-[17px]">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="#shop-check" class="inline-flex items-center gap-3 rounded-full bg-white px-7 py-[17px] text-[17px] font-semibold text-blue-deep transition-colors hover:bg-ink hover:text-white">
          {c.button}<span aria-hidden="true">→</span>
        </a>
        <CalButton class="font-semibold text-white underline-offset-4 hover:underline">{c.orCall} <span aria-hidden="true">→</span></CalButton>
      </div>
      <p class="mt-5 max-w-[520px] text-[15px] leading-snug text-white/85">{w.terms}</p>
    </div>
    <figure data-reveal>
      <img
        src={`/source/shop-check/sample-${lang}-1240.webp`}
        srcset={`/source/shop-check/sample-${lang}-620.webp 620w, /source/shop-check/sample-${lang}-1240.webp 1240w`}
        sizes="(min-width: 1024px) 540px, calc(100vw - 64px)"
        width="1240"
        height="960"
        alt={w.alt}
        loading="lazy"
        decoding="async"
        class="block h-auto w-full rounded-[18px] shadow-[0_24px_60px_rgba(14,16,24,0.28)]"
      />
      <figcaption class="mt-3 text-[14px] text-white/80">{w.caption}</figcaption>
    </figure>
  </div>
</section>
