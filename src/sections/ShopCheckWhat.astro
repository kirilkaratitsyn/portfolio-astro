---
// The offer, right under the first screen: the free store check as one short cobalt panel. The heading, the button,
// three things the check gives and the terms. Kept short on purpose: no pictures, and on phones only the titles
// of the three points.
import CalButton from '../components/CalButton.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const w = t.shopCheckWhat;
const c = t.hero.check;
---

<section id="what-you-get" class="mx-auto mt-12 max-w-[1440px] scroll-mt-24 px-3 md:mt-16 md:px-6">
  <div class="on-blue rounded-[28px] bg-blue-deep px-5 py-7 text-white md:rounded-[32px] md:px-12 md:py-9">
    <div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-5">
      <h2 data-split class="font-head text-[28px] font-bold leading-[1.05] tracking-[-0.02em] md:text-[36px]">{w.title}</h2>
      <div class="hidden flex-wrap items-center gap-x-6 gap-y-3 md:flex">
        <a href="#shop-check" class="inline-flex items-center gap-3 rounded-full bg-white px-6 py-[14px] text-[16px] font-semibold text-blue-deep transition-colors hover:bg-ink hover:text-white">
          {c.button}<span aria-hidden="true">→</span>
        </a>
        <CalButton class="inline-flex items-center gap-1.5 font-semibold text-white underline-offset-4 hover:underline">{c.orCall} <span aria-hidden="true">→</span></CalButton>
      </div>
    </div>
    <ol class="mt-6 grid gap-x-8 md:mt-7 md:grid-cols-3">
      {
        w.items.map((item, i) => (
          <li data-reveal class="grid grid-cols-[30px_1fr] gap-2 border-t border-white/25 py-3 md:py-4">
            <span class="font-head text-[20px] font-bold leading-tight [font-variant-numeric:tabular-nums] md:text-[22px]">{i + 1}</span>
            <div>
              <h3 class="font-head text-[19px] font-bold leading-tight md:text-[20px]">{item.title}</h3>
              <p class="mt-1 hidden text-[15px] leading-snug text-white/85 md:block">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <!-- Phones: the button comes after the three points, so the panel reads heading, points, then the step to take. -->
    <div class="mt-6 flex flex-col items-start gap-4 md:hidden">
      <a href="#shop-check" class="inline-flex items-center gap-3 rounded-full bg-white px-6 py-[14px] text-[16px] font-semibold text-blue-deep">
        {c.button}<span aria-hidden="true">→</span>
      </a>
      <CalButton class="inline-flex items-center gap-1.5 font-semibold text-white underline-offset-4 hover:underline">{c.orCall} <span aria-hidden="true">→</span></CalButton>
    </div>
    <p class="mt-6 border-t border-white/25 pt-3.5 md:mt-0 text-[14px] leading-snug text-white/85 md:pt-4">{w.terms}</p>
  </div>
</section>
