---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<section id="faq" class="mx-auto mt-24 max-w-[1440px] scroll-mt-24 md:mt-32">
  <h2 data-split class="px-5 pb-6 font-head text-[40px] font-bold tracking-[-0.02em] md:px-10 md:pb-8 md:text-[56px]">{t.faq.title}</h2>
  <div class="border-b border-line">
    {
      t.faq.questions.map((faq) => (
        <details data-reveal class="group border-t border-line">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-5 py-6 text-lg font-medium md:px-10 md:text-[22px] [&::-webkit-details-marker]:hidden">
            {faq.question}
            <span class="shrink-0 text-[28px] leading-none text-mute transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="max-w-3xl px-5 pb-7 text-base leading-relaxed text-mute md:px-10 md:text-lg">{faq.answer}</p>
        </details>
      ))
    }
  </div>
</section>
