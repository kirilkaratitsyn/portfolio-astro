---
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import { useTranslations, type Locale } from '../i18n';
import type { WorkProject } from '../lib/content';

interface Props {
  locale: Locale;
  works: WorkProject[];
}

// Brands from the project catalog (works.yaml ids), each linking to its live store.
// Logos are the stores' own header logos, shown as black silhouettes; `height` (px on desktop)
// balances their different proportions so they read at a similar size.
const CLIENTS = [
  { id: 'juniors-cheesecake', logo: 'juniors-cheesecake.svg', height: 54 },
  { id: 'orska-rituals', logo: 'orska-rituals.webp', height: 56 },
  { id: 'lerros', logo: 'lerros.svg', height: 92 },
  { id: 'elanora-skin', logo: 'elanora-skin.webp', height: 48 },
  { id: 'jula-bloom', logo: 'jula-bloom.webp', height: 44 },
  { id: 'minbie', logo: 'minbie.webp', height: 62 },
  { id: 'petaljet', logo: 'petaljet.webp', height: 56 },
  { id: 'onlyphila', logo: 'onlyphila.webp', height: 72 },
];

const { locale, works } = Astro.props;
const t = useTranslations(locale);
// Each logo's own size goes on its <img>, so a logo that has not loaded yet (they are lazy) already takes its place:
// no jump when it arrives, and its link is never a zero-width stop for the keyboard.
// The smaller copies (scripts/make-client-logos.mjs) go in a srcset, with the width the logo takes in the strip: its
// height times its proportions, at most 96 px on phones and 290 px from md up (the classes on the <img> below).
const dir = path.join(process.cwd(), 'public/source/logos/clients');
const clients = await Promise.all(
  CLIENTS.map(async (client) => {
    const work = works.find((item) => item.id === client.id);
    if (!work) throw new Error(`ClientStrip: "${client.id}" is not in works.yaml`);
    const { width = 300, height = 100 } = await sharp(path.join(dir, client.logo)).metadata();
    const name = client.logo.replace(/\.webp$/, '');
    const copies = client.logo.endsWith('.webp') ? [200, 300].filter((w) => fs.existsSync(path.join(dir, `${name}-${w}.webp`))) : [];
    const srcset = copies.length ? [...copies.map((w) => `/source/logos/clients/${name}-${w}.webp ${w}w`), `/source/logos/clients/${client.logo} ${width}w`].join(', ') : undefined;
    const slot = (h: number, max: number) => Math.ceil(Math.min(max, (h * width) / height));
    const sizes = srcset ? `(min-width: 768px) ${slot(client.height, 290)}px, ${slot(client.height * 0.46, 96)}px` : undefined;
    return { ...client, title: work.title, url: work.url, width, size: height, srcset, sizes };
  }),
);
---

<section aria-labelledby="clients-label" class="mx-auto max-w-[1440px] px-5 py-16 md:px-10 md:py-36">
  <h2 id="clients-label" class="mb-8 font-sans text-base font-medium text-mute md:mb-16 md:text-lg">{t.clients.label}</h2>
  <ul class="grid grid-cols-3 gap-x-5 gap-y-7 md:grid-cols-4 md:gap-x-10 md:gap-y-20" data-stagger>
    {
      clients.map((client) => (
        <li class="flex h-[56px] items-center justify-center md:h-[110px]">
          <a href={client.url} target="_blank" rel="noopener noreferrer" class="block opacity-80 transition duration-300 hover:scale-105 hover:opacity-100" style={`--h: ${client.height}px`}>
            <img
              src={`/source/logos/clients/${client.logo}`}
              srcset={client.srcset}
              sizes={client.sizes}
              alt={client.title}
              width={client.width}
              height={client.size}
              class="h-[calc(var(--h)*0.46)] w-auto max-w-[96px] object-contain brightness-0 md:h-[var(--h)] md:max-w-[290px]"
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>
