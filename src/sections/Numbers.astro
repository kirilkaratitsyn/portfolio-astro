---
import Pebble from '../components/Pebble.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const pebbles = ['cobalt', 'white', 'black', 'cobalt2'] as const;
---

<section class="mt-24 border-y border-line md:mt-32">
  <dl class="mx-auto grid max-w-[1440px] grid-cols-2 md:grid-cols-4">
    {
      t.stats.items.map((item, index) => (
        <div class="relative border-line px-5 pb-8 pt-9 md:px-10 md:pb-9 [&:nth-child(odd)]:border-r md:[&:not(:last-child)]:border-r [&:nth-child(n+3)]:border-t md:[&:nth-child(n+3)]:border-t-0">
          <Pebble name={pebbles[index]} class="absolute right-4 top-5 w-10 md:right-6 md:top-6 md:w-[54px]" />
          <dd class="font-head text-[64px] font-bold leading-[0.9] tracking-[-0.04em] [font-variant-numeric:tabular-nums] md:text-[clamp(88px,9.4vw,136px)]">{item.value}</dd>
          <dt class="mt-4 max-w-[230px] text-[15px] text-mute md:mt-[18px] md:text-[17px]">{item.label}</dt>
        </div>
      ))
    }
  </dl>
</section>
