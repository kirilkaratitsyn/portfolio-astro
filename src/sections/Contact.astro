---
import { Image } from 'astro:assets';
import markWhite from '../assets/brand/mark-white.png';
import CalButton from '../components/CalButton.astro';
import Pebble from '../components/Pebble.astro';
import { useTranslations, type Locale } from '../i18n';
import { SHOP_CHECK_LINK, showShopCheck } from '../lib/cal';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<section id="contact" class="mx-auto mt-24 max-w-[1440px] scroll-mt-24 px-5 md:mt-32 md:px-10">
  <div data-contact class="on-blue relative overflow-hidden rounded-[28px] bg-blue px-6 pb-12 pt-[128px] text-white md:px-16 md:pb-16 md:pt-20">
    <h2 data-split class="relative z-[2] max-w-[900px] font-head text-[40px] font-bold leading-[0.98] tracking-[-0.025em] md:text-[84px]">{t.contact.subtitle}.</h2>
    <div class="relative z-[2] mt-10 flex flex-col items-start gap-5 text-lg md:mt-14 md:flex-row md:items-center md:gap-8 md:text-xl">
      <CalButton class="inline-flex rounded-full bg-white px-7 py-[17px] text-[17px] font-semibold text-blue">{t.header.bookCall}</CalButton>
      <a href="mailto:karatitsynkiril@gmail.com?subject=Shopify%20project%20inquiry" class="underline decoration-white/40 underline-offset-4 hover:decoration-white">{t.contact.email}</a>
    </div>
    {/* A second door for those not ready for a call: a short form on Cal.com, the answer comes by email. */}
    {
      showShopCheck && (
        <div class="relative z-[2] mt-10 max-w-[620px] border-t border-white/25 pt-8 md:mt-14 md:pt-10">
          <h3 class="font-head text-[24px] font-bold leading-tight md:text-[30px]">{t.contact.shopCheck.title}</h3>
          <p class="mt-3 text-[17px] leading-relaxed text-white/85 md:text-lg">{t.contact.shopCheck.text}</p>
          <CalButton link={SHOP_CHECK_LINK ?? 'forms/shop-check'} class="mt-6 inline-flex rounded-full border border-white/60 px-6 py-[13px] text-[16px] font-semibold text-white transition-colors hover:bg-white hover:text-blue">
            {t.contact.shopCheck.button}
          </CalButton>
        </div>
      )
    }
    <!-- The logo in white, as a live 3D object: drag it to turn it on any axis. On phones it sits above the heading. -->
    <span data-pebble="logo-white" data-grab class="pebble absolute right-3 top-3 z-[1] block size-[104px] md:right-[15%] md:top-5 md:size-[310px]">
      <Image src={markWhite} alt="" width={310} height={351} class="size-full object-contain" loading="lazy" />
    </span>
    <Pebble name="white" class="pointer-events-none absolute -bottom-9 -right-7 w-[104px] md:-bottom-[70px] md:-right-10 md:w-[270px]" />
    <Pebble name="black" class="pointer-events-none absolute -top-8 right-[120px] w-[84px] md:-right-5 md:-top-[60px] md:w-[170px]" />
  </div>
</section>
