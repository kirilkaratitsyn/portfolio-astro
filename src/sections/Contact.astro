---
import CalButton from '../components/CalButton.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<section id="contact">
  <div class="contact__container rounded-t-[50px] bg-white pt-20 text-black">
    <div class="mx-auto max-w-3xl px-6 py-8 text-left md:px-10 md:py-10 md:text-center">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-black/45">{t.contact.title}</p>
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-black/10 bg-black/5 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-black/70">
        <img src="/source/ui/upwork-top-rated.svg" alt="" class="h-5 w-5 shrink-0" aria-hidden="true" />
        <span>{t.contact.topRated}</span>
      </div>
      <h2 class="primary-gradient primary-shadow mx-auto max-w-2xl text-[28px] font-semibold leading-tight md:text-[42px]">
        {t.contact.subtitle}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-black/60 md:text-base">{t.contact.note}</p>

      <a
        href="mailto:karatitsynkiril@gmail.com?subject=Shopify%20project%20inquiry"
        class="mt-6 inline-flex items-center text-base font-medium text-black underline decoration-black/20 underline-offset-4 transition hover:text-black/70 md:text-lg"
      >
        {t.contact.email}
      </a>

      <div class="mt-8 flex justify-start md:justify-center" data-aos="fade-up">
        <CalButton class="transition-all duration-500 whitespace-nowrap  font-medium  mt-10 bg-black text-white black-shadow hover:bg-opacity-80 transition-all duration-300 px-12 py-3 text-lg rounded-full">
          <span>{t.contact.book_call}</span>
        </CalButton>
      </div>
    </div>
  </div>
</section>
