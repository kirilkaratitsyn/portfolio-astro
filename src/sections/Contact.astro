---
import { Image } from 'astro:assets';
import markWhite from '../assets/brand/mark-white.png';
import CalButton from '../components/CalButton.astro';
import Pebble from '../components/Pebble.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const f = t.contact.form;
const privacyHref = locale === 'de' ? '/de/datenschutz' : '/privacy';
const input = 'mt-2 block w-full rounded-xl border-0 bg-white px-4 py-3 text-[16px] text-ink placeholder:text-[#8a8fa3] focus:outline-none focus:ring-2 focus:ring-white/70';
---

<section id="contact" class="mx-auto mt-24 max-w-[1440px] scroll-mt-24 px-5 md:mt-32 md:px-10">
  <div data-contact class="on-blue relative overflow-hidden rounded-[28px] bg-blue px-6 pb-12 pt-[128px] text-white md:px-16 md:pb-16 md:pt-20">
    <h2 data-split class="relative z-[2] max-w-[900px] font-head text-[40px] font-bold leading-[0.98] tracking-[-0.025em] md:text-[84px]">{t.contact.subtitle}.</h2>
    <div class="relative z-[2] mt-10 flex flex-col items-start gap-5 text-lg md:mt-14 md:flex-row md:items-center md:gap-8 md:text-xl">
      <CalButton class="inline-flex rounded-full bg-white px-7 py-[17px] text-[17px] font-semibold text-blue">{t.header.bookCall}</CalButton>
      <a href={`mailto:${t.contact.email}?subject=Shopify%20project%20inquiry`} class="underline decoration-white/40 underline-offset-4 hover:decoration-white">{t.contact.email}</a>
    </div>
    <!-- A second door for those not ready for a call: the store check or a project enquiry, sent to Kiril by email
         through api/contact.js. Works without scripts too (a plain post and a thank-you page). -->
    <div class="relative z-[2] mt-10 max-w-[720px] border-t border-white/25 pt-8 md:mt-14 md:pt-10">
      <h3 class="font-head text-[24px] font-bold leading-tight md:text-[30px]">{t.contact.shopCheck.title}</h3>
      <p class="mt-3 text-[17px] leading-relaxed text-white/85 md:text-lg">{t.contact.shopCheck.text}</p>
      <form data-contact-form action="/api/contact" method="post" class="mt-7 grid gap-5 md:grid-cols-2">
        <fieldset class="flex flex-wrap gap-2 md:col-span-2">
          <legend class="sr-only">{f.check} / {f.project}</legend>
          <label class="cf-topic"><input type="radio" name="topic" value="check" checked class="sr-only" /><span>{f.check}</span></label>
          <label class="cf-topic"><input type="radio" name="topic" value="project" class="sr-only" /><span>{f.project}</span></label>
        </fieldset>
        <label class="text-[15px] font-medium">{f.email}<input type="email" name="email" required autocomplete="email" class={input} /></label>
        <label class="text-[15px] font-medium">{f.shop}<input type="text" name="shop" inputmode="url" autocomplete="url" placeholder="https://" class={input} /></label>
        <label class="text-[15px] font-medium md:col-span-2">{f.message}<textarea name="message" rows="4" placeholder={f.messageHint} class={`${input} resize-y`}></textarea></label>
        <label class="text-[15px] font-medium">{f.name}<input type="text" name="name" autocomplete="name" class={input} /></label>
        <label class="text-[15px] font-medium">{f.source}
          <select name="source" class={input}>
            <option value="">{f.sourcePick}</option>
            {f.sources.map((item) => <option value={item}>{item}</option>)}
          </select>
        </label>
        <!-- Only bots fill this in. -->
        <label class="cf-trap" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        <input type="hidden" name="lang" value={locale} />
        <input type="hidden" name="page" value="" />
        <input type="hidden" name="utm" value="" />
        <div class="flex flex-col items-start gap-4 md:col-span-2 md:flex-row md:items-center md:gap-6">
          <button type="submit" data-label={f.send} data-sending={f.sending} class="inline-flex rounded-full bg-white px-7 py-[15px] text-[16px] font-semibold text-blue transition-opacity disabled:opacity-60">{f.send}</button>
          <p class="text-[14px] leading-snug text-white/75">{f.privacy} <a href={privacyHref} class="underline underline-offset-2 hover:text-white">{f.privacyLink}</a>.</p>
        </div>
        <p data-form-status role="status" aria-live="polite" class="text-[17px] font-medium md:col-span-2" hidden></p>
        <p data-form-sent hidden>{f.sent}</p>
        <p data-form-failed hidden>{f.failed}</p>
      </form>
    </div>
    <!-- The logo in white, as a live 3D object: drag it to turn it on any axis. On phones it sits above the heading. -->
    <div class="absolute right-3 top-3 z-[1] grid size-[116px] place-items-center rounded-full bg-ink md:right-[calc(15%-15px)] md:top-1 md:size-[340px]">
      <span data-pebble="logo-white" data-grab class="pebble relative block size-[90%]">
        <Image src={markWhite} alt="" width={310} height={351} class="size-full object-contain" loading="lazy" />
      </span>
    </div>
    <!-- Two blocks of the hero cube drop in (scripts/motion.ts). From 768px they land as a small pile in the corner, the
         black one on the white one; on phones the black one stays up by the logo, clear of the form. -->
    <Pebble name="white" class="pointer-events-none absolute -bottom-9 -right-7 w-[104px] md:-bottom-[70px] md:-right-10 md:w-[270px]" />
    <Pebble name="black" class="pointer-events-none absolute -top-8 right-[120px] w-[84px] md:bottom-[90px] md:right-[30px] md:top-auto md:w-[170px]" />
  </div>
</section>

<script>
  // Sends the form without leaving the page, and says how it went. The page and the utm_* of its address go along,
  // so the email shows where the visitor came from.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const say = (selector: string) => {
      status.textContent = form.querySelector(selector)!.textContent;
      status.hidden = false;
    };
    const hidden = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]`)!;
    hidden('page').value = location.pathname;
    hidden('utm').value = new URLSearchParams([...new URLSearchParams(location.search)].filter(([key]) => key.startsWith('utm_'))).toString();
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      button.textContent = button.dataset.sending!;
      status.hidden = true;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { accept: 'application/json', 'content-type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        say('[data-form-sent]');
      } catch {
        say('[data-form-failed]');
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.label!;
      }
    });
  }
</script>
