---
import { Image } from 'astro:assets';
import markBlack from '../assets/brand/mark-black.png';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<footer id="footer">
  <div class="mx-auto max-w-[1440px] px-5 md:px-10">
    <div class="relative flex flex-col items-center gap-3 pb-6 pt-10 text-[15px] text-mute md:min-h-[214px] md:flex-row md:items-end md:justify-between md:pb-4 md:pt-16">
      <!-- The logo as a live 3D object: drag it to turn it on any axis. -->
      <span data-pebble="logo" data-grab class="pebble relative block size-[120px] md:absolute md:left-1/2 md:top-4 md:size-[168px] md:-translate-x-1/2">
        <Image src={markBlack} alt="" width={132} height={150} class="size-full object-contain" loading="lazy" />
      </span>
      <span>© {new Date().getFullYear()} Kiril Karatitsyn. {t.footer.rights}</span>
      <span class="flex gap-5">
        <a href="https://github.com/kirilkaratitsyn" target="_blank" rel="noopener noreferrer" class="hover:text-ink">{t.contact.github}</a>
        <a href="https://www.linkedin.com/in/kiril-karatitsyn-bb278b332/" target="_blank" rel="noopener noreferrer" class="hover:text-ink">{t.contact.linkedin}</a>
      </span>
    </div>
    <div class="wm-wrap pb-7 [clip-path:inset(-80px_0_0_0)]" aria-hidden="true">
      <span class="wm" data-footer-wm>Karatitsyn</span>
    </div>
  </div>
</footer>
