---
import { localizePath, useTranslations, type Locale } from '../i18n';
import { CLARITY_ID } from '../lib/analytics';
import { getLocalPages, getPosts, getServices } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const hasPosts = (await getPosts(locale)).length > 0;
// The services row is the same in every language too: a service written in German only keeps its German link and title.
const ownServices = await getServices(locale);
const services = [...ownServices, ...(await getServices('de')).filter((de) => !ownServices.some((own) => own.slug === de.slug))].sort((a, b) => a.order - b.order);
const ownService = new Set(ownServices.map((service) => service.slug));
// Every service and town page gets a link from every page (Google finds and weighs them through it), kept short:
// the services by name, the town pages as rows of town names under their kind.
// The rows are the same in every language: a town page written in German only is linked in German (hreflang="de").
const ownLocal = new Set((await getLocalPages(locale)).map((page) => page.slug));
const localPages = await getLocalPages('de');
const townHref = (slug: string) => (ownLocal.has(slug) ? localizePath(locale, `/services/${slug}`) : localizePath('de', `/services/${slug}`));
const towns = [
  { label: t.footer.localShopify, pages: localPages.filter((page) => page.slug.startsWith('shopify-')) },
  { label: t.footer.localWeb, pages: localPages.filter((page) => page.slug.startsWith('webdesign-')) },
]
  .map((row) => ({ ...row, pages: [...row.pages].sort((a, b) => Number(b.slug.endsWith('bad-bentheim')) - Number(a.slug.endsWith('bad-bentheim'))) }))
  .filter((row) => row.pages.length > 0);
// German pages link the German Impressum and Datenschutzerklärung; English and Ukrainian pages the English versions.
const legal =
  locale === 'de'
    ? [
        { name: t.footer.legal, href: '/de/impressum' },
        { name: t.footer.privacy, href: '/de/datenschutz' },
      ]
    : [
        { name: t.footer.legal, href: '/legal-notice' },
        { name: t.footer.privacy, href: '/privacy' },
      ];
---

<!-- Clipped below: the wordmark letters rise from under the edge and must not make the page longer while they do. -->
<footer id="footer" class="overflow-y-clip">
  <div class="mx-auto max-w-[1440px] px-5 md:px-10">
    <!-- Above the wordmark: its letters reach up into this row (and rise further under the cursor), and would catch the clicks. -->
    <div class="relative z-[1] pt-14 md:pt-16">
      {
        services.length > 0 && (
          <div class="grid gap-2 border-b border-line pb-5 text-[15px]">
            <nav aria-label={t.header.services} class="flex flex-wrap gap-x-5 gap-y-2">
              <a href={localizePath(locale, '/services')} class="font-semibold text-ink hover:text-blue-deep">{t.header.services}</a>
              {services.map((service) => (
                <a href={localizePath(ownService.has(service.slug) ? locale : 'de', `/services/${service.slug}`)} hreflang={ownService.has(service.slug) ? undefined : 'de'} class="text-mute hover:text-ink">
                  {service.title}
                </a>
              ))}
            </nav>
            {towns.map((row) => (
              <nav aria-label={row.label} class="flex flex-wrap gap-x-4 gap-y-1">
                <span class="font-semibold text-ink">{row.label}</span>
                {row.pages.map((page) => (
                  <a href={townHref(page.slug)} hreflang={ownLocal.has(page.slug) ? undefined : 'de'} class="text-mute hover:text-ink">
                    {page.area!.place.replace(/^das /, '').replace(/\s*\(.*\)$/, '')}
                  </a>
                ))}
              </nav>
            ))}
          </div>
        )
      }
    </div>
    <div class="relative z-[1] flex flex-col gap-3 pb-6 pt-5 text-[15px] text-mute md:flex-row md:justify-between md:pb-4 md:pt-5">
      <span>© {new Date().getFullYear()} Kiril Karatitsyn. {t.footer.rights}</span>
      <span class="flex flex-wrap gap-x-5 gap-y-2">
        <span class="flex gap-2">
          <a href={legal[0]!.href} class="hover:text-ink">{legal[0]!.name}</a>
          <span aria-hidden="true">·</span>
          <a href={legal[1]!.href} class="hover:text-ink">{legal[1]!.name}</a>
        </span>
        {CLARITY_ID && <button type="button" data-consent-open class="hover:text-ink">{t.consent.settings}</button>}
        <a href={localizePath(locale, '/about')} class="hover:text-ink">{t.header.about}</a>
        {hasPosts && <a href={localizePath(locale, '/blog')} class="hover:text-ink">{t.header.blog}</a>}
        <a href="https://github.com/kirilkaratitsyn" target="_blank" rel="noopener noreferrer" class="hover:text-ink">{t.contact.github}</a>
        <a href="https://www.linkedin.com/in/kirilkaratitsyn/" target="_blank" rel="noopener noreferrer" class="hover:text-ink">{t.contact.linkedin}</a>
      </span>
    </div>
    <div class="wm-wrap pb-7 [clip-path:inset(-80px_0_0_0)]" aria-hidden="true">
      <span class="wm" data-footer-wm>Karatitsyn</span>
    </div>
  </div>
</footer>
