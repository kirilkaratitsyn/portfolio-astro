---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<footer id="footer">
  <div class="mx-auto max-w-[1440px] px-5 md:px-10">
    <div class="flex flex-col gap-3 pb-6 pt-14 text-[15px] text-mute md:flex-row md:justify-between md:pb-4 md:pt-16">
      <span>© {new Date().getFullYear()} Kiril Karatitsyn. {t.footer.rights}</span>
      <span class="flex gap-5">
        <a href="https://github.com/kirilkaratitsyn" target="_blank" rel="noopener noreferrer" class="hover:text-ink">{t.contact.github}</a>
        <a href="https://www.linkedin.com/in/kiril-karatitsyn-bb278b332/" target="_blank" rel="noopener noreferrer" class="hover:text-ink">{t.contact.linkedin}</a>
      </span>
    </div>
    <div class="wm-wrap pb-7 [clip-path:inset(-80px_0_0_0)]" aria-hidden="true">
      <span class="wm" data-footer-wm>Karatitsyn</span>
    </div>
  </div>
</footer>
