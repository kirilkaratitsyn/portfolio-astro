---
import { localizePath, useTranslations, type Locale } from '../i18n';
import { getLocalPages, getPosts, getServices } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const hasPosts = (await getPosts(locale)).length > 0;
const services = await getServices(locale);
const localPages = await getLocalPages(locale);
// German pages link the German Impressum and Datenschutzerklärung; English and Ukrainian pages the English versions.
const legal =
  locale === 'de'
    ? [
        { name: t.footer.legal, href: '/de/impressum' },
        { name: t.footer.privacy, href: '/de/datenschutz' },
      ]
    : [
        { name: t.footer.legal, href: '/legal-notice' },
        { name: t.footer.privacy, href: '/privacy' },
      ];
---

<!-- Clipped below: the wordmark letters rise from under the edge and must not make the page longer while they do. -->
<footer id="footer" class="overflow-y-clip">
  <div class="mx-auto max-w-[1440px] px-5 md:px-10">
    <!-- Above the wordmark: its letters reach up into this row (and rise further under the cursor), and would catch the clicks. -->
    <div class="relative z-[1] pt-14 md:pt-16">
      {
        services.length > 0 && (
          <nav aria-label={t.header.services} class="flex flex-wrap gap-x-5 gap-y-2 border-b border-line pb-5 text-[15px]">
            <a href={localizePath(locale, '/services')} class="font-semibold text-ink hover:text-blue">{t.header.services}</a>
            {[...services, ...localPages].map((service) => (
              <a href={localizePath(locale, `/services/${service.slug}`)} class="text-mute hover:text-ink">
                {service.title}
              </a>
            ))}
          </nav>
        )
      }
    </div>
    <div class="relative z-[1] flex flex-col gap-3 pb-6 pt-5 text-[15px] text-mute md:flex-row md:justify-between md:pb-4 md:pt-5">
      <span>© {new Date().getFullYear()} Kiril Karatitsyn. {t.footer.rights}</span>
      <span class="flex flex-wrap gap-x-5 gap-y-2">
        <span class="flex gap-2">
          <a href={legal[0]!.href} class="hover:text-ink">{legal[0]!.name}</a>
          <span aria-hidden="true">·</span>
          <a href={legal[1]!.href} class="hover:text-ink">{legal[1]!.name}</a>
        </span>
        {hasPosts && <a href={localizePath(locale, '/blog')} class="hover:text-ink">{t.header.blog}</a>}
        <a href="https://github.com/kirilkaratitsyn" target="_blank" rel="noopener noreferrer" class="hover:text-ink">{t.contact.github}</a>
        <a href="https://www.linkedin.com/in/kiril-karatitsyn-bb278b332/" target="_blank" rel="noopener noreferrer" class="hover:text-ink">{t.contact.linkedin}</a>
      </span>
    </div>
    <div class="wm-wrap pb-7 [clip-path:inset(-80px_0_0_0)]" aria-hidden="true">
      <span class="wm" data-footer-wm>Karatitsyn</span>
    </div>
  </div>
</footer>
