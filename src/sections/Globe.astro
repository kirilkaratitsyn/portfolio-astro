---
// Worldwide: where the client stores are, on a live 3D globe (scripts/stage.ts GlobeView, src/lib/globe.ts). The
// country list is the content; the globe and its poster are decoration on top of it. Countries come from each
// store's own Shopify /meta.json (works.yaml: country, city, lat, lng); closed stores are left out. The stores' own
// logos (scripts/make-store-logos.mjs) stand in for their names in the tooltips; flags: scripts/make-flags.mjs.
import fs from 'node:fs';
import path from 'node:path';
import { useTranslations, type Locale } from '../i18n';
import type { WorkProject } from '../lib/content';

interface Props {
  locale: Locale;
  works: WorkProject[];
}

const { locale, works } = Astro.props;
const t = useTranslations(locale).globe;
const names = new Intl.DisplayNames([locale], { type: 'region' });
const placed = works.filter((w) => !w.archived && w.country && w.lat !== undefined && w.lng !== undefined);
// Checked against public/ in the project (the build runs from its root), not next to this file once bundled.
const logo = (id: string) => (fs.existsSync(path.join(process.cwd(), 'public/source/store-logos', `${id}.webp`)) ? `/source/store-logos/${id}.webp` : undefined);
const markers = placed.map((w) => ({ t: w.title, c: w.city ?? '', n: names.of(w.country!) ?? w.country!, k: w.country!, u: w.url, la: w.lat!, lo: w.lng!, l: logo(w.id) }));
const counts = new Map<string, number>();
for (const w of placed) counts.set(w.country!, (counts.get(w.country!) ?? 0) + 1);
const countries = [...counts.entries()]
  .map(([code, count]) => ({ code, name: names.of(code) ?? code, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, locale));
const [before, after] = t.title.split('{n}');
---

<section id="worldwide" aria-labelledby="worldwide-title" class="mx-auto mt-24 max-w-[1440px] px-5 md:mt-36 md:px-10">
  <div class="grid items-center gap-10 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-5">
      <p data-reveal class="text-sm font-semibold uppercase tracking-[0.16em] text-blue">{t.eyebrow}</p>
      <h2 id="worldwide-title" data-split class="mt-4 font-head text-[44px] font-bold leading-[1] tracking-[-0.03em] md:text-[76px]">
        {before}<span class="text-blue">{countries.length}</span>{after}
      </h2>
      <p data-reveal class="mt-6 max-w-[480px] text-[18px] leading-relaxed text-mute">{t.lead}</p>
      <ul data-stagger class="mt-8 flex max-w-[560px] flex-wrap gap-2" aria-label={t.listLabel}>
        {
          countries.map((c) => (
            <li>
              <button type="button" data-globe-country={c.code} aria-pressed="false" class="globe-pill">
                <img src={`/source/flags/${c.code.toLowerCase()}.webp`} alt="" width="20" height="20" loading="lazy" decoding="async" class="globe-flag" />
                {c.name}
                <span class="ml-1 opacity-55">{c.count}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-7">
      <div class="relative mx-auto w-full max-w-[720px]">
        <div
          data-globe
          data-markers={JSON.stringify(markers)}
          data-open={t.open}
          data-home={t.home}
          class="globe relative aspect-square w-full"
          aria-hidden="true"
        >
          <img src="/source/3d/globe-1000.webp" srcset="/source/3d/globe-640.webp 640w, /source/3d/globe-1000.webp 1000w" sizes="(min-width: 768px) 720px, 92vw" width="1000" height="1000" alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full" />
        </div>
        <!-- Shown once the live globe is on (scripts/stage.ts GlobeView); the poster has nothing to zoom. -->
        <div data-globe-zoom hidden class="globe-zoom">
          <button type="button" data-zoom="in" aria-label={t.zoomIn}>+</button>
          <button type="button" data-zoom="out" aria-label={t.zoomOut} aria-disabled="true">−</button>
        </div>
      </div>
      <p class="mt-3 text-center text-[13px] text-mute">{t.hint}</p>
    </div>
  </div>
</section>

<script>
  // A country pill shows only that country's stores on the globe (scripts/stage.ts GlobeView reads data-country and
  // listens for globe:country, also when it is built later); pressing it again shows every store.
  const host = document.querySelector<HTMLElement>('[data-globe]');
  const pills = [...document.querySelectorAll<HTMLButtonElement>('[data-globe-country]')];
  for (const pill of pills) {
    pill.addEventListener('click', () => {
      const code = pill.getAttribute('aria-pressed') === 'true' ? '' : (pill.dataset.globeCountry ?? '');
      for (const other of pills) other.setAttribute('aria-pressed', String(other.dataset.globeCountry === code));
      if (!host) return;
      host.dataset.country = code;
      host.dispatchEvent(new CustomEvent('globe:country', { detail: code }));
    });
  }
</script>
