---
// How I work: the six steps of a project, from the kick-off call to analytics and launch, as a deck of cards. On
// desktop the drawn cards lie in a deck that spreads out while the section scrolls past (a tall wrapper with
// a sticky stage, driven by scripts/motion.ts anatomy(); no pin), and the list highlights the step in focus; a step in
// the list or a layer of the stack, clicked, scrolls to it. Phones get a plain list of cards. Without scripts the stack
// is shown open and every item is expanded.
import AnatomyLayer from '../components/AnatomyLayer.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale).anatomy;
const kinds = ['call', 'brief', 'build', 'qa', 'seo', 'analytics'] as const;
const layers = t.layers.map((layer, i) => ({ ...layer, kind: kinds[i]! }));
---

<section id="anatomy" aria-labelledby="anatomy-title" class="mt-24 md:mt-36">
  <div data-anatomy class="anat relative">
    <div class="anat-sticky">
      <div class="mx-auto grid h-full max-w-[1440px] items-center gap-12 px-5 md:grid-cols-12 md:gap-8 md:px-10">
        <div class="md:col-span-5">
          <h2 id="anatomy-title" data-split class="font-head text-[40px] font-bold leading-[1] tracking-[-0.03em] md:text-[64px]">{t.title}</h2>
          <p data-reveal class="mt-5 max-w-[500px] text-[17px] leading-relaxed text-mute">{t.lead}</p>

          <ol class="mt-8 hidden border-t border-line md:block">
            {
              layers.map((layer, i) => (
                <li data-anatomy-item class="anat-item border-b border-line py-4">
                  <button type="button" data-anatomy-go class="anat-go flex w-full items-baseline gap-4 text-left font-head text-[20px] font-bold tracking-[-0.01em]">
                    <span class="anat-num w-7 text-[14px] text-mute [font-variant-numeric:tabular-nums]">0{i + 1}</span>
                    {layer.title}
                  </button>
                  <div class="anat-detail pl-11">
                    <div>
                      <p class="pt-2 text-[15px] leading-relaxed text-mute">{layer.text}</p>
                      <p class="flex flex-wrap gap-1.5 pt-3">
                        {layer.tags.map((tag) => (
                          <span class="rounded-full bg-white px-3 py-1 text-[12px] font-semibold">{tag}</span>
                        ))}
                      </p>
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="relative hidden h-full md:col-span-7 md:block" aria-hidden="true">
          <div class="anat-scene">
            <div data-anatomy-stack class="anat-stack">
              {
                layers.map((layer, i) => (
                  <div data-layer class="anat-layer" style={`--i:${i}`}>
                    <span class="anat-badge">0{i + 1}</span>
                    <AnatomyLayer kind={layer.kind} />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ol class="mx-auto mt-10 grid max-w-[1440px] gap-4 px-5 md:hidden">
    {
      layers.map((layer, i) => (
        <li data-reveal class="min-w-0 rounded-[24px] bg-white p-4">
          <div class="aspect-[4/3]">
            <AnatomyLayer kind={layer.kind} />
          </div>
          <p class="mt-4 flex items-baseline gap-3 font-head text-[20px] font-bold">
            <span class="text-[14px] text-blue">0{i + 1}</span>
            {layer.title}
          </p>
          <p class="mt-2 text-[15px] leading-relaxed text-mute">{layer.text}</p>
          <p class="flex flex-wrap gap-1.5 pt-3">
            {layer.tags.map((tag) => (
              <span class="rounded-full bg-bg px-3 py-1 text-[12px] font-semibold">{tag}</span>
            ))}
          </p>
        </li>
      ))
    }
  </ol>
</section>
