---
// First screen of the home page, kept light: who I am and why to trust me. A small real photo with the Upwork record,
// the heading, one line of facts and one button. The offer itself, the free store check, is the next section
// (ShopCheckWhat), so the two thoughts do not crowd each other.
import CalButton from '../components/CalButton.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const c = t.hero.check;
const PROFILE = 'https://www.upwork.com/freelancers/~0165dda3529105e6f3';
// Words ride up one by one on load (CSS only, see global.css); the heading text itself is unchanged.
const words = t.hero.claim.split(' ');
---

<section data-hero class="relative lg:pb-16">
  <div class="relative z-[2] mx-auto max-w-[1440px] px-5 pt-28 md:px-10 md:pt-32">
    <!-- PREVIEW ONLY: the big surname is shown with ?hero=wm and taken out otherwise, to compare the two. The surname
         is decoration; the h1 below carries the page's meaning. -->
    <div data-hero-word class="wm-wrap hero-wm mb-8 lg:mb-2" aria-hidden="true"><span class="wm" data-hero-wm>Karatitsyn</span></div>
    <script is:inline>
      if (new URLSearchParams(location.search).get('hero') !== 'wm') {
        document.querySelector('[data-hero-word]').remove();
        document.documentElement.removeAttribute('data-fly-logo');
      }
    </script>

    <!-- Phones and tablets: the words, then the cube under them. From 1024px: the cube to the right. -->
    <div class="lg:grid lg:grid-cols-[minmax(0,600px)_minmax(0,1fr)] lg:items-center lg:gap-10">
      <div class="relative z-[4]">
        <div class="hero-sub flex items-center gap-3.5">
          <img
            src="/source/kiril/avatar-192.webp"
            srcset="/source/kiril/avatar-96.webp 96w, /source/kiril/avatar-192.webp 192w, /source/kiril/avatar-288.webp 288w"
            sizes="(min-width: 768px) 84px, 68px"
            width="192"
            height="192"
            alt={c.photoAlt}
            decoding="async"
            class="size-[68px] shrink-0 rounded-[20px] bg-[#2a4467] object-cover md:size-[84px] md:rounded-[24px]"
          />
          <div class="leading-snug">
            <p class="font-head text-[17px] font-bold md:text-[19px]">{c.caption}</p>
            <a href={PROFILE} target="_blank" rel="noopener noreferrer" title={t.reviews.openProfile} class="mt-1 flex items-start gap-1.5 text-[14px] font-medium text-mute hover:text-ink md:text-[16px]">
              <img src="/source/logos/upwork-top-rated.svg" alt="" width="20" height="20" class="mt-px size-5 shrink-0" />
              <span>{c.trust}</span>
            </a>
          </div>
        </div>
        <h1 class="mt-6 max-w-[600px] font-head text-[36px] font-bold leading-[1.05] tracking-[-0.025em] md:mt-7 md:text-[54px]">
          {words.map((word, i) => (<><span class="hw"><span class="hw-i" style={`--i:${i}`}>{word}</span></span>{i < words.length - 1 ? ' ' : ''}</>))}
        </h1>
        <p class="hero-sub mt-5 max-w-[560px] text-[18px] leading-snug text-mute md:text-[20px]">{c.facts}</p>
        <div class="hero-cta mt-7 md:mt-8">
          <a href="#shop-check" class="inline-flex items-center gap-3 rounded-full bg-blue-deep px-7 py-[17px] text-[17px] font-semibold text-white transition-colors hover:bg-ink">
            {c.button}<span aria-hidden="true">→</span>
          </a>
          {
            // The small print and the call link come with the rewritten English text. German and Ukrainian keep the
            // earlier first screen until their own texts are written, so their note is empty.
            c.note && (
              <>
                <p class="mt-4 max-w-[460px] text-[15px] leading-snug text-mute">{c.note}</p>
                <CalButton class="mt-3 inline-flex items-center gap-1.5 text-[16px] font-semibold text-blue-dark underline-offset-4 hover:underline">{c.orCall} <span aria-hidden="true">→</span></CalButton>
              </>
            )
          }
        </div>
      </div>
      <!-- The puzzle cube (src/lib/cube.ts): the poster is the first paint and the fallback, scripts/stage.ts swaps in
           the live cube that turns, twists its layers and can be dragged. -->
      <span data-pebble="cube" class="pebble relative z-[3] mx-auto mb-4 mt-10 block w-[min(420px,88vw)] md:mb-10 lg:m-0 lg:ml-auto lg:w-[min(540px,100%)] xl:mr-[4%]">
        <img
          src="/source/3d/cube-1120.webp"
          srcset="/source/3d/cube-560.webp 560w, /source/3d/cube-640.webp 640w, /source/3d/cube-840.webp 840w, /source/3d/cube-1120.webp 1120w"
          sizes="(min-width: 1024px) min(540px, calc(100vw - 680px)), min(420px, 88vw)"
          width="1120"
          height="1120"
          alt=""
          fetchpriority="high"
          decoding="async"
          draggable="false"
          class="block h-auto w-full"
        />
      </span>
    </div>
  </div>
</section>
