---
import { localizePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const all = useTranslations(locale);
const t = all.reviews;
const PROFILE = 'https://www.upwork.com/freelancers/~0165dda3529105e6f3';

// The quotes are the clients' own words from Upwork, shown in the original English in every language.
// Cards alternate cobalt, paper, ink and mist like the project cards; the key phrase of each is marked.
const tones = [
  { box: 'bg-blue text-white', mark: 'rgba(255,255,255,0.3)', meta: 'text-white/75', link: 'bg-white text-blue hover:bg-ink hover:text-white' },
  { box: 'bg-white text-ink', mark: 'rgba(36,51,240,0.16)', meta: 'text-mute', link: 'bg-ink text-white hover:bg-blue' },
  { box: 'bg-ink text-white', mark: 'rgba(36,51,240,0.75)', meta: 'text-white/70', link: 'bg-white text-ink hover:bg-blue hover:text-white' },
  { box: 'bg-[#dfe2f0] text-ink', mark: 'rgba(36,51,240,0.18)', meta: 'text-mute', link: 'bg-ink text-white hover:bg-blue' },
] as const;
// Each card can link to the store the review is about (the client's live site), or to the case study when the
// store has closed (a url starting with /).
const linkOf = (url?: string) =>
  !url
    ? null
    : url.startsWith('/')
      ? { href: localizePath(locale, url), label: `${all.caseStudies.viewCase} →`, external: false }
      : { href: url, label: `${new URL(url).hostname.replace(/^www\./, '')} ↗`, external: true };
const cards = t.cards.map((card, i) => {
  const at = card.quote.indexOf(card.highlight);
  return {
    ...card,
    link: linkOf((card as { url?: string }).url),
    // A long quote gets a wider card and smaller type so it fits the card's height (global.css .review-card--long).
    long: card.quote.length > 300,
    tone: tones[i % tones.length]!,
    before: at < 0 ? card.quote : card.quote.slice(0, at),
    marked: at < 0 ? '' : card.highlight,
    after: at < 0 ? '' : card.quote.slice(at + card.highlight.length),
  };
});
---

<section class="mt-24 md:mt-32" aria-labelledby="reviews-title">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-8 px-5 md:flex-row md:items-end md:justify-between md:px-10">
    <div>
      <h2 id="reviews-title" data-split class="font-head text-[40px] font-bold tracking-[-0.02em] md:text-[56px]">{t.title}</h2>
      <p data-reveal class="mt-3 max-w-[640px] text-base leading-snug text-mute">{t.lead}</p>
    </div>
    <a
      data-reveal
      href={PROFILE}
      target="_blank"
      rel="noopener noreferrer"
      title={t.openProfile}
      class="group flex w-fit items-center gap-4 rounded-full bg-white py-3 pl-4 pr-3 transition-colors duration-300 hover:bg-ink hover:text-white md:gap-5"
    >
      <img src="/source/logos/upwork-top-rated.svg" alt="" width="56" height="56" class="size-12 shrink-0 transition-transform duration-500 group-hover:rotate-[8deg] group-hover:scale-110 md:size-14" />
      <span class="leading-snug">
        <span class="block font-head text-xl font-bold tracking-[-0.01em] md:text-2xl">{t.badge}</span>
        <span class="block text-sm text-mute group-hover:text-white/80">{t.summary}</span>
      </span>
      <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-blue text-xl text-white" aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="relative mt-10 md:mt-8">
    <ul
      data-rail
      tabindex="0"
      aria-label={t.title}
      class="reviews-rail flex cursor-grab snap-x snap-mandatory gap-5 md:snap-none scroll-pl-5 overflow-x-auto scroll-smooth pb-8 pl-5 pr-5 md:gap-6 md:scroll-pl-[max(2.5rem,calc((100vw-1440px)/2+2.5rem))] md:pb-3 md:pl-[max(2.5rem,calc((100vw-1440px)/2+2.5rem))] md:pr-10"
    >
      {
        cards.map((card) => (
          <li class:list={['review-card w-[84vw] shrink-0 snap-start sm:w-[440px] md:h-[clamp(400px,calc(100vh_-_400px),540px)]', card.long ? 'review-card--long lg:w-[720px]' : 'lg:w-[500px]']} style={`--hl:${card.tone.mark}`}>
            <figure class={`flex h-full flex-col justify-between rounded-[28px] p-7 md:p-10 ${card.tone.box}`}>
              <div>
                <span class="block font-head text-[72px] font-bold leading-[0.6] opacity-40" aria-hidden="true">“</span>
                <blockquote lang="en" class="mt-4 font-head text-[18px] font-medium leading-[1.32] tracking-[-0.01em] md:mt-5 md:text-[27px] md:leading-[1.22]">
                  {card.before}
                  {card.marked && <mark>{card.marked}</mark>}
                  {card.after}
                </blockquote>
              </div>
              <figcaption class={`mt-10 flex items-end justify-between gap-4 text-sm ${card.tone.meta}`}>
                <span class="min-w-0">
                  <b class="block text-[15px] tracking-[0.12em]" aria-label={`${card.rating} / 5`}>{'★'.repeat(card.rating)}<span class="opacity-35">{'★'.repeat(5 - card.rating)}</span></b>
                  <span class="mt-2 block text-[15px] font-semibold text-inherit [color:inherit]">{card.context}</span>
                </span>
                {
                  card.link && (
                    <a
                      href={card.link.href}
                      {...(card.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      class={`shrink-0 whitespace-nowrap rounded-full px-4 py-2.5 text-[14px] font-semibold transition-colors duration-300 ${card.tone.link}`}
                    >
                      {card.link.label}
                    </a>
                  )
                }
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="mx-auto mt-2 flex max-w-[1440px] items-center gap-6 px-5 md:px-10">
      <span class="relative h-[3px] flex-1 overflow-hidden rounded-full bg-line" aria-hidden="true">
        <i data-rail-progress class="absolute inset-y-0 left-0 block w-full origin-left scale-x-[0.2] rounded-full bg-blue"></i>
      </span>
      <span class="hidden gap-3 md:flex">
        <button type="button" data-rail-prev aria-label={t.previous} class="flex size-12 items-center justify-center rounded-full bg-white text-xl transition-colors hover:bg-blue hover:text-white disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-ink">←</button>
        <button type="button" data-rail-next aria-label={t.next} class="flex size-12 items-center justify-center rounded-full bg-white text-xl transition-colors hover:bg-blue hover:text-white disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-ink">→</button>
      </span>
    </div>
    {t.originalNote && <p class="mx-auto mt-4 max-w-[1440px] px-5 text-sm text-mute md:px-10">{t.originalNote}</p>}
  </div>
</section>
