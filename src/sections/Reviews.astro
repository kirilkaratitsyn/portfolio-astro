---
import TopRated from '../components/TopRated.astro';
import { getCollection } from 'astro:content';
import { localizePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const all = useTranslations(locale);
const t = all.reviews;
const PROFILE = 'https://www.upwork.com/freelancers/~0165dda3529105e6f3';

// The quotes are the clients' own words from Upwork, in English. On the German and Ukrainian pages each card shows a
// translation (i18n reviews.cards) and a button swaps it for the English original (the same card of the English file).
// Cards alternate cobalt, paper, ink and mist like the project cards; the key phrase of each is marked.
const tones = [
  { box: 'bg-blue text-white', mark: 'rgba(255,255,255,0.3)', meta: 'text-white/75', link: 'bg-white text-blue-deep hover:bg-ink hover:text-white' },
  { box: 'bg-white text-ink', mark: 'rgba(91,143,224,0.16)', meta: 'text-mute', link: 'bg-ink text-white hover:bg-blue-deep' },
  { box: 'bg-ink text-white', mark: 'rgba(91,143,224,0.75)', meta: 'text-white/70', link: 'bg-white text-ink hover:bg-blue-deep hover:text-white' },
  { box: 'bg-[#dfe2f0] text-ink', mark: 'rgba(91,143,224,0.18)', meta: 'text-[#474c60]', link: 'bg-ink text-white hover:bg-blue-deep' },
] as const;
// Each card can link to the store the review is about (the client's live site), or to the case study when the
// store has closed (a url starting with /).
const linkOf = (url?: string) =>
  !url
    ? null
    : url.startsWith('/')
      ? { href: localizePath(locale, url), label: `${all.caseStudies.viewCase} →`, external: false }
      : { href: url, label: `${new URL(url).hostname.replace(/^www\./, '')} ↗`, external: true };
// Named clients on top (photo, name, project: src/content/testimonials.yaml); their review is dropped from the rail
// below, matched by the card's id and the entry's caseSlug, so one quote stands in one place.
const withPeople = true;
const people = (await getCollection('testimonials')).map((entry) => entry.data).sort((a, b) => a.order - b.order);
const shown = new Set(people.map((person) => person.caseSlug).filter(Boolean));
const originals = useTranslations('en').reviews.cards;
const translated = locale !== 'en';
// A quote cut around its marked phrase.
const split = ({ quote, highlight }: { quote: string; highlight: string }) => {
  const at = quote.indexOf(highlight);
  return {
    before: at < 0 ? quote : quote.slice(0, at),
    marked: at < 0 ? '' : highlight,
    after: at < 0 ? '' : quote.slice(at + highlight.length),
  };
};
const cards = t.cards
  .map((card, i) => {
  const original = originals[i] ?? card;
  return {
    ...card,
    link: linkOf((card as { url?: string }).url),
    // A long quote gets a wider card and smaller type so it fits the card's height (global.css .review-card--long);
    // the longer of the translation and the original decides, so both fit.
    long: Math.max(card.quote.length, original.quote.length) > 240,
    text: split(card),
    original: translated ? split(original) : null,
  };
  })
  .filter((card) => !shown.has((card as { id?: string }).id))
  .map((card, i) => ({ ...card, tone: tones[i % tones.length]! }));
---

<section id="reviews" class="mt-24 scroll-mt-24 md:mt-32" aria-labelledby="reviews-title">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-8 px-5 md:flex-row md:items-end md:justify-between md:px-10">
    <div>
      <h2 id="reviews-title" data-split class="font-head text-[40px] font-bold tracking-[-0.02em] md:text-[56px]">{t.title}</h2>
      <p data-reveal class="mt-3 max-w-[640px] text-base leading-snug text-mute">{people.length > 0 ? t.leadPeople : t.lead}</p>
    </div>
    <TopRated locale={locale} size="lg" class="shrink-0" />
  </div>

  {
    people.length > 0 && (
      <ul class={`mx-auto mt-10 grid max-w-[1440px] gap-5 px-5 md:px-10 ${people.length === 1 ? '' : people.length === 2 || people.length === 4 ? 'md:grid-cols-2' : 'md:grid-cols-2 xl:grid-cols-3'}`}>
        {people.map((person) => (
          <li data-reveal class={`flex flex-col gap-8 rounded-[32px] bg-white p-7 md:p-10 ${people.length === 1 ? 'md:flex-row md:items-center md:gap-12' : ''}`}>
            <div class={`flex shrink-0 items-center gap-4 md:gap-5 ${people.length === 1 ? 'md:w-[300px] md:flex-col md:items-start' : ''}`}>
              <img src={person.photo} alt={person.name} width="160" height="160" loading="lazy" decoding="async" class={`shrink-0 rounded-full object-cover ${people.length === 1 ? 'size-16 md:size-36' : 'size-16 md:size-20'}`} />
              <div class="leading-snug">
                <p class="font-head text-xl font-bold tracking-[-0.01em] md:text-2xl">{person.name}</p>
                <p class="mt-1 text-mute">{person.role ? `${person.role}, ${person.project}` : person.project}</p>
                {person.caseSlug && (
                  <a href={localizePath(locale, `/projects/${person.caseSlug}`)} class="mt-3 inline-block whitespace-nowrap rounded-full bg-ink px-4 py-2.5 text-[14px] font-semibold text-white transition-colors duration-300 hover:bg-blue-deep">
                    {all.caseStudies.viewCase} →
                  </a>
                )}
              </div>
            </div>
            <div class="min-w-0">
              {person.rating && (
                <b class="block text-[15px] tracking-[0.12em] text-blue-deep" aria-label={`${person.rating} / 5`}>{'★'.repeat(Math.round(person.rating))}</b>
              )}
              <blockquote lang="en" class={`mt-4 font-head font-medium leading-[1.3] tracking-[-0.01em] ${people.length === 1 ? 'text-[19px] md:text-[26px]' : 'text-[18px] md:text-[21px]'}`}>
                “{person.quote}”
              </blockquote>
              {person.source && <p class="mt-5 text-sm text-mute">{all.testimonials.source.replace('{source}', person.source)}</p>}
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <div class={`relative ${people.length > 0 ? 'mt-6' : 'mt-10 md:mt-8'}`}>
    <ul
      data-rail
      tabindex="0"
      aria-label={t.title}
      class="reviews-rail flex cursor-grab snap-x snap-mandatory gap-5 md:snap-none scroll-pl-5 overflow-x-auto scroll-smooth pb-8 pl-5 pr-5 md:gap-6 md:scroll-pl-[max(2.5rem,calc((100vw-1440px)/2+2.5rem))] md:pb-3 md:pl-[max(2.5rem,calc((100vw-1440px)/2+2.5rem))] md:pr-10"
    >
      {
        cards.map((card) => (
          <li class:list={['review-card w-[84vw] shrink-0 snap-start sm:w-[440px]', people.length > 0 ? 'md:min-h-[340px]' : 'md:min-h-[clamp(400px,calc(100vh_-_400px),540px)]', card.long ? 'review-card--long lg:w-[720px]' : 'lg:w-[500px]']} style={`--hl:${card.tone.mark}`}>
            <figure class={`flex h-full flex-col justify-between rounded-[28px] p-7 md:p-10 ${card.tone.box}`}>
              <div>
                <span class="block font-head text-[72px] font-bold leading-[0.6] opacity-40" aria-hidden="true">“</span>
                <blockquote lang={locale} data-quote="text" class="mt-4 font-head text-[18px] font-medium leading-[1.32] tracking-[-0.01em] md:mt-5 md:text-[27px] md:leading-[1.22]">
                  {card.text.before}
                  {card.text.marked && <mark>{card.text.marked}</mark>}
                  {card.text.after}
                </blockquote>
                {card.original && (
                  <blockquote lang="en" hidden data-quote="original" class="mt-4 font-head text-[18px] font-medium leading-[1.32] tracking-[-0.01em] md:mt-5 md:text-[27px] md:leading-[1.22]">
                    {card.original.before}
                    {card.original.marked && <mark>{card.original.marked}</mark>}
                    {card.original.after}
                  </blockquote>
                )}
              </div>
              <figcaption class={`mt-10 flex flex-col items-start gap-4 text-sm sm:flex-row sm:items-end sm:justify-between ${card.tone.meta}`}>
                <span class="min-w-0">
                  <b class="block text-[15px] tracking-[0.12em]" aria-label={`${card.rating} / 5`}>{'★'.repeat(card.rating)}<span class="opacity-35">{'★'.repeat(5 - card.rating)}</span></b>
                  <span class="mt-2 block text-[15px] font-semibold text-inherit [color:inherit]">{card.context}</span>
                  {withPeople && (
                    <a href={PROFILE} target="_blank" rel="noopener noreferrer" class="mt-1 block text-[14px] underline decoration-1 underline-offset-4 hover:no-underline">
                      ✓ {t.verified}
                    </a>
                  )}
                  {
                    card.original && (
                      <button type="button" data-quote-toggle aria-pressed="false" data-label-original={t.showOriginal} data-label-text={t.showTranslation} class="mt-2 text-[14px] font-semibold underline decoration-1 underline-offset-4 hover:no-underline">
                        {t.showOriginal}
                      </button>
                    )
                  }
                </span>
                {
                  card.link && (
                    <a
                      href={card.link.href}
                      {...(card.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      class={`shrink-0 whitespace-nowrap rounded-full px-4 py-2.5 text-[14px] font-semibold transition-colors duration-300 ${card.tone.link}`}
                    >
                      {card.link.label}
                    </a>
                  )
                }
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="mx-auto mt-2 flex max-w-[1440px] items-center gap-6 px-5 md:px-10">
      <span class="relative h-[3px] flex-1 overflow-hidden rounded-full bg-line" aria-hidden="true">
        <i data-rail-progress class="absolute inset-y-0 left-0 block w-full origin-left scale-x-[0.2] rounded-full bg-blue"></i>
      </span>
      <span class="hidden gap-3 md:flex">
        <button type="button" data-rail-prev aria-label={t.previous} class="flex size-12 items-center justify-center rounded-full bg-white text-xl transition-colors hover:bg-blue-deep hover:text-white disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-ink">←</button>
        <button type="button" data-rail-next aria-label={t.next} class="flex size-12 items-center justify-center rounded-full bg-white text-xl transition-colors hover:bg-blue-deep hover:text-white disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-ink">→</button>
      </span>
    </div>
    {t.originalNote && <p class="mx-auto mt-4 max-w-[1440px] px-5 text-sm text-mute md:px-10">{t.originalNote}</p>}
  </div>
</section>

<script>
  // German and Ukrainian cards: the button swaps the translation for the English original and back.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-quote-toggle]')) {
    const card = button.closest('.review-card');
    const text = card?.querySelector<HTMLElement>('[data-quote="text"]');
    const original = card?.querySelector<HTMLElement>('[data-quote="original"]');
    if (!text || !original) continue;
    button.addEventListener('click', () => {
      const showOriginal = original.hidden;
      original.hidden = !showOriginal;
      text.hidden = showOriginal;
      button.setAttribute('aria-pressed', String(showOriginal));
      button.textContent = showOriginal ? button.dataset.labelText ?? '' : button.dataset.labelOriginal ?? '';
    });
  }
</script>
