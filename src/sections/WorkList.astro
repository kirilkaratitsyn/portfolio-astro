---
import ProjectRow from '../components/ProjectRow.astro';
import { localizePath, useTranslations, type Locale } from '../i18n';
import type { CaseStudy } from '../lib/content';

interface Props {
  locale: Locale;
  caseStudies: CaseStudy[];
}

const { locale, caseStudies } = Astro.props;
const t = useTranslations(locale);
---

<section id="work" class="relative z-[5] scroll-mt-24 pt-10 md:pt-20">
  <ul class="border-t border-line">
    {
      caseStudies.slice(0, 5).map((item) => (
        <li class="border-b border-line" data-row>
          <ProjectRow href={localizePath(locale, `/projects/${item.slug}`)} title={item.title} image={item.image} mobileImage={item.mobileImage} />
        </li>
      ))
    }
    <li class="border-b border-line">
      <a href={localizePath(locale, '/projects')} class="group block bg-bg text-blue transition-colors duration-300 hover:bg-blue hover:text-white">
        <span class="mx-auto flex max-w-[1440px] items-center justify-between px-5 py-6 text-lg font-medium md:px-10">
          <span>{t.works.allProjects}</span>
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </li>
  </ul>
</section>
