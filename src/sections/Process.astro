---
import Pebble from '../components/Pebble.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const pebbles = ['cobalt', 'white', 'black', 'cobalt2'] as const;
---

<section id="process" class="mx-auto mt-24 max-w-[1440px] scroll-mt-24 px-5 md:mt-32 md:px-10">
  <h2 class="pb-8 font-head text-[40px] font-bold tracking-[-0.02em] md:pb-10 md:text-[56px]">{t.process.title}</h2>
  <ol class="relative grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4 md:gap-x-0">
    <div class="pointer-events-none absolute left-[100px] right-[200px] top-[60px] hidden border-t-2 border-dashed border-[#9aa3d9] md:block" aria-hidden="true"></div>
    {
      t.process.steps.map((step, index) => (
        <li class="relative md:pr-8">
          <Pebble name={pebbles[index]} class="relative w-[84px] md:w-[120px]" />
          <h3 class="mt-5 font-head text-[22px] font-bold leading-[1.1] tracking-[-0.01em] md:mt-[26px] md:text-[28px]">{step.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-mute md:text-[17px]">{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>
