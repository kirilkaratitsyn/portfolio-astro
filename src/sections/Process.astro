---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<section id="process" class="bg-[#0E0E0E]">
  <div class="process__container pt-10 md:pt-20" data-aos="fade-up">
    <div class="mb-12 max-w-3xl space-y-4">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-white/80">{t.process.eyebrow}</p>
      <h2 class="text-3xl font-bold uppercase primary-gradient primary-shadow md:text-[37px]">{t.process.title}</h2>
      <p class="text-lg leading-relaxed text-white/75 md:text-xl">{t.process.subtitle}</p>
    </div>

    <ol class="grid gap-2 md:grid-cols-2 md:gap-3 xl:grid-cols-4">
      {
        t.process.steps.map((step, index) => (
          <li class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-md">
            <span class="mb-6 block text-3xl font-bold primary-gradient" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mb-3 text-xl font-semibold text-white">{step.title}</h3>
            <p class="text-base leading-relaxed text-white/70">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
