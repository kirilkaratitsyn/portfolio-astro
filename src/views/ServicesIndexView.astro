---
// /services: every service as a card (what it is, what it covers, real projects of that kind), then how the work
// starts and the free store check. The home page keeps the compact accordion; this page is where the links point.
import BaseLayout from '../layouts/BaseLayout.astro';
import CalButton from '../components/CalButton.astro';
import Icon from '../components/Icon.astro';
import Contact from '../sections/Contact.astro';
import { localizePath, useTranslations, type Locale } from '../i18n';
import { getLocalPages, getWorks } from '../lib/content';
import { getServiceRows } from '../lib/services';
import { thumb } from '../lib/thumbs';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = t.servicesIndex;
const rows = await getServiceRows(locale, t, await getWorks(locale));
const localPage = (await getLocalPages(locale))[0];

const site = Astro.site!;
const pageUrl = new URL(localizePath(locale, '/services'), site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name: t.services.title,
      description: copy.seoDescription,
      isPartOf: { '@id': new URL('/#website', site).toString() },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: rows.map((row, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: row.title,
          ...(row.page ? { url: new URL(localizePath(locale, `/services/${row.page.slug}`), site).toString() } : {}),
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kiril Karatitsyn', item: new URL(localizePath(locale, '/'), site).toString() },
        { '@type': 'ListItem', position: 2, name: t.header.services, item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout title={copy.seoTitle} description={copy.seoDescription} path="/services" locale={locale} structuredData={structuredData}>
  <section class="mx-auto max-w-[1440px] px-5 pt-32 md:px-10 md:pt-44">
    <h1 class="intro-lift font-head text-[clamp(38px,10vw,52px)] font-bold leading-[0.98] tracking-[-0.03em] md:text-[96px]">{t.services.title}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mute md:mt-8 md:text-xl">{t.services.subtitle}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <CalButton class="inline-flex rounded-full bg-blue px-7 py-[15px] text-[16px] font-semibold text-white">{t.header.bookCall}</CalButton>
      <a href="#contact" class="text-[16px] font-semibold text-blue hover:underline">{t.contact.shopCheck.title} →</a>
    </div>

    <ul class="mt-14 grid gap-5 md:mt-20 md:grid-cols-2 md:gap-6">
      {
        rows.map((row, index) => {
          const pageHref = row.page ? localizePath(locale, `/services/${row.page.slug}`) : undefined;
          return (
            <li class="svc-card group flex flex-col rounded-3xl border border-line bg-white p-6 md:p-8">
              <div class="flex items-start justify-between gap-4">
                <img src={`/source/3d/icon-${row.icon}.webp`} alt="" width="360" height="360" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" class="size-[72px] md:size-[88px]" />
                <span class="font-head text-sm font-bold text-mute">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h2 class="mt-5 font-head text-[26px] font-bold leading-tight tracking-[-0.02em] md:text-[30px]">
                {pageHref ? <a href={pageHref} class="hover:text-blue">{row.title}</a> : row.title}
              </h2>
              <p class="mt-3 text-base leading-relaxed text-mute md:text-[17px]">{row.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {row.tags.map((tag) => <li class="rounded-full border border-line px-3 py-1.5 text-sm font-medium leading-tight">{tag}</li>)}
              </ul>
              {
                row.shots.length > 0 && (
                  <a href={row.href} tabindex="-1" aria-hidden="true" class="svc-card-shots mt-6 grid grid-cols-3 gap-2">
                    {row.shots.map((w) => (
                      <span class="card-shot">
                        <span class="svc-bar">
                          <i />
                          <i />
                          <i />
                        </span>
                        <img src={thumb(w.image, '480')} alt="" width="480" height="333" loading="lazy" decoding="async" />
                      </span>
                    ))}
                  </a>
                )
              }
              <div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-3 pt-6">
                {
                  pageHref && (
                    <a href={pageHref} class="svc-link">
                      {copy.details}
                      <Icon name="arrow" size={18} />
                    </a>
                  )
                }
                {
                  row.count > 0 && (
                    <a href={row.href} class="svc-link text-ink">
                      {t.services.related}
                      <span class="svc-count">{row.count}</span>
                    </a>
                  )
                }
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="mx-auto mt-20 max-w-[1440px] px-5 md:mt-32 md:px-10" aria-labelledby="start-title">
    <h2 id="start-title" class="font-head text-[34px] font-bold tracking-[-0.02em] md:text-[56px]">{copy.start.title}</h2>
    <ol class="mt-8 grid border-t border-line md:mt-10 md:grid-cols-3">
      {
        copy.start.steps.map((step, index) => (
          <li class="border-b border-line py-7 md:border-b-0 md:py-8 md:pr-8 [&:not(:first-child)]:md:border-l [&:not(:first-child)]:md:pl-8">
            <span class="font-head text-xl font-bold text-blue">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-head text-2xl font-bold leading-tight">{step.title}</h3>
            <p class="mt-2 text-lg leading-relaxed text-mute">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    localPage && (
      <section class="mx-auto mt-16 max-w-[1440px] px-5 md:mt-24 md:px-10">
        <a href={localizePath(locale, `/services/${localPage.slug}`)} class="group flex items-start gap-5 rounded-3xl border border-line bg-white p-6 transition-colors hover:border-ink md:items-center md:p-8">
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-bg text-blue">
            <Icon name="pin" size={24} />
          </span>
          <span class="block">
            <span class="block font-head text-2xl font-bold leading-tight md:text-[28px]">{copy.local.title}</span>
            <span class="mt-2 block max-w-3xl text-base leading-relaxed text-mute md:text-lg">{copy.local.text}</span>
            <span class="mt-3 inline-flex items-center gap-2 font-semibold text-blue group-hover:underline">
              {localPage.title}
              <Icon name="arrow" size={18} />
            </span>
          </span>
        </a>
      </section>
    )
  }

  <section class="mx-auto mt-16 max-w-[1440px] px-5 md:mt-24 md:px-10">
    <div class="rounded-3xl bg-ink px-6 py-10 text-white md:flex md:items-center md:justify-between md:gap-10 md:px-12 md:py-14">
      <div class="max-w-2xl">
        <h2 class="font-head text-[30px] font-bold leading-tight tracking-[-0.02em] md:text-[44px]">{copy.cta.title}</h2>
        <p class="mt-3 text-lg leading-relaxed text-white/75">{copy.cta.text}</p>
      </div>
      <a href="#contact" class="mt-7 inline-flex items-center gap-2 rounded-full bg-white px-7 py-[15px] text-[16px] font-semibold text-ink md:mt-0 md:shrink-0">
        {t.contact.shopCheck.title}
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </section>

  <Contact locale={locale} />
</BaseLayout>
