---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import WorkList from '../sections/WorkList.astro';
import Numbers from '../sections/Numbers.astro';
import ClientStrip from '../sections/ClientStrip.astro';
import Marquee from '../sections/Marquee.astro';
import Feature from '../sections/Feature.astro';
import Services from '../sections/Services.astro';
import Process from '../sections/Process.astro';
import Reviews from '../sections/Reviews.astro';
import FAQ from '../sections/FAQ.astro';
import Contact from '../sections/Contact.astro';
import { DEFAULT_LOCALE, useTranslations, type Locale } from '../i18n';
import { getCaseStudies, getWorks } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const caseStudies = await getCaseStudies(locale);
const works = await getWorks(locale);

const seo = {
  title: locale === DEFAULT_LOCALE ? 'Kiril Karatitsyn | Shopify Developer' : `Kiril Karatitsyn | ${t.hero.eyebrow}`,
  description:
    locale === DEFAULT_LOCALE
      ? 'Shopify developer focused on custom themes, Online Store 2.0 migrations, storefront UX, performance optimization, and long-term support for growing brands.'
      : t.hero.subtitle,
};

const SITE_URL = 'https://www.karatitsyn.com/';
const PERSON_ID = `${SITE_URL}#person`;

// Person + website + the services from the Services section. No rating or review data
// until there are real published client reviews.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Kiril Karatitsyn',
      url: SITE_URL,
      image: `${SITE_URL}og-image.jpg`,
      jobTitle: 'Shopify Developer',
      worksFor: { '@type': 'Organization', name: 'Independent' },
      sameAs: [
        'https://www.upwork.com/freelancers/~0165dda3529105e6f3',
        'https://www.linkedin.com/in/kiril-karatitsyn-bb278b332/',
        'https://github.com/kirilkaratitsyn',
      ],
      knowsAbout: ['Shopify', 'Shopify theme development', 'Online Store 2.0', 'Liquid', 'Storefront UX', 'Performance optimization'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}#website`,
      name: 'Kiril Karatitsyn',
      url: SITE_URL,
      inLanguage: ['en', 'de', 'uk'],
      publisher: { '@id': PERSON_ID },
    },
    ...t.services.items.map((service) => ({
      '@type': 'Service',
      name: service.title,
      description: service.description,
      serviceType: 'Shopify development',
      provider: { '@id': PERSON_ID },
    })),
  ],
};
---

<BaseLayout {...seo} path="/" locale={locale} structuredData={structuredData}>
  <Hero locale={locale} />
  <WorkList locale={locale} caseStudies={caseStudies} />
  <Numbers locale={locale} />
  <ClientStrip locale={locale} works={works} />
  <Marquee />
  <Feature locale={locale} caseStudy={caseStudies[0]} />
  <Services locale={locale} />
  <Process locale={locale} />
  <Reviews locale={locale} />
  <FAQ locale={locale} />
  <Contact locale={locale} />
</BaseLayout>
