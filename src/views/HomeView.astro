---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import WorkList from '../sections/WorkList.astro';
import Numbers from '../sections/Numbers.astro';
import CaseLines from '../sections/CaseLines.astro';
import ShopCheckWhat from '../sections/ShopCheckWhat.astro';
import Feature from '../sections/Feature.astro';
import Services from '../sections/Services.astro';
import About from '../sections/About.astro';
import Anatomy from '../sections/Anatomy.astro';
import Editor from '../sections/Editor.astro';
import Reviews from '../sections/Reviews.astro';
import FAQ from '../sections/FAQ.astro';
import Contact from '../sections/Contact.astro';
import { DEFAULT_LOCALE, useTranslations, type Locale } from '../i18n';
import { getCaseStudies, getWorks } from '../lib/content';
import { PERSON, PERSON_ID, BUSINESS, BUSINESS_ID, SITE_URL } from '../lib/person';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const caseStudies = await getCaseStudies(locale);
const works = await getWorks(locale);

const seo = {
  title: t.hero.seoTitle,
  description: t.hero.seoDescription,
  ogTitle: t.hero.ogTitle,
  ogDescription: t.hero.ogDescription,
};

// Person + website + the services from the Services section. No rating or review data
// until there are real published client reviews.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    PERSON,
    BUSINESS,
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}#website`,
      name: 'Kiril Karatitsyn',
      url: SITE_URL,
      inLanguage: ['en', 'de', 'uk'],
      publisher: { '@id': PERSON_ID },
    },
    ...t.services.items.map((service) => ({
      '@type': 'Service',
      name: service.title,
      description: service.description,
      serviceType: 'Shopify development',
      provider: { '@id': BUSINESS_ID },
    })),
  ],
};
---

<BaseLayout {...seo} path="/" locale={locale} structuredData={structuredData}>
  {/* Order for a client who lands here cold: the offer, who I am, the free check, proof in numbers and cases, the case slider, clients' words, what I do, how it goes, more work. The logo strip (sections/ClientStrip.astro) is off for now. */}
  <Hero locale={locale} />
  <About locale={locale} />
  <ShopCheckWhat locale={locale} />
  <Numbers locale={locale} />
  <CaseLines locale={locale} />
  <Feature locale={locale} caseStudies={caseStudies} works={works} />
  <Reviews locale={locale} />
  <Services locale={locale} works={works} />
  <Anatomy locale={locale} />
  <WorkList locale={locale} caseStudies={caseStudies} />
  <Editor locale={locale} />
  <FAQ locale={locale} />
  <Contact locale={locale} />
</BaseLayout>
