---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../sections/Contact.astro';
import { interpolate, localizePath, useTranslations, type Locale } from '../i18n';
import type { BlogPost } from '../lib/content';

interface Props {
  locale: Locale;
  post: BlogPost;
}

const { locale, post } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(post.entry);
---

<BaseLayout title={post.title} description={post.excerpt} type="article" image={post.image} path={`/blog/${post.slug}`} locale={locale}>
  <article class="mx-auto max-w-[1440px] px-5 pt-32 md:px-10 md:pt-44">
    <a href={localizePath(locale, '/blog')} class="text-sm font-medium text-mute hover:text-ink">← {t.blog.backToList}</a>
    <p class="mt-8 text-sm text-mute">{post.date} · {interpolate(t.blog.estimatedRead, { time: post.readingTime })}</p>
    <h1 class="mt-3 max-w-4xl font-head text-[38px] font-bold leading-[1] tracking-[-0.03em] md:text-[72px]">{post.title}</h1>
    <div class="mt-10 max-w-2xl space-y-6 text-lg leading-relaxed md:mt-14 md:text-xl md:leading-relaxed">
      <Content />
    </div>
  </article>
  <Contact locale={locale} />
</BaseLayout>
