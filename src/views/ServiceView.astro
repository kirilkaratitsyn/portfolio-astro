---
// A service page (src/content/services): who it is for, what is included, how the work goes, a case study that
// proves it, FAQ and the two doors (a call, or the free store check by email in the Contact block). Laid out like a
// case study, so the two kinds of page read as one site.
import BaseLayout from '../layouts/BaseLayout.astro';
import CalButton from '../components/CalButton.astro';
import Contact from '../sections/Contact.astro';
import Feature from '../sections/Feature.astro';
import Numbers from '../sections/Numbers.astro';
import ClientStrip from '../sections/ClientStrip.astro';
import Globe from '../sections/Globe.astro';
import About from '../sections/About.astro';
import Services from '../sections/Services.astro';
import Stack from '../sections/Stack.astro';
import Reviews from '../sections/Reviews.astro';
import { LOCALES, localizePath, useTranslations, type Locale } from '../i18n';
import { getCaseStudies, getLocalPages, getPosts, getServiceLocales, getWorks, type ServicePage } from '../lib/content';
import { thumb } from '../lib/thumbs';

interface Props {
  locale: Locale;
  service: ServicePage;
}

const { locale, service } = Astro.props;
const t = useTranslations(locale);
const copy = t.servicePage;
const caseStudies = await getCaseStudies(locale);
// A local page is a full landing page: after its own text it shows the same sections as the home page.
// Service pages are read by local businesses: the intimate wellness store stays in the portfolio only.
const works = (await getWorks(locale)).filter((work) => work.id !== 'nimfa' && work.title !== 'Nimfa');
const proof = caseStudies.find((item) => item.slug === service.caseSlug);
if (!proof) throw new Error(`ServiceView: case study "${service.caseSlug}" not found for ${locale}`);
const article = service.articleSlug ? (await getPosts(locale)).find((post) => post.slug === service.articleSlug) : undefined;
const alsoArticles = (await getPosts(locale)).filter((post) => service.alsoArticles?.includes(post.slug));
// A local page shows the Services section below, so it needs no list of the other services.
// A local page links to the other places, so the local pages form one group.
const group = (slug: string) => slug.split('-')[0];
const place = (slug: string) => slug.slice(group(slug).length + 1);
// The same place in the other group first, then the other places of this group.
const places = service.area
  ? (await getLocalPages(locale))
      .filter((item) => item.slug !== service.slug && (group(item.slug) === group(service.slug) || place(item.slug) === place(service.slug)))
      .sort((x, y) => Number(group(x.slug) === group(service.slug)) - Number(group(y.slug) === group(service.slug)))
  : [];
// A page written in some languages only: hreflang lists those, the language switcher leads to the services overview elsewhere.
const pageLocales = await getServiceLocales(service.slug);
const alternates = LOCALES.filter((item) => pageLocales.includes(item));
const switchLinks = Object.fromEntries(LOCALES.filter((item) => !pageLocales.includes(item)).map((item) => [item, localizePath(item, '/services')]));

const site = Astro.site!;
const pageUrl = new URL(localizePath(locale, `/services/${service.slug}`), site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: service.title,
      description: service.description,
      url: pageUrl,
      serviceType: 'Shopify development',
      areaServed: service.area
        ? [service.area.place, ...service.area.nearby].map((name) => ({ '@type': 'AdministrativeArea', name }))
        : ['DE', 'AT', 'CH', 'US', 'GB', 'AU'],
      provider: { '@id': new URL('/#person', site).toString() },
    },
    ...(service.faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${pageUrl}#faq`,
            mainEntity: service.faq.map((item) => ({
              '@type': 'Question',
              name: item.q,
              acceptedAnswer: { '@type': 'Answer', text: item.a },
            })),
          },
        ]
      : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kiril Karatitsyn', item: new URL(localizePath(locale, '/'), site).toString() },
        { '@type': 'ListItem', position: 2, name: t.header.services, item: new URL(localizePath(locale, '/services'), site).toString() },
        { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl },
      ],
    },
  ],
};
// The scope cards alternate cobalt, paper, ink and mist like the review cards, each with a 3D icon.
const scopeTones = [
  { box: 'bg-blue text-white', text: 'text-white/85' },
  { box: 'bg-white text-ink', text: 'text-mute' },
  { box: 'bg-ink text-white', text: 'text-white/75' },
  { box: 'bg-[#dfe2f0] text-ink', text: 'text-[#474c60]' },
  { box: 'bg-white text-ink', text: 'text-mute' },
] as const;
// Rows of three; a remainder goes to wider cards in the first row (5 cards: 2 wide + 3, 4 cards: 2 + 2).
const wideCards = service.scope.length % 3 === 0 ? 0 : service.scope.length % 3 === 2 ? 2 : 4;
const scopeIcons = ['rocket', 'migrate', 'puzzle', 'chart', 'layers', 'lifebuoy'] as const;
---

<BaseLayout title={service.seoTitle} description={service.description} path={`/services/${service.slug}`} locale={locale} structuredData={structuredData} alternates={alternates} switchLinks={switchLinks}>
  <article>
   <div class="mx-auto max-w-[1440px] px-5 pt-32 md:px-10 md:pt-44">
    <a href={localizePath(locale, '/services')} class="text-sm font-medium text-mute hover:text-ink">← {copy.back}</a>

    <div class="relative">
    <header class="relative z-[2] mt-8 max-w-4xl">
      <h1 class="intro-lift font-head text-[clamp(34px,9vw,48px)] font-bold leading-[0.98] tracking-[-0.03em] md:text-[84px]">{service.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mute md:mt-8 md:text-xl">{service.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <CalButton class="inline-flex rounded-full bg-blue-deep px-7 py-[15px] text-[16px] font-semibold text-white">{t.header.bookCall}</CalButton>
        <a href="#contact" class="text-[16px] font-semibold text-blue-dark hover:underline">{t.contact.shopCheck.title} →</a>
      </div>
    </header>
    {
      /* A local page carries the puzzle cube from the home hero (scripts/stage.ts swaps the poster for the live cube). */
      (
        <span data-pebble="cube" class="pebble relative z-[1] mx-auto mt-10 block w-[min(320px,80vw)] xl:absolute xl:right-0 xl:top-[-40px] xl:m-0 xl:w-[min(400px,28vw)]">
          <img
            src="/source/3d/cube-840.webp"
            srcset="/source/3d/cube-560.webp 560w, /source/3d/cube-640.webp 640w, /source/3d/cube-840.webp 840w"
            sizes="(min-width: 1280px) min(400px, 28vw), min(320px, 80vw)"
            width="1120"
            height="1120"
            alt=""
            decoding="async"
            draggable="false"
            class="block h-auto w-full"
          />
        </span>
      )
    }
    </div>
   </div>

   {/* Order for a visitor from search: the numbers, what the page offers, who does it and the work, reviews, then how it runs. */}
   <Numbers locale={locale} />

   <section class="mx-auto mt-24 max-w-[1440px] px-5 md:mt-32 md:px-10" aria-labelledby="audience-title">
    <div class="grid gap-8 rounded-[32px] bg-white p-6 md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] md:gap-12 md:p-12">
      <h2 id="audience-title" data-split class="font-head text-[40px] font-bold leading-none tracking-[-0.02em] md:text-[56px]">{copy.audience}</h2>
      <ul>
        {
          service.audience.map((item, i) => (
            <li data-reveal class={`grid grid-cols-[48px_1fr] items-baseline gap-3 py-5 md:grid-cols-[72px_1fr] md:py-7 ${i > 0 ? 'border-t border-line' : 'pt-0 md:pt-0'}`}>
              <span class="font-head text-lg font-bold text-blue-deep md:text-xl">{String(i + 1).padStart(2, '0')}</span>
              <p class="font-head text-[22px] font-bold leading-[1.2] tracking-[-0.01em] md:text-[32px]">{item}</p>
            </li>
          ))
        }
      </ul>
    </div>
   </section>

   <section class="mx-auto mt-24 max-w-[1440px] px-5 md:mt-32 md:px-10" aria-labelledby="scope-title">
    <h2 id="scope-title" data-split class="font-head text-[40px] font-bold tracking-[-0.02em] md:text-[56px]">{copy.scope}</h2>
    <ul class="mt-8 grid gap-4 md:mt-10 md:grid-cols-6 md:gap-5">
      {
        service.scope.map((item, i) => {
          const tone = scopeTones[i % scopeTones.length]!;
          const wide = i < wideCards;
          return (
            <li data-reveal class={`relative flex flex-col overflow-hidden rounded-[32px] p-6 md:p-9 ${wide ? 'min-h-[260px] md:col-span-3 md:min-h-[360px]' : 'min-h-[240px] md:col-span-2 md:min-h-[320px]'} ${tone.box}`}>
              <img
                src={`/source/3d/icon-${scopeIcons[i % scopeIcons.length]}.webp`}
                alt=""
                width="360"
                height="360"
                loading="lazy"
                decoding="async"
                class={`pointer-events-none -mr-2 -mt-2 mb-auto h-auto self-end ${wide ? 'w-[110px] md:w-[180px]' : 'w-[96px] md:w-[130px]'}`}
              />
              <span class={`mt-4 font-head text-base font-bold ${tone.text}`}>{String(i + 1).padStart(2, '0')}</span>
              <h3 class={`mt-2 max-w-[18ch] font-head font-bold leading-[1.05] tracking-[-0.02em] ${wide ? 'text-[30px] md:text-[44px]' : 'text-[26px] md:text-[32px]'}`}>{item.title}</h3>
              <p class={`mt-4 max-w-[52ch] text-base leading-relaxed md:text-lg ${tone.text}`}>{item.text}</p>
            </li>
          );
        })
      }
    </ul>
   </section>

   <About locale={locale} />
   <Feature locale={locale} caseStudies={caseStudies.filter((item) => item.slug !== 'nimfa')} works={works} />
   <Reviews locale={locale} />

   <section class="mx-auto mt-24 max-w-[1440px] px-5 md:mt-32 md:px-10" aria-labelledby="steps-title">
    <div class="rounded-[32px] bg-ink p-6 text-white md:p-12">
      <h2 id="steps-title" data-split class="font-head text-[40px] font-bold tracking-[-0.02em] md:text-[56px]">{copy.steps}</h2>
      <ol class="mt-8 grid gap-8 md:mt-12 md:grid-cols-2 md:gap-x-10 md:gap-y-12 xl:grid-cols-4">
        {
          service.steps.map((step, i) => (
            <li data-reveal class="border-t border-white/20 pt-5">
              <span class="font-head text-[40px] font-bold leading-none tracking-[-0.02em] text-blue md:text-[48px]">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-5 font-head text-2xl font-bold leading-tight">{step.title}</h3>
              <p class="mt-3 text-base leading-relaxed text-white/75 md:text-lg">{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-10 flex flex-wrap items-center gap-4 md:mt-12">
        <CalButton class="inline-flex rounded-full bg-white px-7 py-[15px] text-[16px] font-semibold text-ink">{t.header.bookCall}</CalButton>
        <a href="#contact" class="text-[16px] font-semibold text-white hover:underline">{t.contact.shopCheck.title} →</a>
      </div>
    </div>
   </section>

   {
     !service.area && (
       <section class="mx-auto mt-24 max-w-[1440px] px-5 md:mt-32 md:px-10" aria-labelledby="proof-title">
        <h2 id="proof-title" data-split class="font-head text-[40px] font-bold tracking-[-0.02em] md:text-[56px]">{copy.proof}</h2>
        <a data-reveal href={localizePath(locale, `/projects/${proof.slug}`)} class="group mt-8 grid gap-6 rounded-3xl bg-white p-5 md:mt-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-center md:gap-10 md:p-8">
          <img src={thumb(proof.image, '1000')} alt={proof.title} width="1000" height="694" loading="lazy" decoding="async" class="w-full rounded-2xl border border-line object-cover object-top" />
          <span class="block">
            <span class="block font-head text-[32px] font-bold leading-tight tracking-[-0.01em] group-hover:text-blue-deep md:text-[40px]">{proof.title}</span>
            <ul class="mt-4 grid gap-3 text-lg leading-relaxed text-[#3d4152]">{service.caseText.map((item) => <li>{item}</li>)}</ul>
            <span class="mt-6 inline-flex rounded-full bg-ink px-6 py-3 font-semibold text-white transition-colors group-hover:bg-blue-deep">{copy.viewCase} →</span>
          </span>
        </a>
       </section>
     )
   }

   {
     service.faq.length > 0 && (
       <section class="mx-auto mt-24 max-w-[1440px] px-5 md:mt-32 md:px-10" aria-labelledby="faq-title">
        <div class="grid gap-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-12">
          <h2 id="faq-title" data-split class="font-head text-[40px] font-bold tracking-[-0.02em] md:text-[56px]">{copy.faq}</h2>
          <div class="grid gap-3">
            {service.faq.map((item, i) => (
              <details data-reveal class="group rounded-3xl bg-white" open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 font-head text-xl font-bold leading-snug md:p-7 md:text-2xl [&::-webkit-details-marker]:hidden">
                  {item.q}
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-bg text-2xl font-normal text-blue-deep transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="px-6 pb-6 text-lg leading-relaxed text-[#3d4152] md:px-7 md:pb-7">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
       </section>
     )
   }

   {
     article && (
       <section class="mx-auto mt-24 max-w-[1440px] px-5 md:mt-32 md:px-10" aria-labelledby="article-title">
        <h2 id="article-title" data-split class="font-head text-[40px] font-bold tracking-[-0.02em] md:text-[56px]">{copy.article}</h2>
        <ul class="mt-8 grid gap-4 md:mt-10 md:grid-cols-2 md:gap-5 xl:grid-cols-3">
          {[article, ...alsoArticles].map((post) => (
            <li data-reveal>
              <a href={localizePath(locale, `/blog/${post.slug}`)} class="group flex h-full flex-col justify-between gap-8 rounded-3xl bg-white p-6 transition-colors duration-300 hover:bg-ink hover:text-white md:min-h-[220px] md:p-8">
                <span class="font-head text-xl font-bold leading-snug md:text-2xl">{post.title}</span>
                <span class="flex size-12 items-center justify-center rounded-full bg-blue text-xl text-white" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
       </section>
     )
   }

   {
     places.length > 0 && (
       <section class="mx-auto mt-24 max-w-[1440px] px-5 md:mt-32 md:px-10" aria-labelledby="places-title">
        <h2 id="places-title" data-split class="font-head text-[40px] font-bold tracking-[-0.02em] md:text-[56px]">{copy.places}</h2>
        <ul class="mt-8 flex flex-wrap gap-3 md:mt-10">
          {places.map((item) => (
            <li data-reveal>
              <a href={localizePath(locale, `/services/${item.slug}`)} class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-4 text-lg font-semibold transition-colors duration-300 hover:bg-blue-deep hover:text-white">
                {item.title} →
              </a>
            </li>
          ))}
        </ul>
       </section>
     )
   }

   {
     (
       <>
         <ClientStrip locale={locale} works={works} />
         <Services locale={locale} works={works} />
         <Stack locale={locale} />
         <Globe locale={locale} works={works} />
       </>
     )
   }
  </article>

  <Contact locale={locale} />
</BaseLayout>
