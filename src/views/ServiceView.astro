---
// A service page (src/content/services): who it is for, what is included, how the work goes, a case study that
// proves it, FAQ and the two doors (a call, or the free store check by email in the Contact block). Laid out like a
// case study, so the two kinds of page read as one site.
import BaseLayout from '../layouts/BaseLayout.astro';
import CalButton from '../components/CalButton.astro';
import Contact from '../sections/Contact.astro';
import { localizePath, useTranslations, type Locale } from '../i18n';
import { getCaseStudies, getPosts, type ServicePage } from '../lib/content';
import { thumb } from '../lib/thumbs';

interface Props {
  locale: Locale;
  service: ServicePage;
}

const { locale, service } = Astro.props;
const t = useTranslations(locale);
const copy = t.servicePage;
const proof = (await getCaseStudies(locale)).find((item) => item.slug === service.caseSlug);
if (!proof) throw new Error(`ServiceView: case study "${service.caseSlug}" not found for ${locale}`);
const article = service.articleSlug ? (await getPosts(locale)).find((post) => post.slug === service.articleSlug) : undefined;

const site = Astro.site!;
const pageUrl = new URL(localizePath(locale, `/services/${service.slug}`), site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: service.title,
      description: service.description,
      url: pageUrl,
      serviceType: 'Shopify development',
      areaServed: ['DE', 'AT', 'CH', 'US', 'GB', 'AU'],
      provider: { '@id': new URL('/#person', site).toString() },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kiril Karatitsyn', item: new URL(localizePath(locale, '/'), site).toString() },
        { '@type': 'ListItem', position: 2, name: t.header.services, item: new URL(localizePath(locale, '/#services'), site).toString() },
        { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl },
      ],
    },
  ],
};
const row = 'grid gap-3 border-t border-line py-8 md:grid-cols-[260px_1fr] md:gap-10';
---

<BaseLayout title={service.seoTitle} description={service.description} path={`/services/${service.slug}`} locale={locale} structuredData={structuredData}>
  <article class="mx-auto max-w-[1440px] px-5 pt-32 md:px-10 md:pt-44">
    <a href={localizePath(locale, '/#services')} class="text-sm font-medium text-mute hover:text-ink">← {copy.back}</a>

    <header class="mt-8 max-w-4xl">
      <h1 class="intro-lift font-head text-[clamp(34px,9vw,48px)] font-bold leading-[0.98] tracking-[-0.03em] md:text-[84px]">{service.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mute md:mt-8 md:text-xl">{service.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <CalButton class="inline-flex rounded-full bg-blue px-7 py-[15px] text-[16px] font-semibold text-white">{t.header.bookCall}</CalButton>
        <a href="#contact" class="text-[16px] font-semibold text-blue hover:underline">{t.contact.shopCheck.title} →</a>
      </div>
    </header>

    <div class="mt-16 border-b border-line md:mt-24">
      <div class={row}>
        <h2 class="font-head text-2xl font-bold">{copy.audience}</h2>
        <ul class="grid max-w-3xl gap-3 text-lg leading-relaxed">{service.audience.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class={row}>
        <h2 class="font-head text-2xl font-bold">{copy.scope}</h2>
        <ul class="grid max-w-3xl gap-5 text-lg leading-relaxed">
          {
            service.scope.map((item) => (
              <li>
                <b class="font-semibold">{item.title}.</b> {item.text}
              </li>
            ))
          }
        </ul>
      </div>
      <div class={row}>
        <h2 class="font-head text-2xl font-bold">{copy.steps}</h2>
        <ol class="grid max-w-3xl gap-5 text-lg leading-relaxed">
          {
            service.steps.map((step, i) => (
              <li class="grid grid-cols-[36px_1fr] gap-2">
                <span class="font-head text-xl font-bold text-blue">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <b class="font-semibold">{step.title}.</b> {step.text}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class={row}>
        <h2 class="font-head text-2xl font-bold">{copy.proof}</h2>
        <a href={localizePath(locale, `/projects/${proof.slug}`)} class="group grid max-w-3xl gap-5 md:grid-cols-[220px_1fr] md:items-start">
          <img src={thumb(proof.image, '480')} alt={proof.title} width="480" height="333" loading="lazy" decoding="async" class="w-full rounded-xl border border-line object-cover object-top" />
          <span class="block">
            <span class="block font-head text-[26px] font-bold leading-tight group-hover:text-blue">{proof.title}</span>
            <ul class="mt-3 grid gap-2 text-lg leading-relaxed">{service.caseText.map((item) => <li>{item}</li>)}</ul>
            <span class="mt-3 inline-block font-semibold text-blue">{copy.viewCase} →</span>
          </span>
        </a>
      </div>
      {
        service.faq.length > 0 && (
          <div class={row}>
            <h2 class="font-head text-2xl font-bold">{copy.faq}</h2>
            <dl class="grid max-w-3xl gap-6 text-lg leading-relaxed">
              {service.faq.map((item) => (
                <div>
                  <dt class="font-semibold">{item.q}</dt>
                  <dd class="mt-1 text-[#3d4152]">{item.a}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
      {
        article && (
          <div class={row}>
            <h2 class="font-head text-2xl font-bold">{copy.article}</h2>
            <a href={localizePath(locale, `/blog/${article.slug}`)} class="max-w-3xl text-lg font-semibold text-blue hover:underline">
              {article.title} →
            </a>
          </div>
        )
      }
    </div>
  </article>

  <Contact locale={locale} />
</BaseLayout>
