---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../sections/Contact.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { DEFAULT_LOCALE, localizePath, useTranslations, type Locale } from '../i18n';
import { getCaseStudies, getWorks } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const works = await getWorks(locale);
const caseBySlug = new Map((await getCaseStudies(locale)).map((item) => [item.slug, item]));

const seo = {
  title: locale === DEFAULT_LOCALE ? 'Shopify Projects' : t.works.allWorksTitle,
  description:
    locale === DEFAULT_LOCALE
      ? 'Selected Shopify projects across custom themes, migrations, storefront improvements, merchandising logic, and launch support.'
      : t.works.allWorksSubtitle,
};
---

<BaseLayout {...seo} path="/projects" locale={locale}>
  <section id="work" class="pt-32 md:pt-44">
    <h1 class="intro-lift mx-auto max-w-[1440px] px-5 pb-8 font-head text-[44px] font-bold leading-[0.98] tracking-[-0.03em] md:px-10 md:pb-12 md:text-[96px]">{t.works.allWorksTitle}</h1>
    <ul class="border-t border-line">
      {
        works.map((work) => {
          const caseStudy = work.caseStudySlug ? caseBySlug.get(work.caseStudySlug) : undefined;
          const toCase = Boolean(caseStudy);
          return (
            <li class="border-b border-line" data-row>
              <ProjectRow
                href={toCase ? localizePath(locale, `/projects/${work.caseStudySlug}`) : work.url}
                title={work.title}
                image={work.image}
                mobileImage={caseStudy?.mobileImage}
                description={work.tech}
                external={!toCase}
              />
            </li>
          );
        })
      }
    </ul>
  </section>
  <Contact locale={locale} />
</BaseLayout>
