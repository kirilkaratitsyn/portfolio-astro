---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../sections/Contact.astro';
import { DEFAULT_LOCALE, interpolate, localizePath, useTranslations, type Locale } from '../i18n';
import { getPosts } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getPosts(locale);

const seo = {
  title: locale === DEFAULT_LOCALE ? 'Shopify Blog' : `Shopify ${t.blog.title}`,
  description:
    locale === DEFAULT_LOCALE
      ? 'Articles about Shopify development, conversion optimization, launch checklists, and practical storefront improvements.'
      : t.blog.subtitle,
};
---

<BaseLayout {...seo} path="/blog" locale={locale}>
  <section class="pt-32 md:pt-44">
    <h1 class="mx-auto max-w-[1440px] px-5 pb-8 font-head text-[44px] font-bold leading-[0.98] tracking-[-0.03em] md:px-10 md:pb-12 md:text-[96px]">{t.blog.title}</h1>
    <ul class="border-t border-line">
      {
        posts.map((post) => (
          <li class="border-b border-line">
            <a href={localizePath(locale, `/blog/${post.slug}`)} class="group mx-auto grid max-w-[1440px] gap-3 px-5 py-7 transition-colors hover:bg-blue hover:text-white md:grid-cols-[1fr_minmax(0,520px)_120px] md:items-center md:gap-10 md:px-10">
              <h2 class="font-head text-[26px] font-bold leading-tight tracking-[-0.02em] md:text-[34px]">{post.title}</h2>
              <p class="text-base leading-relaxed text-mute group-hover:text-white/90">{post.excerpt}</p>
              <p class="text-sm text-mute group-hover:text-white/90 md:text-right">{post.date} · {interpolate(t.blog.estimatedRead, { time: post.readingTime })}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <Contact locale={locale} />
</BaseLayout>
