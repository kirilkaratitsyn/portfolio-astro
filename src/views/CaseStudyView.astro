---
import Phone from '../components/Phone.astro';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../sections/Contact.astro';
import Pebble from '../components/Pebble.astro';
import CaseStudyMoreProjects from '../components/CaseStudyMoreProjects.astro';
import { DEFAULT_LOCALE, localizePath, useTranslations, type Locale } from '../i18n';
import { shotSrcset, thumb } from '../lib/thumbs';
import { getServices, type CaseStudy } from '../lib/content';

interface Props {
  locale: Locale;
  caseStudy: CaseStudy;
  caseStudies: CaseStudy[];
}

const { locale, caseStudy, caseStudies } = Astro.props;
const copy = useTranslations(locale).caseStudies;
// Optional long-form Markdown below the frontmatter of the case file.
const hasBody = Boolean(caseStudy.entry.body?.trim());
const { Content } = await render(caseStudy.entry);

const t = useTranslations(locale);
// The service pages this case study shows: the one it proves, and any that list it among their other cases.
const services = (await getServices(locale)).filter((item) => item.caseSlug === caseStudy.slug || item.alsoCases?.includes(caseStudy.slug));
const site = Astro.site!;
const pageUrl = new URL(localizePath(locale, `/projects/${caseStudy.slug}`), site).toString();
// The case as a piece of work by Kiril (the same Person as on the home page), and where it sits on the site.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      '@id': `${pageUrl}#work`,
      name: caseStudy.seoTitle ?? caseStudy.title,
      description: caseStudy.summary,
      url: pageUrl,
      image: new URL(`/og/projects/${caseStudy.slug}.jpg`, site).toString(),
      inLanguage: locale,
      keywords: caseStudy.tags.join(', '),
      creator: { '@id': new URL('/#person', site).toString() },
      about: { '@type': 'Organization', name: caseStudy.title, ...(caseStudy.archived ? {} : { url: caseStudy.liveUrl }) },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kiril Karatitsyn', item: new URL(localizePath(locale, '/'), site).toString() },
        { '@type': 'ListItem', position: 2, name: t.header.works, item: new URL(localizePath(locale, '/projects'), site).toString() },
        { '@type': 'ListItem', position: 3, name: caseStudy.title, item: pageUrl },
      ],
    },
  ],
};

const seo = {
  title: caseStudy.seoTitle ?? (locale === DEFAULT_LOCALE ? `${caseStudy.title} Case Study` : `${caseStudy.title} – ${copy.eyebrow}`),
  description: caseStudy.summary,
  type: 'article' as const,
  // JPG crop of the desktop screenshot (public/og/projects), WebP isn't read by every social network.
  image: `/og/projects/${caseStudy.slug}.jpg`,
  imageSize: { width: 1200, height: 630 },
  structuredData,
};

const sections = [
  { title: copy.challengeTitle, text: caseStudy.challenge },
  { title: copy.scopeTitle, list: caseStudy.scope },
  { title: copy.solutionTitle, list: caseStudy.solution },
  { title: copy.stackTitle, chips: caseStudy.stack },
];
---

<BaseLayout {...seo} path={`/projects/${caseStudy.slug}`} locale={locale}>
  <article class="mx-auto max-w-[1440px] px-5 pt-32 md:px-10 md:pt-44">
    <a href={localizePath(locale, '/projects')} class="text-sm font-medium text-mute hover:text-ink">← {copy.backToCases}</a>

    <header class="mt-8 grid grid-cols-1 gap-10 md:grid-cols-[1.15fr_0.85fr] md:gap-16">
      <div class="min-w-0">
        <!-- Scales with the screen on phones, so a one-word name like MarinePatches still fits the line. -->
        <h1 class="intro-lift font-head text-[clamp(32px,11vw,48px)] font-bold leading-[0.95] tracking-[-0.03em] md:text-[104px]">{caseStudy.title}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mute md:mt-8 md:text-xl">{caseStudy.summary}</p>
        <ul class="mt-6 flex flex-wrap gap-2 text-sm">
          {caseStudy.tags.map((tag) => <li class="rounded-full border border-line px-3 py-1 text-mute">{tag}</li>)}
        </ul>
      </div>
      <div class="self-end border-t border-line pt-6">
        <h2 class="font-head text-2xl font-bold">{copy.outcomeTitle}</h2>
        <ul class="mt-4 grid gap-3 text-base leading-relaxed">
          {caseStudy.outcome.map((item) => <li>{item}</li>)}
        </ul>
        {
          caseStudy.archived ? (
            <p class="mt-6 text-sm leading-relaxed text-mute">{copy.archivedNote}</p>
          ) : (
            <a href={caseStudy.liveUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-full bg-ink px-6 py-3.5 font-medium text-white hover:bg-blue">
              {copy.visitStore} ↗
            </a>
          )
        }
      </div>
    </header>

    <div class="relative mt-14 aspect-[760/540] overflow-hidden rounded-[28px] bg-blue md:mt-20 md:aspect-[1360/700]">
      <div class="absolute left-[6%] top-[11%] w-[74%] overflow-hidden rounded-xl bg-white shadow-[0_24px_50px_rgba(33,53,84,0.35)] md:left-[9%] md:w-[58%]">
        <div class="flex h-[22px] items-center gap-1.5 bg-[#f1f2f6] px-3" aria-hidden="true">
          <i class="block size-2 rounded-full bg-[#cfd2de]"></i><i class="block size-2 rounded-full bg-[#cfd2de]"></i><i class="block size-2 rounded-full bg-[#cfd2de]"></i>
        </div>
        <img src={thumb(caseStudy.image, '1000')} srcset={shotSrcset(caseStudy.image)} sizes="(min-width: 768px) 60vw, 80vw" alt={caseStudy.title} width="1000" height="694" decoding="async" class="block aspect-[560/346] w-full object-cover object-top" />
      </div>
      {
        caseStudy.mobileImage && (
          <div class="absolute right-[6%] top-[9%] w-[22%] md:right-[9%] md:top-[11%] md:w-[16%]">
            <Phone image={caseStudy.mobileImage} domain={caseStudy.archived ? undefined : new URL(caseStudy.liveUrl).hostname.replace(/^www\./, '')} sizes="(min-width: 768px) 16vw, 22vw" loading="eager" />
          </div>
        )
      }
      <Pebble name="white" class="absolute -bottom-[6%] -left-[3%] w-[18%] md:w-[11%]" />
      <Pebble name="black" class="absolute -right-[3%] -top-[5%] w-[13%] md:w-[8%]" />
    </div>

    {
      caseStudy.screenshotCaptions?.length ? (
        <ul class="mt-8 grid gap-4 text-[15px] leading-relaxed text-mute md:grid-cols-3 md:gap-10">
          {caseStudy.screenshotCaptions.map((caption) => <li>{caption}</li>)}
        </ul>
      ) : null
    }

    <div class="mt-16 border-b border-line md:mt-24">
      {
        caseStudy.review && (
          <div class="grid gap-3 border-t border-line py-8 md:grid-cols-[260px_1fr] md:gap-10">
            <h2 class="font-head text-2xl font-bold">{copy.reviewTitle}</h2>
            <figure class="max-w-3xl">
              <blockquote lang="en" class="font-head text-[22px] font-medium leading-[1.3] tracking-[-0.01em] md:text-[28px]">“{caseStudy.review.quote}”</blockquote>
              <figcaption class="mt-4 flex items-center gap-2 text-[15px] text-mute">
                <span class="text-blue" aria-hidden="true">{'★'.repeat(Math.round(caseStudy.review.rating))}</span>
                <span>{copy.reviewRating.replace('{n}', caseStudy.review.rating.toFixed(1))} · {copy.reviewSource}</span>
              </figcaption>
            </figure>
          </div>
        )
      }
      {
        services.length > 0 && (
          <div class="grid gap-3 border-t border-line py-8 md:grid-cols-[260px_1fr] md:gap-10">
            <h2 class="font-head text-2xl font-bold">{t.servicePage.more}</h2>
            <ul class="grid max-w-3xl gap-2">
              {services.map((service) => (
                <li>
                  <a href={localizePath(locale, `/services/${service.slug}`)} class="text-lg font-semibold text-blue hover:underline">
                    {service.title} →
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="grid gap-3 border-t border-line py-8 md:grid-cols-[260px_1fr] md:gap-10">
        <h2 class="font-head text-2xl font-bold">{copy.aboutBrandTitle}</h2>
        <p class="max-w-3xl text-lg leading-relaxed">{caseStudy.brandDescription}</p>
      </div>
      {
        sections.map((section) => (
          <div class="grid gap-3 border-t border-line py-8 md:grid-cols-[260px_1fr] md:gap-10">
            <h2 class="font-head text-2xl font-bold">{section.title}</h2>
            {section.text && <p class="max-w-3xl text-lg leading-relaxed">{section.text}</p>}
            {section.list && <ul class="grid max-w-3xl gap-3 text-lg leading-relaxed">{section.list.map((item) => <li>{item}</li>)}</ul>}
            {section.chips && <ul class="flex flex-wrap gap-2">{section.chips.map((item) => <li class="rounded-full border border-line px-4 py-2 text-base">{item}</li>)}</ul>}
          </div>
        ))
      }
    </div>

    {
      hasBody && (
        <div class="mt-12 max-w-3xl space-y-6 text-lg leading-relaxed [&>h2]:font-head [&>h2]:text-2xl [&>h2]:font-bold [&>ul]:list-disc [&>ul]:pl-6">
          <Content />
        </div>
      )
    }
  </article>

  <CaseStudyMoreProjects locale={locale} items={caseStudies} currentSlug={caseStudy.slug} />
  <Contact locale={locale} />
</BaseLayout>
