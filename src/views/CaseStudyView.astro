---
import TopRated from '../components/TopRated.astro';
import CaseFlair from '../components/CaseFlair.astro';
import Phone from '../components/Phone.astro';
import Icon from '../components/Icon.astro';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../sections/Contact.astro';
import Pebble from '../components/Pebble.astro';
import CaseStudyMoreProjects from '../components/CaseStudyMoreProjects.astro';
import { DEFAULT_LOCALE, localizePath, useTranslations, type Locale } from '../i18n';
import { shotSrcset, thumb } from '../lib/thumbs';
import { getServices, type CaseStudy } from '../lib/content';

interface Props {
  locale: Locale;
  caseStudy: CaseStudy;
  caseStudies: CaseStudy[];
}

const { locale, caseStudy, caseStudies } = Astro.props;
const copy = useTranslations(locale).caseStudies;
// Optional long-form Markdown below the frontmatter of the case file.
// Case studies drawn in the style of the client's trade (styles: global.css .case--film / .case--ritual).
const theme = ({ lumppings: 'film', 'orska-rituals': 'ritual' } as Record<string, 'film' | 'ritual'>)[caseStudy.slug];
const hasBody = Boolean(caseStudy.entry.body?.trim());
const { Content } = await render(caseStudy.entry);

const t = useTranslations(locale);
// The service pages this case study shows: the one it proves, and any that list it among their other cases.
const services = (await getServices(locale)).filter((item) => item.caseSlug === caseStudy.slug || item.alsoCases?.includes(caseStudy.slug));
const site = Astro.site!;
const pageUrl = new URL(localizePath(locale, `/projects/${caseStudy.slug}`), site).toString();
// The case as a piece of work by Kiril (the same Person as on the home page), and where it sits on the site.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWork',
      '@id': `${pageUrl}#work`,
      name: caseStudy.seoTitle ?? caseStudy.title,
      description: caseStudy.summary,
      url: pageUrl,
      image: new URL(`/og/projects/${caseStudy.slug}.jpg`, site).toString(),
      inLanguage: locale,
      keywords: caseStudy.tags.join(', '),
      creator: { '@id': new URL('/#person', site).toString() },
      about: { '@type': 'Organization', name: caseStudy.title, ...(caseStudy.archived || caseStudy.noLiveLink ? {} : { url: caseStudy.liveUrl }) },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kiril Karatitsyn', item: new URL(localizePath(locale, '/'), site).toString() },
        { '@type': 'ListItem', position: 2, name: t.header.works, item: new URL(localizePath(locale, '/projects'), site).toString() },
        { '@type': 'ListItem', position: 3, name: caseStudy.title, item: pageUrl },
      ],
    },
  ],
};

const seo = {
  title: caseStudy.seoTitle ?? (locale === DEFAULT_LOCALE ? `${caseStudy.title} Case Study` : `${caseStudy.title} – ${copy.eyebrow}`),
  description: caseStudy.summary,
  type: 'article' as const,
  // JPG crop of the desktop screenshot (public/og/projects), WebP isn't read by every social network.
  image: `/og/projects/${caseStudy.slug}.jpg`,
  imageSize: { width: 1200, height: 630 },
  structuredData,
};

// The hero numbers and the fact bar under it (industry, kind of work, period, platform, rating), only from the case file.
const highlights = caseStudy.highlights ?? [];
const facts = [
  caseStudy.industry && { icon: 'shop' as const, label: copy.factIndustry, value: caseStudy.industry },
  { icon: 'puzzle' as const, label: copy.factService, value: caseStudy.tags[0] },
  caseStudy.period && { icon: 'clock' as const, label: copy.factPeriod, value: caseStudy.period },
  { icon: 'grid' as const, label: copy.factPlatform, value: 'Shopify' },
  caseStudy.review && { icon: 'sparkle' as const, label: copy.factRating, value: `${caseStudy.review.rating.toFixed(1).replace('.', locale === 'en' ? '.' : ',')} / 5 · Upwork` },
].filter(Boolean) as { icon: 'shop' | 'puzzle' | 'clock' | 'grid' | 'sparkle'; label: string; value: string }[];

---

<BaseLayout {...seo} path={`/projects/${caseStudy.slug}`} locale={locale}>
  <div class={theme ? `case case--${theme}` : undefined}>
  <article class="mx-auto max-w-[1440px] px-5 pt-32 md:px-10 md:pt-44">
    <a href={localizePath(locale, '/projects')} class="text-sm font-medium text-mute hover:text-ink">← {copy.backToCases}</a>

    <!-- Hero in the manner of DACH agency case pages: name and result first, big numbers on the stage, facts below. -->
    <header class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-[1.3fr_0.7fr] md:items-end md:gap-16">
      <div class="min-w-0">
        <ul class="flex flex-wrap gap-2 text-[13px] font-semibold uppercase tracking-[0.06em]">
          {caseStudy.tags.map((tag) => <li class="rounded-full bg-white px-3 py-1.5 text-ink">{tag}</li>)}
        </ul>
        <!-- Scales with the screen on phones, so a one-word name like MarinePatches still fits the line. -->
        <h1 class="case-title intro-lift mt-6 font-head text-[clamp(32px,11vw,48px)] font-bold leading-[0.95] tracking-[-0.03em] md:text-[104px]">{caseStudy.title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-mute md:mt-8 md:text-xl">{caseStudy.summary}</p>
      </div>
      <div class="flex flex-wrap items-center gap-4 md:justify-end">
        {
          !caseStudy.archived && !caseStudy.noLiveLink && (
            <a href={caseStudy.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-ink px-6 py-3.5 font-medium text-white hover:bg-blue-deep">
              {copy.visitStore} ↗
            </a>
          )
        }
        <TopRated locale={locale} />
      </div>
    </header>

    <div class="relative mt-10 md:mt-14">
      <div class="case-stage relative aspect-[760/540] overflow-hidden rounded-[28px] bg-blue md:aspect-[1360/700]">
        <div class={`absolute left-[6%] top-[11%] w-[74%] overflow-hidden rounded-xl bg-white shadow-[0_24px_50px_rgba(33,53,84,0.35)] md:left-[5%] ${highlights.length ? 'md:w-[50%]' : 'md:w-[58%]'}`}>
          <div class="flex h-[22px] items-center gap-1.5 bg-[#f1f2f6] px-3" aria-hidden="true">
            <i class="block size-2 rounded-full bg-[#cfd2de]"></i><i class="block size-2 rounded-full bg-[#cfd2de]"></i><i class="block size-2 rounded-full bg-[#cfd2de]"></i>
          </div>
          <img src={thumb(caseStudy.image, '1000')} srcset={shotSrcset(caseStudy.image)} sizes="(min-width: 768px) 55vw, 80vw" alt={caseStudy.title} width="1000" height="694" decoding="async" class="block aspect-[560/346] w-full object-cover object-top" />
        </div>
        {
          caseStudy.mobileImage && (
            <div class={`absolute right-[6%] top-[9%] w-[22%] md:top-[11%] md:w-[14%] ${highlights.length ? 'md:left-[48%] md:right-auto' : 'md:right-[9%]'}`}>
              <Phone image={caseStudy.mobileImage} domain={caseStudy.archived || caseStudy.noLiveLink ? undefined : new URL(caseStudy.liveUrl).hostname.replace(/^www\./, '')} sizes="(min-width: 768px) 14vw, 22vw" loading="eager" />
            </div>
          )
        }
        {theme === 'film' && <div class="stage-hud" aria-hidden="true"><span><i />REC</span><span>00:01:24:12</span></div>}
        <Pebble name="white" class="absolute -bottom-[6%] -left-[3%] w-[18%] md:w-[11%]" />
        <Pebble name="black" class="absolute -right-[3%] -top-[5%] w-[13%] md:w-[8%]" />
      </div>
      {
        highlights.length > 0 && (
          <ul class="case-stats mt-3 grid gap-3 rounded-[28px] bg-white p-6 md:absolute md:bottom-[7%] md:right-[4%] md:top-[7%] md:mt-0 md:w-[31%] md:content-center md:gap-8 md:p-9">
            {highlights.map((item) => (
              <li>
                <b class="case-stat-num block font-head text-[40px] font-bold leading-none tracking-[-0.03em] text-blue-deep md:text-[56px]">{item.value}</b>
                <span class="mt-2 block text-[15px] leading-snug text-mute">{item.label}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-4 rounded-[28px] bg-white px-6 py-5 text-[15px] md:flex md:flex-wrap md:items-center md:justify-between md:px-10 md:py-6">
      {facts.map((fact) => (
        <li class="flex min-w-0 items-center gap-3">
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-[#eef1fa] text-blue-deep"><Icon name={fact.icon} size={18} /></span>
          <span class="min-w-0"><b class="font-semibold">{fact.label}:</b> {fact.value}</span>
        </li>
      ))}
    </ul>

    {
      caseStudy.screenshotCaptions?.length ? (
        <ul class="mt-8 grid gap-4 text-[15px] leading-relaxed text-mute md:grid-cols-3 md:gap-10">
          {caseStudy.screenshotCaptions.map((caption) => <li>{caption}</li>)}
        </ul>
      ) : null
    }

    <!-- At a glance, as two cards: who the brand is, and where the store stood. -->
    <section class="mt-16 md:mt-24">
      <h2 class="font-head text-[34px] font-bold leading-none tracking-[-0.02em] md:text-[56px]">{copy.glanceTitle}</h2>
      <div class="mt-8 grid gap-3 md:mt-10 md:grid-cols-2 md:gap-5">
        <div class="case-card rounded-[28px] bg-white p-7 md:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-blue-deep">{copy.aboutBrandTitle}</p>
          <p class="mt-4 text-lg leading-relaxed">{caseStudy.brandDescription}</p>
        </div>
        <div class="case-card rounded-[28px] bg-white p-7 md:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-blue-deep">{copy.challengeTitle}</p>
          <p class="mt-4 font-head text-[20px] font-medium leading-[1.4] tracking-[-0.01em] md:text-[22px]">{caseStudy.challenge}</p>
        </div>
      </div>
    </section>

    {
      caseStudy.needs?.length ? (
        <section class="mt-16 md:mt-24">
          <div class="grid gap-3 md:grid-cols-2 md:gap-5">
            <p class="case-bar hidden rounded-2xl bg-blue px-6 py-4 font-semibold text-white md:block">{copy.needTitle}</p>
            <p class="case-bar hidden rounded-2xl bg-ink px-6 py-4 font-semibold text-white md:block">{copy.answerTitle}</p>
            {caseStudy.needs.map((row) => (
              <>
                <div class="case-card rounded-2xl bg-white/60 px-6 py-6 text-lg leading-relaxed text-mute md:flex md:items-center">
                  <span><b class="mb-1 block text-sm font-semibold uppercase tracking-[0.1em] text-blue-deep md:hidden">{copy.needTitle}</b>{row.need}</span>
                </div>
                <div class="case-card mb-4 rounded-2xl bg-white px-6 py-6 text-lg leading-relaxed md:mb-0 md:flex md:items-center">
                  <span><b class="mb-1 block text-sm font-semibold uppercase tracking-[0.1em] text-ink md:hidden">{copy.answerTitle}</b>{row.answer}</span>
                </div>
              </>
            ))}
          </div>
        </section>
      ) : null
    }

    {theme && <CaseFlair theme={theme} locale={locale} />}

    <section class="mt-16 md:mt-24">
      <h2 class="font-head text-[34px] font-bold leading-none tracking-[-0.02em] md:text-[56px]">{copy.outcomeTitle}</h2>
      <ul class="mt-8 grid gap-3 md:mt-10 md:grid-cols-2 md:gap-5">
        {caseStudy.outcome.map((item) => (
          <li class="case-card flex gap-4 rounded-[28px] bg-white p-7 text-lg leading-relaxed md:p-9">
            <span class="mt-1 flex size-7 shrink-0 items-center justify-center rounded-full bg-blue text-[14px] font-bold text-white" aria-hidden="true">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      {caseStudy.archived && <p class="mt-6 text-sm leading-relaxed text-mute">{copy.archivedNote}</p>}
    </section>

    {
      caseStudy.review && (
        <figure class="case-quote mx-auto mt-20 max-w-5xl text-center md:mt-32">
          <span class="block tracking-[0.2em] text-blue" aria-hidden="true">{'★'.repeat(Math.round(caseStudy.review.rating))}</span>
          <blockquote lang="en" class="mt-6 font-head text-[26px] font-bold leading-[1.2] tracking-[-0.02em] md:text-[46px]">„{caseStudy.review.quote}“</blockquote>
          <figcaption class="mt-8 text-[15px] text-mute">{copy.reviewRating.replace('{n}', caseStudy.review.rating.toFixed(1))} · {copy.reviewSource}</figcaption>
        </figure>
      )
    }

    <div class="case-rows mt-20 border-b border-line md:mt-32">
      <!-- Store owners read the result first; how it was built stays on the page for those who want it. -->
      <details class="case-tech group border-t border-line">
        <summary class="grid cursor-pointer list-none gap-5 py-10 md:grid-cols-[260px_1fr] md:gap-10 md:py-14 [&::-webkit-details-marker]:hidden">
          <h2 class="font-head text-2xl font-bold">{copy.techTitle}</h2>
          <span class="flex items-center gap-3 text-lg text-mute">
            <span class="flex size-8 items-center justify-center rounded-full border border-line text-xl leading-none transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
            {copy.techHint}
          </span>
        </summary>
        <div class="case-row grid gap-5 border-t border-line py-10 md:grid-cols-[260px_1fr] md:gap-10 md:py-14">
          <h3 class="font-head text-2xl font-bold">{copy.scopeTitle}</h3>
          <ul class="grid max-w-3xl gap-4 text-lg leading-relaxed">
            {caseStudy.scope.map((item) => (
              <li class="flex gap-4">
                <span class="mt-1 flex size-6 shrink-0 items-center justify-center rounded-full bg-blue text-[13px] font-bold text-white" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="case-row grid gap-5 border-t border-line py-10 md:grid-cols-[260px_1fr] md:gap-10 md:py-14">
          <h3 class="font-head text-2xl font-bold">{copy.solutionTitle}</h3>
          <ol class="max-w-3xl">
            {caseStudy.solution.map((item, i) => (
              <li class={`flex flex-col gap-2 py-5 md:grid md:grid-cols-[56px_1fr] md:gap-3 ${i > 0 ? 'border-t border-line' : 'pt-0'}`}>
                <span class="font-head text-base font-bold text-blue-deep md:text-lg">{String(i + 1).padStart(2, '0')}</span>
                <p class="text-lg leading-relaxed">{item}</p>
              </li>
            ))}
          </ol>
        </div>
        <div class="case-row grid gap-5 border-t border-line py-10 md:grid-cols-[260px_1fr] md:gap-10 md:py-14">
          <h3 class="font-head text-2xl font-bold">{copy.stackTitle}</h3>
          <ul class="flex flex-wrap content-start items-start gap-2">
            {caseStudy.stack.map((item) => <li class="rounded-full bg-white px-4 py-2 text-base leading-none">{item}</li>)}
          </ul>
        </div>
      </details>
      {
        services.length > 0 && (
          <div class="case-row grid gap-5 border-t border-line py-10 md:grid-cols-[260px_1fr] md:gap-10 md:py-14">
            <h2 class="font-head text-2xl font-bold">{t.servicePage.more}</h2>
            <ul class="flex flex-wrap content-start items-start gap-3">
              {services.map((service) => (
                <li>
                  <a href={localizePath(locale, `/services/${service.slug}`)} class="inline-flex rounded-full bg-ink px-5 py-3 font-semibold text-white transition-colors duration-300 hover:bg-blue-deep">
                    {service.title} →
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    {
      hasBody && (
        <div class="mt-12 max-w-3xl space-y-6 text-lg leading-relaxed [&>h2]:font-head [&>h2]:text-2xl [&>h2]:font-bold [&>ul]:list-disc [&>ul]:pl-6">
          <Content />
        </div>
      )
    }
  </article>
  </div>

  <CaseStudyMoreProjects locale={locale} items={caseStudies} currentSlug={caseStudy.slug} />
  <Contact locale={locale} />
</BaseLayout>
