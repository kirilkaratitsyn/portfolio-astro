{
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/work",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/work/:slug",
      "destination": "/projects/:slug",
      "permanent": true
    },
    {
      "source": "/projects/indian-affairs",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/de/projects/indian-affairs",
      "destination": "/de/projects",
      "permanent": true
    },
    {
      "source": "/uk/projects/indian-affairs",
      "destination": "/uk/projects",
      "permanent": true
    },
    {
      "source": "/impressum",
      "destination": "/legal-notice",
      "permanent": true
    },
    {
      "source": "/datenschutz",
      "destination": "/de/datenschutz",
      "permanent": true
    },
    {
      "source": "/blog/landing-page-launch-checklist",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/de/blog/landing-page-launch-checklist",
      "destination": "/de/blog",
      "permanent": true
    },
    {
      "source": "/uk/blog/landing-page-launch-checklist",
      "destination": "/uk/blog",
      "permanent": true
    },
    {
      "source": "/blog/shopify-conversion-boost",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/de/blog/shopify-conversion-boost",
      "destination": "/de/blog",
      "permanent": true
    },
    {
      "source": "/uk/blog/shopify-conversion-boost",
      "destination": "/uk/blog",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    }
  ]
}
